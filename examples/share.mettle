// Counts the primes below two million on however many machines run this
// program. Every machine runs the same code: each knows how to count a
// chunk and shares that work. The one started as the boss hands the chunks
// out, and alph sends each to one of its own cores or to another machine,
// wherever it should be done first.
//
// With no arguments two machines run in this one process:
//
//   mettle --build -s --release examples/share.mettle -I ports/host -o share
//   ./share
//
// On two computers, each with the other's address:
//
//   ./share helper 192.168.1.10
//   ./share boss 192.168.1.20

import "std/io";
import "std/thread";
import "alph/actor/actor";
import "alph/machine/machine";
import "alph/batch/batch";

const CHUNK: Word = 10000;
const CHUNKS: Word = 200;
const PRIMES: Word = 0;  // the kind of job: in is a chunk, out the primes in it
const GO: Word = 1;
const BOSS_PORT: int64 = 7451;
const HELPER_PORT: int64 = 7452;

var g_boss: AlphMachine;
var g_helper: AlphMachine;
var g_batch: AlphBatch;
var g_primes: Word = 0;

fn count_primes(job: AlphJob*) -> Word {
  var n: Word = (Word)(job->in * CHUNK);
  var end: Word = n + CHUNK;
  var found: Word = 0;
  while (n < end) {
    var prime: bool = n >= 2;
    var d: Word = 2;
    while (prime && d * d <= n) {
      if (n % d == 0) {
        prime = false;
      }
      d = d + 1;
    }
    if (prime) {
      found = found + 1;
    }
    n = n + 1;
  }
  job->out = found;
  return 0;
}

// What every machine does: three cores, the one kind of work, shared.
fn machine(m: AlphMachine*, first: Word, other: Word, ip: uint32, port: int64) {
  m->init(3, first, false);
  m->peer(other, 3, ip, port);
  m->kind(PRIMES, &count_primes, 0);
  m->share(PRIMES);
}

fn each_chunk(b: AlphBatch*, job: AlphJob*, chunk: Word) {
  job->in = CHUNKS - 1 - chunk;  // the big numbers first: they take longest
}

fn counted(b: AlphBatch*, job: AlphJob*, chunk: Word) {
  g_primes = g_primes + job->out;
}

fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == GO) {
    g_batch.begin(a, PRIMES, CHUNKS, &each_chunk, &counted, 0);
  } else if (g_batch.took(a, m) && g_batch.over()) {
    a->cores()->stop();
  }
  return 0;
}

fn run_boss(helper_ip: uint32) -> int32 {
  machine(&g_boss, 0, 3, helper_ip, HELPER_PORT);
  g_boss.batch(&g_batch);
  var pid: Word = g_boss.cores.spawn_on(0, &boss, 0);
  if (g_boss.start(BOSS_PORT) != ALPH_OK) {
    println("port {BOSS_PORT} is taken");
    return 1;
  }
  thread_sleep_ms(150);  // a moment for the helper to be heard, if there is one
  g_boss.cores.send(pid, GO, 0);
  g_boss.run();
  g_boss.shut();
  println("{g_primes} primes below {CHUNK * CHUNKS}: {g_batch.by_way[ALPH_CPU]} chunks counted here, {g_batch.by_way[ALPH_FAR]} on another machine");
  if (g_primes != 148933) {
    return 1;
  }
  return 0;
}

fn helper_main(arg: cstring) -> uint32 {
  g_helper.run();
  return 0;
}

// The address a.b.c.d in text as one number, 0 when it is not one.
fn address(text: cstring) -> uint32 {
  var part: int64[4];
  var at: int32 = 0;
  var i: int32 = 0;
  part[0] = 0;
  while (text[i] != 0) {
    if (text[i] == 46 && at < 3) {
      at = at + 1;
      part[at] = 0;
    } else if (text[i] >= 48 && text[i] <= 57) {
      part[at] = part[at] * 10 + (int64)(text[i] - 48);
    } else {
      return 0;
    }
    i = i + 1;
  }
  if (at != 3) {
    return 0;
  }
  return alph_ip4(part[0], part[1], part[2], part[3]);
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc == 3) {
    var ip: uint32 = address(argv[2]);
    if (ip == 0) {
      println("the address should look like 192.168.1.10");
      return 2;
    }
    if (argv[1][0] == 104) {  // h: a helper waits for work until it is stopped
      machine(&g_helper, 3, 0, ip, BOSS_PORT);
      if (g_helper.start(HELPER_PORT) != ALPH_OK) {
        println("port {HELPER_PORT} is taken");
        return 1;
      }
      println("helping: waiting for work");
      g_helper.run();
      return 0;
    }
    return run_boss(ip);
  }
  var here: uint32 = alph_ip4(127, 0, 0, 1);
  machine(&g_helper, 3, 0, here, BOSS_PORT);
  if (g_helper.start(HELPER_PORT) != ALPH_OK) {
    println("port {HELPER_PORT} is taken");
    return 1;
  }
  var helper: int64 = CreateThread(0, 0, &helper_main, 0, 0, 0);
  var out: int32 = run_boss(here);
  g_helper.stop();
  thread_join_infinite(helper);
  thread_close(helper);
  g_helper.shut();
  return out;
}
