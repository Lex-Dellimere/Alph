// Two boards as one. This board asks the board at the other end of its
// serial line, which runs examples/mcu/tether.mettle, for the next number
// fifty times, then tells it to stop. No other machine is involved: each
// board's actor reaches the other's by its pid.
//
// The line sends nothing again, so the asker does: a question with no
// answer after a tenth of a second is asked once more.
//
//   mettle --release examples/mcu/asker.mettle --target riscv32-none \
//       --board qemu-virt --emit-flat asker.bin -I ports/mcu

import "port/board";
import "alph/actor/actor";
import "alph/time/time";
import "alph/tether/tether";

const PING: Word = 1;
const PONG: Word = 2;
const QUIT: Word = 3;
const TICK: Word = 4;
const ROUNDS: Word = 50;

var g_node: AlphNode;
var g_actors: AlphActor[2];
var g_mail: AlphMsg[8];
var g_tether: AlphTether;
var g_time: AlphTime;
var g_timers: AlphTimer[2];

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

struct Asker {
  other: Word;    // the actor on the other board
  number: Word;
  ref: Word;
  answered: Word;
  wrong: Word;
}

fn asker(a: AlphActor*, m: AlphMsg*) -> Word {
  var s: Asker* = (Asker*)a->state;
  if (m->tag == PONG) {
    if (m->ref != s->ref) {
      return 0;  // the answer to a question already asked again
    }
    if (m->arg != s->number + 1) {
      s->wrong = s->wrong + 1;
    }
    s->number = m->arg;
    s->answered = 1;
    if (s->number >= ROUNDS) {
      a->send(s->other, QUIT, 0);
      a->node->stop();
      return 0;
    }
    s->ref = a->ask(s->other, PING, s->number);
    s->answered = 0;
    return 0;
  }
  // A tick: ask if nothing came back since the last one.
  if (s->answered == 0) {
    s->ref = a->ask(s->other, PING, s->number);
  }
  s->answered = 0;
  g_time.after(100, a->pid, TICK, 0);
  return 0;
}

var g_asker: Asker;

// This board is place 0. The other board is place 1, and its one actor is
// the first it spawned.
fn main() -> int32 {
  alph_board_start();
  g_asker.other = (Word)(((Word)1 << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS));
  g_asker.number = 0;
  g_asker.answered = 0;
  g_asker.wrong = 0;
  g_node.init(&g_actors[0], 2, &g_mail[0], 4);
  g_tether.init(&g_node, 0, 1, 1);
  g_time.init(&g_node, &g_timers[0], 2);
  var me: Word = g_node.spawn(&asker, (rawptr)&g_asker);
  mettle_irq_enable();
  g_time.after(100, me, TICK, 0);
  g_node.run();
  g_time.stop();
  if (g_asker.number != ROUNDS || g_asker.wrong != 0) {
    return 1;
  }
  return 0;
}
