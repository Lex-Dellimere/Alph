// alph on a bare 32-bit RISC-V board, no OS. A timer sends TICK to the clock
// actor every millisecond. The clock counts and tells the lamp, which prints
// the count and stops the node at 5.
//
//   mettle --release examples/mcu/blink.mettle --target riscv32-none \
//       --board qemu-virt --emit-flat blink.bin -I ports/mcu
//   qemu-system-riscv32 -M virt -bios none -nographic \
//       -device loader,file=blink.bin,addr=0x80000000,force-raw=on

import "alph/actor/actor";
import "alph/time/time";

const TICK: Word = 1;
const LAMP: Word = 2;

var g_node: AlphNode;
var g_actors: AlphActor[2];
var g_mail: AlphMsg[8];
var g_time: AlphTime;
var g_timers: AlphTimer[2];
var g_lamp: Word = 0;
var g_count: Word = 0;

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

fn lamp(a: AlphActor*, m: AlphMsg*) -> Word {
  mettle_board_putc((uint8)(48 + m->arg));
  mettle_board_putc(10);
  if (m->arg >= 5) {
    a->node->stop();
  }
  return 0;
}

fn clock(a: AlphActor*, m: AlphMsg*) -> Word {
  var count: Word* = (Word*)a->state;
  *count = *count + 1;
  a->send(g_lamp, LAMP, *count);
  g_time.after(1, a->pid, TICK, 0);
  return 0;
}

fn main() -> int32 {
  g_node.init(&g_actors[0], 2, &g_mail[0], 4);
  g_time.init(&g_node, &g_timers[0], 2);
  g_lamp = g_node.spawn(&lamp, 0);
  var clock_pid: Word = g_node.spawn(&clock, (rawptr)&g_count);
  mettle_board_trap_install();
  mettle_irq_enable();
  g_time.after(1, clock_pid, TICK, 0);
  g_node.run();
  g_time.stop();
  return (int32)g_count;
}
