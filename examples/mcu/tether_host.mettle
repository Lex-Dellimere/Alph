// The other end of examples/mcu/tether.mettle: a Linux process tied to the
// board by its serial line, here a TCP connection that QEMU makes. An actor
// here asks the board's actor for the next number 200 times, then tells it
// to stop. check.sh runs the two together.
//
//   mettle --build -s --release examples/mcu/tether_host.mettle -I ports/host -o tether_host
//   ./tether_host 7421 &
//   qemu-system-riscv32 -M virt -bios none -display none -monitor none \
//       -serial tcp:127.0.0.1:7421 -device loader,file=tether.bin,addr=0x80000000,force-raw=on

import "std/io";
import "std/thread";
import "port/net";
import "port/line";
import "alph/actor/actor";
import "alph/time/time";
import "alph/tether/tether";

const GO: Word = 1;
const PONG: Word = 2;
const QUIT: Word = 3;
const LATE: Word = 4;
const PING: Word = 1;
const ROUNDS: Word = 200;

var g_node: AlphNode;
var g_actors: AlphActor[2];
var g_mail: AlphMsg[16];
var g_tether: AlphTether;
var g_time: AlphTime;
var g_timers: AlphTimer[2];

struct Pinger {
  board: Word;
  ref: Word;
  rounds: Word;
  bad: Word;
  late: Word;
}

fn pinger(a: AlphActor*, m: AlphMsg*) -> Word {
  var p: Pinger* = (Pinger*)a->state;
  if (m->tag == LATE) {
    p->late = 1;
    a->node->stop();
    return 0;
  }
  if (m->tag == PONG) {
    if (m->ref != p->ref || m->arg != p->rounds + 1 || m->from != p->board) {
      p->bad = p->bad + 1;
    }
    p->rounds = m->arg;
    if (p->rounds >= ROUNDS) {
      a->send(p->board, QUIT, 0);
      a->node->stop();
      return 0;
    }
  }
  p->ref = a->ask(p->board, PING, p->rounds);
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var port: int64 = 7421;
  if (argc > 1) {
    port = 0;
    var i: int32 = 0;
    while (argv[1][i] >= 48 && argv[1][i] <= 57) {
      port = port * 10 + (int64)(argv[1][i] - 48);
      i = i + 1;
    }
  }
  var listening: int64 = alph_tcp_listen(port);
  if (listening < 0) {
    println("port {port} is taken");
    return 1;
  }
  // Wait for the board's line, 20 seconds at most.
  var line: int64 = ALPH_LATER;
  var waited: int32 = 0;
  while (line < 0 && waited < 2000) {
    line = alph_tcp_accept(listening);
    waited = waited + 1;
    Sleep(10);
  }
  if (line < 0) {
    println("no board called");
    return 1;
  }
  syscall(72, line, 4, 0);  // the line's thread reads it and waits
  alph_line_open(line);

  // This machine is place 0. The board is place 1, and its one actor is the
  // first it spawned.
  var p: Pinger;
  p.board = (Word)(((Word)1 << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS));
  p.rounds = 0;
  p.bad = 0;
  p.late = 0;
  g_node.init(&g_actors[0], 2, &g_mail[0], 8);
  g_tether.init(&g_node, 0, 1, 1);
  g_time.init(&g_node, &g_timers[0], 2);
  var me: Word = g_node.spawn(&pinger, (rawptr)&p);
  g_time.after(10000, me, LATE, 0);
  Sleep(200);  // the board is still starting
  g_node.send(me, GO, 0);
  g_node.run();
  g_time.stop();
  Sleep(100);  // let the word to stop reach the board
  alph_close(line);
  alph_close(listening);
  println("{p.rounds} numbers answered by the board, {p.bad} wrong, {g_tether.dropped} messages dropped");
  if (p.rounds != ROUNDS || p.bad != 0 || p.late != 0) {
    return 1;
  }
  return 0;
}
