// A computer with a board on its serial line, working as one machine. The
// board is examples/mcu/arm.mettle. The computer asks for three kinds of
// work and never says where any is done:
//
//   - six joint angles, which only the board can read, so all six go there
//   - five moves of the arm, ten steps each, which only the board can make
//     and which must never be made twice: the arm ends at fifty
//   - the primes below 100,000 in 200 chunks, which both can count, so
//     alph sends each chunk to a core here or to the board, wherever it
//     should be done first
//
// check.sh runs the two together, the board in QEMU.
//
//   mettle --build -s --release examples/mcu/arm_host.mettle -I ports/host -o arm_host
//   ./arm_host 7461 &
//   qemu-system-riscv32 -M virt -bios none -display none -monitor none \
//       -serial tcp:127.0.0.1:7461 -device loader,file=arm.bin,addr=0x80000000,force-raw=on
//
// With a real board, name its serial device in place of the port:
//
//   ./arm_host /dev/ttyUSB0

import "std/io";
import "std/thread";
import "port/net";
import "port/line";
import "alph/actor/actor";
import "alph/machine/machine";
import "alph/batch/batch";
import "arm_work";
import "host_line";
import "port/sys";

const LATE: Word = 4;
const JOINTS: Word = 6;
const MOVES: Word = 5;
const CHUNKS: Word = 200;
const BOARD: Word = 8;  // the board's place

var g_m: AlphMachine;
var g_batch: AlphBatch;
var g_primes: Word = 0;
var g_angles: Word = 0;
var g_wrong: Word = 0;
var g_late: Word = 0;
var g_on_board: Word = 0;
var g_moved: Word = 0;
var g_arm_at: Word = 0;  // the furthest the board said the arm was

fn primes_job(job: AlphJob*) -> Word {
  job->out = count_primes(job->in);
  return 0;
}

fn each(b: AlphBatch*, job: AlphJob*, piece: Word) {
  if (b->kind == MOVE) {
    job->in = 10;
  }
}

fn answered(b: AlphBatch*, job: AlphJob*, piece: Word) {
  if (job->status != ALPH_OK) {
    g_wrong = g_wrong + 1;
  } else if (b->kind == MOVE) {
    g_moved = g_moved + 1;
    if (job->out > g_arm_at) {
      g_arm_at = job->out;
    }
  } else if (b->kind == ANGLE) {
    g_angles = g_angles + 1;
    if (job->out != (Word)(piece * 3) + 1 || job->way != ALPH_FAR) {
      g_wrong = g_wrong + 1;
    }
  } else {
    g_primes = g_primes + job->out;
  }
}

// Begins when the board is heard: the angles, then the moves, then the
// primes.
fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == LATE) {
    g_late = 1;
    a->cores()->stop();
  } else if (m->tag == ALPH_UP && m->arg == BOARD) {
    g_batch.begin(a, ANGLE, JOINTS, &each, &answered, 0);
  } else if (g_batch.took(a, m) && g_batch.over()) {
    if (g_batch.kind == ANGLE) {
      g_batch.begin(a, MOVE, MOVES, &each, &answered, 0);
    } else if (g_batch.kind == MOVE) {
      g_batch.begin(a, PRIMES, CHUNKS, &each, &answered, 0);
    } else {
      g_on_board = g_batch.by_way[ALPH_FAR];
      // The board's second actor is the one that stops it.
      a->send((Word)((BOARD << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS) | 1), QUIT, 0);
      a->cores()->stop();
    }
  }
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var line: int64 = host_line(argc, argv, 7461);
  if (line < 0) {
    return 1;
  }

  g_m.init(2, 0, false);
  g_m.kind(PRIMES, &primes_job, 0);
  g_m.share(PRIMES);
  g_m.kind(ANGLE, 0, 0);  // no way to do it here
  g_m.share(ANGLE);
  g_m.kind(MOVE, 0, 0);
  g_m.share(MOVE);
  g_m.once(MOVE);  // a move is never made twice
  g_m.board(BOARD, 1);
  g_m.batch(&g_batch);
  var pid: Word = g_m.cores.spawn_on(0, &boss, 0);
  g_m.tell(pid);
  g_m.time.after(20000, pid, LATE, 0);
  g_m.run();
  Sleep(100);  // let the word to stop reach the board
  g_m.shut();
  alph_close(line);
  println("{g_angles} angles read by the board. {g_moved} moves made once each: the arm is at {g_arm_at}. {g_primes} primes below {CHUNK * CHUNKS}: {CHUNKS - g_on_board} chunks counted here, {g_on_board} on the board");
  if (g_late != 0 || g_wrong != 0 || g_angles != JOINTS || g_moved != MOVES || g_arm_at != 50 || g_batch.lost != 0 || g_primes != 9592 || g_on_board < 1) {
    return 1;
  }
  return 0;
}
