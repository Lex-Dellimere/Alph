// The short way, as short as it gets: one kind of work, done in pieces on
// every core of this machine. The program says how one piece is done, a
// number in and a number out, and what to do with each answer. alph hands
// the pieces out and comes back when all are answered.
//
//   mettle --build -s --release examples/primes.mettle -I ports/host -o primes

import "std/io";
import "alph/actor/actor";
import "alph/machine/machine";

const PRIMES: Word = 0;    // the kind of work
const CHUNKS: Word = 200;
const CHUNK: Word = 5000;  // numbers in a chunk

var g_m: AlphMachine;
var g_primes: Word = 0;

// One piece: the primes in one chunk.
fn primes_in(chunk: Word) -> Word {
  var found: Word = 0;
  var n: Word = (Word)(chunk * CHUNK);
  var end: Word = n + CHUNK;
  while (n < end) {
    var prime: bool = n >= 2;
    var d: Word = 2;
    while (prime && d * d <= n) {
      if (n % d == 0) {
        prime = false;
      }
      d = d + 1;
    }
    if (prime) {
      found = found + 1;
    }
    n = n + 1;
  }
  return found;
}

// Called with each answer.
fn counted(chunk: Word, found: Word, ctx: rawptr) {
  g_primes = g_primes + found;
}

fn main() -> int32 {
  g_m.init(4, 0, false);               // four cores: one hands out, three work
  g_m.piece(PRIMES, &primes_in);       // how one piece of the work is done
  var undone: Word = g_m.pieces(PRIMES, CHUNKS, &counted, 0);
  g_m.shut();
  println("{g_primes} primes below {CHUNKS * CHUNK}, counted in {CHUNKS} chunks on this machine's cores");
  if (undone != 0 || g_primes != 78498) {
    return 1;
  }
  return 0;
}
