// A picture drawn by however many machines run this program. Each row is a
// job: its number goes out, and its pixels come back as bytes. The machine
// started as the boss hands the rows out, and alph sends each to one of
// its own cores or to another machine, wherever it should be done first.
// A row drawn here is written straight into the picture. A row drawn on
// another machine comes back over the link and is put in the same place.
//
// The helper has a GPU way for the same work, so a machine with no GPU
// uses another machine's: the boss sends a row, the helper's own places
// send it to its GPU or a core, whichever should be done first, and the
// pixels are the same either way. A helper with no GPU draws on its cores.
//
// With no arguments two machines run in this one process:
//
//   mettle --build -s --release examples/picture.mettle -I ports/host -o picture
//   ./picture
//
// On two computers, each with the other's address:
//
//   ./picture helper 192.168.1.10
//   ./picture boss 192.168.1.20

import "std/io";
import "std/gpu";
import "std/thread";
import "alph/actor/actor";
import "alph/machine/machine";
import "alph/batch/batch";

const WIDE: Word = 1000;
const HIGH: Word = 1200;
const ROW: Word = 0;  // the kind of job: in is a row's number, its pixels come back
const GO: Word = 1;
const BOSS_PORT: int64 = 7471;
const HELPER_PORT: int64 = 7472;

var g_boss: AlphMachine;
var g_helper: AlphMachine;
var g_batch: AlphBatch;
var g_picture: uint8[1200000];
var g_short: Word = 0;  // rows that came back with too few pixels
var g_device: int64 = 0;      // one row on the GPU
var g_row: int32[1000];      // and brought back
var g_gpu_state: int32 = 0;  // 0 not tried, 1 ready, 2 none
var g_gpu_rows: Word = 0;
var g_warm_job: AlphJob;     // a helper draws one row for itself first,
var g_warm_row: uint8[1000]; // so its GPU is open before work arrives
var g_warmed: int32 = 0;

// One pixel of the Mandelbrot set: how many steps until the point leaves.
// A core and the GPU both call this, so the picture is the same bits
// wherever it is drawn.
fn pixel(i: int32) -> int32 {
  var cr: float32 = (float32)(i % 1000) * (float32)3 / (float32)1000 - (float32)2;
  var ci: float32 = (float32)(i / 1000) * (float32)2 / (float32)1200 - (float32)1;
  var zr: float32 = (float32)0;
  var zi: float32 = (float32)0;
  var steps: int32 = 0;
  while (steps < 255 && zr * zr + zi * zi < (float32)4) {
    var next: float32 = zr * zr - zi * zi + cr;
    zi = (float32)2 * zr * zi + ci;
    zr = next;
    steps = steps + 1;
  }
  return steps;
}

kernel(block = 256) row_kernel(row: int32*, first: int32, count: int32) {
  var i: int32 = block.x * block_dim.x + thread.x;
  if (i < count) {
    row[i] = pixel(first + i);
  }
}

// The work on a core: draws one row into the bytes the job gives back.
fn draw_row(job: AlphJob*) -> Word {
  if (job->back == 0 || job->back_room < WIDE) {
    return 0;
  }
  var first: int32 = (int32)job->in * 1000;
  for x in 0..1000 {
    job->back[x] = (uint8)pixel(first + x);
  }
  job->back_count = WIDE;
  return 0;
}

// The same work on the GPU. It runs on the GPU's own core, which is the
// thread that opens the GPU.
fn draw_row_gpu(job: AlphJob*) -> Word {
  if (g_gpu_state == 0) {
    g_gpu_state = 2;
    if (gpu_init() != 0) {
      g_device = gpu_malloc(4000);
      if (g_device != 0) {
        g_gpu_state = 1;
      }
    }
  }
  if (g_gpu_state != 1 || job->back == 0 || job->back_room < WIDE) {
    return 1;  // no GPU: alph sends the row to a core and does not try this again
  }
  dispatch row_kernel[work: 1000](g_device, (int32)job->in * 1000, 1000);
  if (gpu_sync() != 0 || gpu_to_host((uint8*)&g_row[0], g_device, 4000) != 0) {
    return 1;
  }
  for x in 0..1000 {
    job->back[x] = (uint8)g_row[x];
  }
  job->back_count = WIDE;
  g_gpu_rows = g_gpu_rows + 1;
  return 0;
}

// What every machine does: three cores, the one kind of work, shared. With
// gpu, the last core is the GPU's and the kind has a GPU way.
fn machine(m: AlphMachine*, first: Word, other: Word, ip: uint32, port: int64, gpu: bool) {
  m->init(3, first, gpu);
  m->peer(other, 3, ip, port);
  if (gpu) {
    m->kind(ROW, &draw_row, &draw_row_gpu);
  } else {
    m->kind(ROW, &draw_row, 0);
  }
  m->share(ROW);
}

// Each row's pixels go where that row is in the picture.
fn each_row(b: AlphBatch*, job: AlphJob*, row: Word) {
  job->back = &g_picture[row * WIDE];
  job->back_room = WIDE;
}

fn drawn(b: AlphBatch*, job: AlphJob*, row: Word) {
  if (job->status != ALPH_OK || job->back_count != WIDE) {
    g_short = g_short + 1;
  }
}

fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == GO) {
    g_batch.begin(a, ROW, HIGH, &each_row, &drawn, 0);
  } else if (g_batch.took(a, m) && g_batch.over()) {
    a->cores()->stop();
  }
  return 0;
}

fn run_boss(helper_ip: uint32) -> int32 {
  machine(&g_boss, 0, 3, helper_ip, HELPER_PORT, false);  // the boss has no GPU
  g_boss.batch(&g_batch);
  var pid: Word = g_boss.cores.spawn_on(0, &boss, 0);
  if (g_boss.start(BOSS_PORT) != ALPH_OK) {
    println("port {BOSS_PORT} is taken");
    return 1;
  }
  thread_sleep_ms(150);  // a moment for the helper to be heard, if there is one
  g_boss.cores.send(pid, GO, 0);
  g_boss.run();
  g_boss.shut();
  // Every pixel is checked against the same function run here.
  var wrong: Word = 0;
  var inside: Word = 0;
  for i in 0..1200000 {
    var right: uint8 = (uint8)pixel(i);
    if (g_picture[i] != right) {
      wrong = wrong + 1;
    }
    if (right == 255) {
      inside = inside + 1;
    }
  }
  println("{HIGH} rows of {WIDE} pixels: {g_batch.by_way[ALPH_CPU]} rows drawn here, {g_batch.by_way[ALPH_FAR]} on another machine ({g_gpu_rows} of them on its GPU), {wrong} pixels wrong, {inside} inside the set");
  if (wrong != 0 || g_short != 0) {
    return 1;
  }
  return 0;
}

// On a helper: draws row 0 once through the helper's own places, which
// try the GPU first. Opening a GPU takes a good part of a second, and the
// first job would otherwise pay for it.
fn warm(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == GO) {
    g_warm_job.kind = ROW;
    g_warm_job.size = 1;
    g_warm_job.home = ALPH_NOWHERE;
    g_warm_job.stay = 1;
    g_warm_job.in = 0;
    g_warm_job.count = 0;
    g_warm_job.back = &g_warm_row[0];
    g_warm_job.back_room = WIDE;
    if (g_helper.places.ask(a, &g_warm_job) < 0) {
      g_warmed = 1;
    }
  } else if (m->tag == ALPH_DONE) {
    g_warmed = 1;
  }
  return 0;
}

fn start_helper(ip: uint32) -> bool {
  machine(&g_helper, 3, 0, ip, BOSS_PORT, true);
  var pid: Word = g_helper.cores.spawn_on(0, &warm, 0);
  if (g_helper.start(HELPER_PORT) != ALPH_OK) {
    println("port {HELPER_PORT} is taken");
    return false;
  }
  g_helper.cores.send(pid, GO, 0);
  return true;
}

fn helper_main(arg: cstring) -> uint32 {
  g_helper.run();
  return 0;
}

// The address a.b.c.d in text as one number, 0 when it is not one.
fn address(text: cstring) -> uint32 {
  var part: int64[4];
  var at: int32 = 0;
  var i: int32 = 0;
  part[0] = 0;
  while (text[i] != 0) {
    if (text[i] == 46 && at < 3) {
      at = at + 1;
      part[at] = 0;
    } else if (text[i] >= 48 && text[i] <= 57) {
      part[at] = part[at] * 10 + (int64)(text[i] - 48);
    } else {
      return 0;
    }
    i = i + 1;
  }
  if (at != 3) {
    return 0;
  }
  return alph_ip4(part[0], part[1], part[2], part[3]);
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc == 3) {
    var ip: uint32 = address(argv[2]);
    if (ip == 0) {
      println("the address should look like 192.168.1.10");
      return 2;
    }
    if (argv[1][0] == 104) {  // h: a helper waits for work until it is stopped
      if (!start_helper(ip)) {
        return 1;
      }
      println("helping: waiting for rows to draw");
      g_helper.run();
      return 0;
    }
    return run_boss(ip);
  }
  var here: uint32 = alph_ip4(127, 0, 0, 1);
  if (!start_helper(here)) {
    return 1;
  }
  var helper: int64 = CreateThread(0, 0, &helper_main, 0, 0, 0);
  var waited: int32 = 0;
  while (g_warmed == 0 && waited < 300) {
    thread_sleep_ms(10);  // until the helper's GPU is open, or it has none
    waited = waited + 1;
  }
  var out: int32 = run_boss(here);
  g_helper.stop();
  thread_join_infinite(helper);
  thread_close(helper);
  g_helper.shut();
  return out;
}
