// Renders a Mandelbrot picture in tiles, each tile a job that can run on a
// CPU core or on the GPU. Both ways call the same escape(), so the pixels
// are the same bits either way. alph times the two and sends each tile where
// it should finish first.
//
// Work travels, data stays: a tile rendered on the GPU stays there. When the
// picture is done the boss asks for it on the host, and alph has the GPU's
// place bring what it holds across once, in one piece.
// Copying each tile back as it finished cost three times as much for small
// tiles, nearly all of it the crossing.
//
// Every size is also rendered on the cores only and on the GPU only, to show
// what the choice is worth. Without a GPU it all runs on the cores.
//
//   mettle --build --release examples/render.mettle -I ports/host -o render

import "std/io";
import "std/gpu";
import "alph/actor/actor";
import "alph/cores/cores";
import "alph/place/place";

const WIDTH: int32 = 512;
const PIXELS: int32 = 262144;
const DEPTH: int32 = 256;
const WINDOW: Word = 8;  // tiles out at once

const EITHER: Word = 0;
const CORES_ONLY: Word = 1;
const GPU_ONLY: Word = 2;
const FETCH: Word = 3;  // a job only a core can run, on data that is on the GPU: alph brings it
const GO: Word = 1;
const STEPS: Word = 13;

struct Tile {
  first: int32;
  count: int32;
}

var g_cores: AlphCores;
var g_core: AlphCore[5];
var g_actors: AlphActor[5];
var g_mail: AlphMsg[80];
var g_places: AlphPlaces;
var g_seats: AlphPlace[4];
var g_kinds: AlphKind[4];
var g_jobs: AlphJob[8];
var g_tiles: Tile[8];
var g_image: int32[262144];
var g_fetched: int32[262144];
var g_truth: int32[262144];
var g_on_gpu: uint8[4096];  // by tile: its pixels are on the GPU, not in g_image
var g_device: int64 = 0;
var g_gpu_state: int32 = 0;  // 0 not tried, 1 ready, 2 none

// How many steps the point of pixel i takes to leave the set, DEPTH if it
// never does.
fn escape(i: int32) -> int32 {
  var cr: float32 = (float32)(i % WIDTH) * (float32)3 / (float32)WIDTH - (float32)2;
  var ci: float32 = (float32)(i / WIDTH) * (float32)3 / (float32)WIDTH - (float32)3 / (float32)2;
  var zr: float32 = (float32)0;
  var zi: float32 = (float32)0;
  var n: int32 = 0;
  while (n < DEPTH && zr * zr + zi * zi < (float32)4) {
    var t: float32 = zr * zr - zi * zi + cr;
    zi = (float32)2 * zr * zi + ci;
    zr = t;
    n = n + 1;
  }
  return n;
}

kernel(block = 256) tile_kernel(picture: int32*, first: int32, count: int32) {
  var i: int32 = block.x * block_dim.x + thread.x;
  if (i < count) {
    picture[first + i] = escape(first + i);
  }
}

fn tile_on_core(job: AlphJob*) -> Word {
  var t: Tile* = (Tile*)job->data;
  for i in t->first..(t->first + t->count) {
    g_image[i] = escape(i);
  }
  return 0;
}

// Runs on the GPU place's own thread, which is the one that opens the GPU.
// The pixels stay on the GPU.
fn tile_on_gpu(job: AlphJob*) -> Word {
  var t: Tile* = (Tile*)job->data;
  if (g_gpu_state == 0) {
    g_gpu_state = 2;
    if (gpu_init() != 0) {
      g_device = gpu_malloc((int64)PIXELS * 4);
      if (g_device != 0) {
        g_gpu_state = 1;
      }
    }
  }
  if (g_gpu_state != 1) {
    return 1;
  }
  dispatch tile_kernel[work: t->count](g_device, t->first, t->count);
  if (gpu_sync() != 0) {
    return 1;
  }
  return 0;
}

// One crossing for everything the GPU holds. alph runs this on the GPU's
// place when a core is to run a job whose data is on the GPU.
fn bring_picture(job: AlphJob*) -> Word {
  if (g_gpu_state != 1 || gpu_to_host((uint8*)&g_fetched[0], g_device, (int64)PIXELS * 4) != 0) {
    return 1;
  }
  return 0;
}

// The picture is on the host by the time a core runs this.
fn picture_here(job: AlphJob*) -> Word {
  return 0;
}

fn now_ns() -> Word {
  var ts: int64[2];
  syscall(228, 1, (int64)&ts[0]);
  return (Word)(ts[0] * 1000000000 + ts[1]);
}

// One step renders the picture several times in tiles of one size, one
// way. The boss works through the steps: every size on the cores only, on
// the GPU only, then wherever alph sends it. The first step is one tile on
// the GPU, so that opening the GPU is not counted in any other.
struct Step {
  kind: Word;
  tile: int32;
  total: Word;
  on_cores: Word;
  on_gpu: Word;
  gone: Word;
  us: Word;
  wrong: int32;
}

struct Boss {
  step: Word;
  sent: Word;
  back: Word;
  fetching: bool;
  began: Word;
  free: AlphJob*;
}

var g_steps: Step[13];

fn begin(b: Boss*) {
  for i in 0..PIXELS {
    g_image[i] = -1;
  }
  for i in 0..4096 {
    g_on_gpu[i] = 0;
  }
  b->sent = 0;
  b->back = 0;
  b->fetching = false;
  b->began = now_ns();
}

// The picture is whole on the host from here: the time stops, then it is
// checked.
fn finish(b: Boss*, s: Step*) {
  if (b->fetching) {
    for i in 0..(PIXELS / s->tile) {
      if (g_on_gpu[i] != 0) {
        for at in (i * s->tile)..((i + 1) * s->tile) {
          g_image[at] = g_fetched[at];
        }
      }
    }
  }
  s->us = (Word)((now_ns() - b->began) / 1000);
  if (s->gone == 0) {
    for i in 0..PIXELS {
      if (g_image[i] != g_truth[i]) {
        s->wrong = s->wrong + 1;
      }
    }
  }
}

fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  var b: Boss* = (Boss*)a->state;
  var s: Step* = &g_steps[b->step];
  if (m->tag == ALPH_DONE) {
    var done: AlphJob* = (AlphJob*)m->arg;
    var t: Tile* = (Tile*)done->data;
    b->back = b->back + 1;
    if (done->status != ALPH_OK) {
      s->gone = s->gone + 1;
    } else if (done->kind == FETCH) {
    } else if (done->way == ALPH_GPU) {
      s->on_gpu = s->on_gpu + 1;
      g_on_gpu[t->first / s->tile] = 1;
    } else {
      s->on_cores = s->on_cores + 1;
      g_on_gpu[t->first / s->tile] = 0;
    }
    done->next = b->free;
    b->free = done;
  } else {
    begin(b);
  }
  while (true) {
    while (b->sent < s->total && b->free != 0) {
      var job: AlphJob* = b->free;
      var t: Tile* = (Tile*)job->data;
      b->free = job->next;
      t->first = (int32)((b->sent * s->tile) % PIXELS);
      t->count = s->tile;
      job->kind = s->kind;
      job->size = (Word)s->tile;
      job->home = ALPH_NOWHERE;  // a tile is made, not moved
      var out: Word = g_places.ask(a, job);
      if (out < 0) {
        job->next = b->free;
        b->free = job;
      }
      if (out == ALPH_FULL) {
        return 0;
      }
      b->sent = b->sent + 1;
      if (out == ALPH_GONE) {
        b->back = b->back + 1;
        s->gone = s->gone + 1;
      }
    }
    if (b->back < s->total) {
      return 0;
    }
    if (s->on_gpu > 0 && !b->fetching) {
      var fetch: AlphJob* = b->free;
      b->free = fetch->next;
      fetch->kind = FETCH;
      fetch->size = (Word)PIXELS;
      fetch->home = ALPH_GPU;
      b->fetching = true;
      b->back = b->back - 1;  // the fetch's answer makes the count whole again
      if (g_places.ask(a, fetch) > 0) {
        return 0;
      }
      s->gone = s->gone + 1;
      b->back = b->back + 1;
      fetch->next = b->free;
      b->free = fetch;
    }
    finish(b, s);
    b->step = b->step + 1;
    if (b->step == STEPS) {
      a->cores()->stop();
      return 1;
    }
    s = &g_steps[b->step];
    begin(b);
  }
  return 0;
}

var g_boss: Boss;

fn main() -> int32 {
  g_cores.init(&g_core[0], 5, &g_actors[0], 1, &g_mail[0], 16);
  g_places.init(&g_seats[0], 4, &g_kinds[0], 4);
  g_places.kind(EITHER, &tile_on_core, &tile_on_gpu);
  g_places.kind(CORES_ONLY, &tile_on_core, 0);
  g_places.kind(GPU_ONLY, 0, &tile_on_gpu);
  g_places.kind(FETCH, &picture_here, 0);
  g_places.bring(FETCH, &bring_picture);
  var boss_pid: Word = g_cores.spawn_on(0, &boss, (rawptr)&g_boss);
  g_places.on_core(&g_cores, 1, ALPH_CPU);
  g_places.on_core(&g_cores, 2, ALPH_CPU);
  g_places.on_core(&g_cores, 3, ALPH_CPU);
  g_places.on_core(&g_cores, 4, ALPH_GPU);
  g_boss.step = 0;
  g_boss.free = 0;
  for i in 0..WINDOW {
    g_jobs[i].data = (rawptr)&g_tiles[i];
    g_jobs[i].next = g_boss.free;
    g_boss.free = &g_jobs[i];
  }
  for i in 0..PIXELS {
    g_truth[i] = escape(i);
  }

  var tile: int32 = 64;
  var pictures: int32 = 1;
  for i in 0..STEPS {
    g_steps[i].on_cores = 0;
    g_steps[i].on_gpu = 0;
    g_steps[i].gone = 0;
    g_steps[i].wrong = 0;
  }
  g_steps[0].kind = GPU_ONLY;
  g_steps[0].tile = 64;
  g_steps[0].total = 1;
  for i in 0..4 {
    for kind in 0..3 {
      var s: Step* = &g_steps[1 + i * 3 + kind];
      s->kind = (Word)((kind + 1) % 3);  // cores only, gpu only, either
      s->tile = tile;
      s->total = (Word)(pictures * (PIXELS / tile));
    }
    tile = tile * 16;
    pictures = pictures * 4;
  }
  g_cores.send(boss_pid, GO, 0);
  g_cores.run();

  var wrong: int32 = 0;
  println("pixels a tile, tiles: on 3 cores, on the gpu, where alph sent them");
  for i in 0..4 {
    var cores: Step* = &g_steps[1 + i * 3];
    var gpu: Step* = &g_steps[2 + i * 3];
    var either: Step* = &g_steps[3 + i * 3];
    wrong = wrong + cores->wrong + gpu->wrong + either->wrong;
    if (gpu->gone != 0) {
      println("{cores->tile}, {cores->total}: {cores->us} us, no gpu, {either->us} us ({either->on_cores} to cores, {either->on_gpu} to the gpu)");
    } else {
      println("{cores->tile}, {cores->total}: {cores->us} us, {gpu->us} us, {either->us} us ({either->on_cores} to cores, {either->on_gpu} to the gpu)");
    }
  }
  if (wrong != 0) {
    println("FAIL {wrong} pixels differ from the same picture computed on one core");
    return 1;
  }
  println("every pixel matches the picture computed on one core");
  return 0;
}
