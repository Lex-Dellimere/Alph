// sim: a live world of alph actors in a MythicUI window with MistPlot charts.
//
// 640 cell actors (a 32 x 20 grid) pass energy to their neighbours and grow
// logistically. A dynamic supervisor restarts every cell that crashes. Nothing
// crashes until the UI raises the chaos rate (or presses Crash storm); then a
// chaos actor crashes random cells. 32 client actors send requests to random
// cells at a rate the UI sets and count the answers, the DOWNs and the
// timeouts. The window shows the grid as a heatmap (a restarted cell flashes
// red and regrows from zero) and live charts of energy, messages, requests,
// request latency, crashes and restarts.
//
// The alph schedulers run on their own threads. This thread, the UI, reads only
// the shared atomics in world.mettle, and talks to the actors with
// alph_node_send. The MistPlot rings are touched by this thread alone.
//
//   sim                                         open the window
//   sim --snapshot out.png --seconds 3 [--storm]   headless: run, write the last frame, exit
//
// Other flags: --rate N sets the starting chaos rate (crashes per second,
// default 0), --requests N the starting request rate (per second, default 0),
// --stderr keeps stderr.
// The Mettle runtime prints a stack trace to stderr for every crash it
// recovers from, which at the chaos rates here would bury the terminal, so
// stderr goes to /dev/null unless --stderr is given.
//
// Build with demos/sim/build.sh.

import "std/io";
import "std/mem";
import "std/conv";
import "std/time";
import "mythic/mythic";
import "mistplot/core/data";
import "mistplot/chart/spec";
import "mistplot/live/stream";
import "../../../mistplot/integrations/mythic/mp_mythic";
import "alph/sys/atomic";
import "alph/sys/clock";
import "alph/alph";
import "world";

const WINDOW_W: float32 = 1360.0;
const WINDOW_H: float32 = 980.0;
const SAMPLE_MS: int64 = 100;       // a chart sample every 100 ms
const RATE_LOOKBACK: int64 = 5;     // rates are over the last 5 samples, 500 ms
const HISTORY: int64 = 16;
const CHART_WINDOW_S: float64 = 30.0;
const CHART_RING: int64 = 1024;     // MpLive costs O(samples) a frame: keep rings small
const FLASH_MS: int64 = 700;

struct SimUi {
  lv_energy: MpLive*;
  lv_msgs: MpLive*;
  lv_reqs: MpLive*;
  lv_lat: MpLive*;
  lv_faults: MpLive*;
  ch_energy: MpMythicChart*;
  ch_msgs: MpMythicChart*;
  ch_reqs: MpMythicChart*;
  ch_lat: MpMythicChart*;
  ch_faults: MpMythicChart*;
  rate: float32;            // chaos slider, crashes per second
  rate_sent: int64;
  req: float32;             // request slider, requests per second
  req_sent: int64;
  paused: bool;
  paused_sent: bool;
  t0: int64;                // real time of the first sample
  last_sample: int64;
  samples: int64;
  hist_t: int64[16];        // counters at the last HISTORY samples, for rates
  hist_msgs: int64[16];
  hist_crashes: int64[16];
  hist_restarts: int64[16];
  hist_ok: int64[16];
  hist_failed: int64[16];
  hist_timeout: int64[16];
  hist_lat: int64[384];     // 16 samples of the 24 latency buckets
  total: int64;             // latest total energy, fixed point
  msgs_rate: int64;
  crash_rate: int64;
  restart_rate: int64;
  live_actors: int64;
  p50_us: int64;
  p99_us: int64;
}

// ---------------------------------------------------------------- charts

fn sim_chart_live(title: string, n_series: int32, y_label: string) -> MpLive* {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, n_series, CHART_RING);
  mp_live_window(lv, CHART_WINDOW_S);
  var sp: MpChartSpec* = mp_live_spec(lv);
  sp->title = title;
  sp->y_label = y_label;
  sp->x_format = MP_FMT_TIME;
  sp->y_format = MP_FMT_SI;
  sp->y_start_at_zero = true;
  sp->legend = MP_LEGEND_NONE;
  if (n_series > 1) {
    sp->legend = MP_LEGEND_BOTTOM;
  }
  mp_live_touch(lv);
  return lv;
}

fn sim_chart_state() -> MpMythicChart* {
  var st: MpMythicChart* = mp_mythic_chart_new();
  st->frame_ms = 0;     // the frame callback asks for the next frame itself
  return st;
}

fn sim_ui_new(rate: int64, requests: int64) -> SimUi* {
  var s: SimUi* = (SimUi*)malloc((int64)sizeof(SimUi));
  memset((rawptr)s, 0, (int64)sizeof(SimUi));
  s->lv_energy = sim_chart_live("Total energy", 1, "");
  s->lv_msgs = sim_chart_live("Neighbour messages per second (the world itself)", 1, "");
  s->lv_reqs = sim_chart_live("Requests per second", 3, "");
  s->lv_lat = sim_chart_live("Request latency (us)", 2, "");
  s->lv_faults = sim_chart_live("Crashes and restarts per second", 2, "");
  mp_live_series_name(s->lv_energy, 0, "energy");
  mp_live_series_name(s->lv_msgs, 0, "messages/s");
  mp_live_series_name(s->lv_reqs, 0, "answered/s");
  mp_live_series_name(s->lv_reqs, 1, "failed/s");
  mp_live_series_name(s->lv_reqs, 2, "timed out/s");
  mp_live_series_name(s->lv_lat, 0, "p50");
  mp_live_series_name(s->lv_lat, 1, "p99");
  mp_live_series_name(s->lv_faults, 0, "crashes/s");
  mp_live_series_name(s->lv_faults, 1, "restarts/s");
  s->ch_energy = sim_chart_state();
  s->ch_msgs = sim_chart_state();
  s->ch_reqs = sim_chart_state();
  s->ch_lat = sim_chart_state();
  s->ch_faults = sim_chart_state();
  s->rate = (float32)rate;
  s->rate_sent = rate;
  s->req = (float32)requests;
  s->req_sent = requests;
  return s;
}

fn sim_ui_free(s: SimUi*) {
  mp_mythic_chart_free(s->ch_energy);
  mp_mythic_chart_free(s->ch_msgs);
  mp_mythic_chart_free(s->ch_reqs);
  mp_mythic_chart_free(s->ch_lat);
  mp_mythic_chart_free(s->ch_faults);
  mp_live_free(s->lv_energy);
  mp_live_free(s->lv_msgs);
  mp_live_free(s->lv_reqs);
  mp_live_free(s->lv_lat);
  mp_live_free(s->lv_faults);
  free((rawptr)s);
}

// Events per second between the sample `back` samples ago and now.
fn sim_rate(hist: int64*, hist_t: int64*, n: int64, now: int64, count: int64) -> int64 {
  var j: int64 = n - RATE_LOOKBACK;
  if (j < 0) {
    j = 0;
  }
  var dt: int64 = now - hist_t[j % HISTORY];
  if (dt <= 0) {
    return 0;
  }
  return (count - hist[j % HISTORY]) * 1000 / dt;
}

// The latency in microseconds under which q permille of the requests in
// h[0..24] finished, as the middle of the log2 bucket it falls in. 0 when h
// is empty.
fn sim_percentile(h: int64*, q: int64) -> int64 {
  var total: int64 = 0;
  for b: int64 in 0..SIM_LAT_BUCKETS {
    total = total + h[b];
  }
  if (total <= 0) {
    return 0;
  }
  var want: int64 = (total * q + 999) / 1000;   // rounded up: the want'th request
  var seen: int64 = 0;
  for b: int64 in 0..SIM_LAT_BUCKETS {
    seen = seen + h[b];
    if (seen >= want) {
      return ((int64)3 << b) / 2;
    }
  }
  return 0;
}

// Reads the counters and pushes a sample into every chart, every SAMPLE_MS.
// Runs on pass 0 only: the frame callback can run up to three times.
fn sim_sample(ui: MythicUi*, s: SimUi*) {
  if (ui->pass != 0) {
    return;
  }
  var now: int64 = alph_now_ms();
  if (s->t0 == 0) {
    s->t0 = now;
    s->last_sample = now - SAMPLE_MS;
  }
  if (now - s->last_sample < SAMPLE_MS) {
    return;
  }
  s->last_sample = now;
  var total: int64 = 0;
  for i: int64 in 0..SIM_CELLS {
    total = total + alph_atomic_load(&sim_energy[i]);
  }
  var msgs: int64 = alph_atomic_load(&sim_msgs);
  var crashes: int64 = alph_atomic_load(&sim_crashes);
  var restarts: int64 = alph_atomic_load(&sim_restarts);
  var ok: int64 = alph_atomic_load(&sim_req_ok);
  var failed: int64 = alph_atomic_load(&sim_req_failed);
  var timeouts: int64 = alph_atomic_load(&sim_req_timeout);
  var n: int64 = s->samples;
  // Latency over the last RATE_LOOKBACK samples: the bucket counts now minus
  // the counts then.
  var j: int64 = n - RATE_LOOKBACK;
  if (j < 0) {
    j = 0;
  }
  var lat: int64[24];
  var lat_n: int64 = 0;
  for b: int64 in 0..SIM_LAT_BUCKETS {
    lat[b] = alph_atomic_load(&sim_lat[b]) - s->hist_lat[(j % HISTORY) * SIM_LAT_BUCKETS + b];
    lat_n = lat_n + lat[b];
  }
  s->msgs_rate = sim_rate(&s->hist_msgs[0], &s->hist_t[0], n, now, msgs);
  s->crash_rate = sim_rate(&s->hist_crashes[0], &s->hist_t[0], n, now, crashes);
  s->restart_rate = sim_rate(&s->hist_restarts[0], &s->hist_t[0], n, now, restarts);
  var ok_rate: int64 = sim_rate(&s->hist_ok[0], &s->hist_t[0], n, now, ok);
  var failed_rate: int64 = sim_rate(&s->hist_failed[0], &s->hist_t[0], n, now, failed);
  var timeout_rate: int64 = sim_rate(&s->hist_timeout[0], &s->hist_t[0], n, now, timeouts);
  for b: int64 in 0..SIM_LAT_BUCKETS {
    s->hist_lat[(n % HISTORY) * SIM_LAT_BUCKETS + b] = alph_atomic_load(&sim_lat[b]);
  }
  s->hist_t[n % HISTORY] = now;
  s->hist_ok[n % HISTORY] = ok;
  s->hist_failed[n % HISTORY] = failed;
  s->hist_timeout[n % HISTORY] = timeouts;
  s->hist_msgs[n % HISTORY] = msgs;
  s->hist_crashes[n % HISTORY] = crashes;
  s->hist_restarts[n % HISTORY] = restarts;
  s->samples = n + 1;
  var stats: AlphStats;
  alph_node_stats(&sim_node, &stats);
  s->total = total;
  s->live_actors = stats.live;
  var x: float64 = (float64)(now - s->t0) / 1000.0;
  mp_live_push(s->lv_energy, 0, x, (float64)total / (float64)SIM_ONE);
  mp_live_push(s->lv_msgs, 0, x, (float64)s->msgs_rate);
  mp_live_push(s->lv_faults, 0, x, (float64)s->crash_rate);
  mp_live_push(s->lv_faults, 1, x, (float64)s->restart_rate);
  mp_live_push(s->lv_reqs, 0, x, (float64)ok_rate);
  mp_live_push(s->lv_reqs, 1, x, (float64)failed_rate);
  mp_live_push(s->lv_reqs, 2, x, (float64)timeout_rate);
  // No answers in the interval means no latency to plot: leave a gap.
  if (lat_n > 0) {
    s->p50_us = sim_percentile(&lat[0], 500);
    s->p99_us = sim_percentile(&lat[0], 990);
    mp_live_push(s->lv_lat, 0, x, (float64)s->p50_us);
    mp_live_push(s->lv_lat, 1, x, (float64)s->p99_us);
  }
}

// ---------------------------------------------------------------- heatmap

// Energy as a color, from dark (empty) through blue and teal to yellow (full).
fn sim_heat(permille: int64) -> uint32 {
  var f: int64 = permille;
  if (f < 0) {
    f = 0;
  }
  if (f > 1000) {
    f = 1000;
  }
  var stops: uint32[5] = [0xFF0A0E26, 0xFF22478F, 0xFF1A9A8E, 0xFF7ACB4F, 0xFFF7E94B];
  var seg: int64 = f / 250;
  if (seg > 3) {
    seg = 3;
  }
  var t: float32 = (float32)(f - seg * 250) / 250.0;
  return mythic_color_lerp(stops[seg], stops[seg + 1], t);
}

fn sim_grid_paint_cb(ui: MythicUi*, p: MythicPainter*, r: MythicRect, ud: rawptr) {
  var now: int64 = alph_now_ms();
  var side: float32 = mythic_minf(r.w / (float32)SIM_W, r.h / (float32)SIM_H);
  side = mythic_floorf(side);
  if (side < 2.0) {
    return;
  }
  var x0: float32 = r.x + mythic_floorf((r.w - side * (float32)SIM_W) / 2.0);
  var y0: float32 = r.y + mythic_floorf((r.h - side * (float32)SIM_H) / 2.0);
  var gap: float32 = 1.0;
  var radius: MythicCorners = mythic_radius(2.0);
  var flash: uint32 = 0xFFFF3B30;
  for i: int64 in 0..SIM_CELLS {
    var e: int64 = alph_atomic_load(&sim_energy[i]);
    var c: uint32 = sim_heat(e * 1000 / SIM_ONE);
    var born: int64 = alph_atomic_load(&sim_born[i]);
    if (born > 0) {
      var age: int64 = now - born;
      if (age >= 0 && age < FLASH_MS) {
        c = mythic_color_lerp(c, flash, (float32)(FLASH_MS - age) / (float32)FLASH_MS);
      }
    }
    var cell: MythicRect = {
      x: x0 + (float32)(i % SIM_W) * side,
      y: y0 + (float32)(i / SIM_W) * side,
      w: side - gap,
      h: side - gap
    };
    mythic_paint_fill(p, cell, radius, c);
  }
}

fn sim_legend_paint_cb(ui: MythicUi*, p: MythicPainter*, r: MythicRect, ud: rawptr) {
  var steps: int64 = 48;
  var w: float32 = r.w / (float32)steps;
  for i: int64 in 0..steps {
    var band: MythicRect = { x: r.x + (float32)i * w, y: r.y, w: w + 1.0, h: r.h };
    mythic_paint_fill(p, band, mythic_radius(0.0), sim_heat(i * 1000 / (steps - 1)));
  }
}

// ---------------------------------------------------------------- layout

fn sim_header(ui: MythicUi*) {
  mythic_row_begin(ui, { width: mythic_grow(), align_y: MYTHIC_ALIGN_CENTER, gap: 16 });
    mythic_column_begin(ui, { gap: 2 });
      mythic_label_ex(ui, "alph: a live world of actors", { role: MYTHIC_TYPE_HEADING });
      mythic_label_ex(ui, "640 supervised cells pass energy and answer requests. Nothing crashes until you raise the chaos rate",
                      { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    mythic_end(ui);
  mythic_end(ui);
}

fn sim_world_card(ui: MythicUi*, s: SimUi*) {
  mythic_card_begin_ex(ui, { width: mythic_grow(), height: mythic_grow(), pad: mythic_pad(16), gap: 10 }, { elevation: 1 });
    mythic_label_ex(ui, "World", { role: MYTHIC_TYPE_TITLE });
    mythic_box_begin(ui, { width: mythic_grow(), height: mythic_grow(), clip: true });
    mythic_end(ui);
    mythic_node_paint(ui, &sim_grid_paint_cb, (rawptr)s);
    mythic_row_begin(ui, { width: mythic_grow(), align_y: MYTHIC_ALIGN_CENTER, gap: 8 });
      mythic_label_ex(ui, "empty", { role: MYTHIC_TYPE_CAPTION, tone: MYTHIC_TONE_SECONDARY });
      mythic_box_begin(ui, { width: mythic_grow(), height: mythic_fixed(10), clip: true });
      mythic_end(ui);
      mythic_node_paint(ui, &sim_legend_paint_cb, (rawptr)s);
      mythic_label_ex(ui, "full", { role: MYTHIC_TYPE_CAPTION, tone: MYTHIC_TONE_SECONDARY });
      mythic_label_ex(ui, "red: just restarted", { role: MYTHIC_TYPE_CAPTION, tone: MYTHIC_TONE_DANGER });
    mythic_end(ui);
  mythic_end(ui);
}

fn sim_stat(ui: MythicUi*, name: string, value: int64) {
  mythic_column_begin(ui, { gap: 2 });
    mythic_label_ex(ui, name, { role: MYTHIC_TYPE_CAPTION, tone: MYTHIC_TONE_SECONDARY });
    mythic_label_ex(ui, "{value}", { role: MYTHIC_TYPE_BODY_STRONG });
  mythic_end(ui);
}

fn sim_controls(ui: MythicUi*, s: SimUi*) {
  mythic_card_begin_ex(ui, { width: mythic_grow(), pad: mythic_pad(16), gap: 12 }, { elevation: 1 });
    mythic_label_ex(ui, "Controls", { role: MYTHIC_TYPE_TITLE });
    var rate: int64 = (int64)(s->rate + 0.5);
    mythic_label_ex(ui, "Chaos rate: {rate} crashes per second (0 = no crashes)", { role: MYTHIC_TYPE_LABEL });
    mythic_slider_ex(ui, "##chaos", &s->rate, { min: 0.0, max: 200.0, step: 1.0, width: mythic_grow() });
    var req: int64 = (int64)(s->req + 0.5);
    mythic_label_ex(ui, "Request rate: {req} requests per second (0 = none)", { role: MYTHIC_TYPE_LABEL });
    mythic_slider_ex(ui, "##requests", &s->req, { min: 0.0, max: (float32)SIM_MAX_REQ_RATE, step: 500.0, width: mythic_grow() });
    mythic_row_begin(ui, { width: mythic_grow(), align_y: MYTHIC_ALIGN_CENTER, gap: 16 });
      mythic_switch(ui, "Pause world", &s->paused);
      mythic_spacer(ui);
      var storm: bool = mythic_button_ex(ui, "Crash storm", { variant: MYTHIC_BTN_DANGER });
      mythic_tooltip(ui, "Crash 100 cells at once (ignored while paused)");
      if (storm && ui->pass == 0 && !s->paused) {
        sim_storm();
      }
    mythic_end(ui);
    // Talk to the actors on pass 0 only, and only when something changed.
    if (ui->pass == 0) {
      if (rate != s->rate_sent) {
        s->rate_sent = rate;
        sim_set_rate(rate);
      }
      if (req != s->req_sent) {
        s->req_sent = req;
        sim_set_requests(req);
      }
      if (s->paused != s->paused_sent) {
        s->paused_sent = s->paused;
        sim_set_paused(s->paused);
      }
    }
    mythic_separator(ui);
    mythic_row_begin(ui, { width: mythic_grow(), gap: 20 });
      sim_stat(ui, "Neighbour msgs", alph_atomic_load(&sim_msgs));
      sim_stat(ui, "Crashes", alph_atomic_load(&sim_crashes));
      sim_stat(ui, "Restarts", alph_atomic_load(&sim_restarts));
      sim_stat(ui, "Live actors", s->live_actors);
    mythic_end(ui);
    mythic_row_begin(ui, { width: mythic_grow(), gap: 20 });
      sim_stat(ui, "Requests answered", alph_atomic_load(&sim_req_ok));
      sim_stat(ui, "Failed", alph_atomic_load(&sim_req_failed));
      sim_stat(ui, "Timed out", alph_atomic_load(&sim_req_timeout));
    mythic_end(ui);
  mythic_end(ui);
}

fn sim_chart_card(ui: MythicUi*, st: MpMythicChart*, lv: MpLive*) {
  mythic_card_begin(ui, { width: mythic_grow(), height: mythic_grow(), pad: mythic_pad(4) });
    mp_mythic_live(ui, st, lv, mythic_grow(), mythic_grow());
  mythic_end(ui);
}

fn sim_frame(ui: MythicUi*, ud: rawptr) {
  var s: SimUi* = (SimUi*)ud;
  sim_sample(ui, s);
  mythic_request_frame_in(ui, 16);
  mythic_column_begin(ui, { width: mythic_grow(), height: mythic_grow(), pad: mythic_pad(20), gap: 14 });
    sim_header(ui);
    mythic_row_begin(ui, { width: mythic_grow(), height: mythic_grow(), gap: 16 });
      mythic_column_begin(ui, { width: mythic_grow_w(1.0), height: mythic_grow(), gap: 16 });
        sim_world_card(ui, s);
        sim_controls(ui, s);
      mythic_end(ui);
      mythic_column_begin(ui, { width: mythic_fixed(540), height: mythic_grow(), gap: 10 });
        sim_chart_card(ui, s->ch_energy, s->lv_energy);
        sim_chart_card(ui, s->ch_msgs, s->lv_msgs);
        sim_chart_card(ui, s->ch_reqs, s->lv_reqs);
        sim_chart_card(ui, s->ch_lat, s->lv_lat);
        sim_chart_card(ui, s->ch_faults, s->lv_faults);
      mythic_end(ui);
    mythic_end(ui);
  mythic_end(ui);
}

// ---------------------------------------------------------------- main

fn sim_counts_line() {
  var msgs: int64 = alph_atomic_load(&sim_msgs);
  var crashes: int64 = alph_atomic_load(&sim_crashes);
  var restarts: int64 = alph_atomic_load(&sim_restarts);
  var started: int64 = alph_atomic_load(&sim_cells_started);
  var supr: int64 = alph_atomic_load(&sim_sup_restarts);
  var ok: int64 = alph_atomic_load(&sim_req_ok);
  var failed: int64 = alph_atomic_load(&sim_req_failed);
  var full: int64 = alph_atomic_load(&sim_req_full);
  var timeouts: int64 = alph_atomic_load(&sim_req_timeout);
  var lat: int64[24];
  for b: int64 in 0..SIM_LAT_BUCKETS {
    lat[b] = alph_atomic_load(&sim_lat[b]);
  }
  var p50: int64 = sim_percentile(&lat[0], 500);
  var p99: int64 = sim_percentile(&lat[0], 990);
  println("cells={SIM_CELLS} messages={msgs} crashes={crashes} restarts={restarts} cell_starts={started} supervisor_restarts={supr} requests_answered={ok} requests_failed={failed} (full={full}) requests_timed_out={timeouts} p50_us={p50} p99_us={p99}");
}

// Runs the world and the UI on the headless platform for `seconds` of real
// time, then writes the last frame to `path`.
fn sim_snapshot(s: SimUi*, path: string, seconds: int64, storm: bool) -> int32 {
  var app: MythicApp* = mythic_app_create_headless({ title: "alph sim", width: WINDOW_W, height: WINDOW_H }, 1.0);
  if (app == 0) {
    println("could not create the headless app");
    return 1;
  }
  var plat: MythicPlatform* = mythic_app_platform(app);
  var start: int64 = alph_now_ms();
  var end: int64 = start + seconds * 1000;
  var last: int64 = start;
  var stormed: bool = !storm;
  while (true) {
    var now: int64 = alph_now_ms();
    if (now >= end) {
      break;
    }
    if (!stormed && now - start >= seconds * 500) {
      stormed = true;
      sim_storm();
    }
    time_sleep_ms(16);
    // The headless clock is virtual: move it by the real time that passed.
    var after: int64 = alph_now_ms();
    mythic_headless_advance_us(plat, (after - last) * 1000);
    last = after;
    mythic_app_step(app, &sim_frame, (rawptr)s, false);
  }
  var ok: bool = mythic_app_save_png(app, path);
  // Stop the load and let the requests in flight end, so the counts line
  // covers the run and no request is still pending.
  sim_set_requests(0);
  time_sleep_ms(SIM_REQ_TIMEOUT_MS + 100);
  var frames: int64 = mythic_app_frames(app);
  mythic_app_destroy(app);
  if (!ok) {
    println("could not write {path}");
    return 1;
  }
  println("wrote {path} after {frames} frames");
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var snapshot: string = "";
  var seconds: int64 = 3;
  var storm: bool = false;
  var rate: int64 = SIM_DEFAULT_RATE;
  var requests: int64 = 0;
  var keep_stderr: bool = false;
  var i: int32 = 1;
  while (i < argc) {
    var a: string = str_from_cstr(argv[(int64)i]);
    if (a == "--snapshot" && i + 1 < argc) {
      snapshot = str_from_cstr(argv[(int64)(i + 1)]);
      i = i + 1;
    } else if (a == "--seconds" && i + 1 < argc) {
      seconds = (int64)atoi(argv[(int64)(i + 1)]);
      i = i + 1;
    } else if (a == "--rate" && i + 1 < argc) {
      rate = (int64)atoi(argv[(int64)(i + 1)]);
      i = i + 1;
    } else if (a == "--requests" && i + 1 < argc) {
      requests = (int64)atoi(argv[(int64)(i + 1)]);
      i = i + 1;
    } else if (a == "--storm") {
      storm = true;
    } else if (a == "--stderr") {
      keep_stderr = true;
    } else {
      println("usage: sim [--rate N] [--requests N] [--stderr] [--snapshot out.png [--seconds N] [--storm]]");
      return 2;
    }
    i = i + 1;
  }
  if (!keep_stderr) {
    var null_fd: int64 = syscall(ALPH_SYS_OPEN, (int64)"/dev/null".chars, 1, 0);   // O_WRONLY
    if (null_fd >= 0) {
      syscall(ALPH_SYS_DUP2, null_fd, 2);
    }
  }
  if (rate < 0) {
    rate = 0;
  }
  if (rate > 200) {
    rate = 200;
  }
  if (requests < 0) {
    requests = 0;
  }
  if (requests > SIM_MAX_REQ_RATE) {
    requests = SIM_MAX_REQ_RATE;
  }
  if (!sim_start(0, rate, requests)) {
    println("could not start the alph node");
    return 1;
  }
  var s: SimUi* = sim_ui_new(rate, requests);
  var rc: int32 = 0;
  if (snapshot.length > (uint64)0) {
    rc = sim_snapshot(s, snapshot, seconds, storm);
  } else {
    rc = mythic_run({ title: "alph sim", width: WINDOW_W, height: WINDOW_H }, &sim_frame, (rawptr)s);
    if (rc != 0) {
      println("could not open the window (is DISPLAY set, and is an X server running?)");
    }
  }
  sim_stop();
  sim_counts_line();
  sim_ui_free(s);
  return rc;
}
