// ring: R actors in a ring, one token travels the ring T times (R * T hops).
// Timing starts when the token is sent to the first actor, after the ring
// is built, and stops when that actor has the token back for the last time.
// Metrics: hops_per_s, ns_per_hop. See bench/README.md.

import "std/io";
import "alph/alph";

const R: int64 = 10000;      // actors in the ring
const T: int64 = 100;        // laps
const HOPS: int64 = 1000000; // R * T

const TAG_LINK: int64 = ALPH_TAG_USER;       // arg = pid of the next actor
const TAG_LINKED: int64 = ALPH_TAG_USER + 1; // the last actor to the boss
const TAG_TOKEN: int64 = ALPH_TAG_USER + 2;  // arg = hops so far
const TAG_DONE: int64 = ALPH_TAG_USER + 3;   // arg = laps seen, to the boss

// The state of one ring member.
struct Member {
  next: int64;
  head: bool;   // the first member: it counts laps and ends the run
  boss: int64;
  laps: int64;
}

struct Boss {
  first: int64;
}

var g_node: AlphNode;
var g_start_ns: int64 = 0;
var g_end_ns: int64 = 0;

fn fail(ctx: AlphCtx*, why: string) {
  println("FAIL {why}");
  alph_halt(ctx, 1);
}

fn member(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var s: Member* = (Member*)ctx->state;
  if (m->tag == TAG_LINK) {
    s->next = m->arg;
    alph_send(ctx, s->boss, TAG_LINKED, 0);
    return ALPH_CONTINUE;
  }
  if (m->tag != TAG_TOKEN) {
    return ALPH_CONTINUE;
  }
  var hops: int64 = m->arg;
  if (s->head) {
    if (hops == HOPS) {
      alph_send(ctx, s->boss, TAG_DONE, s->laps);
      return ALPH_CONTINUE;
    }
    s->laps = s->laps + 1;
  }
  if (alph_send(ctx, s->next, TAG_TOKEN, hops + 1) != ALPH_SENT) {
    fail(ctx, "token send was refused");
  }
  return ALPH_CONTINUE;
}

// Builds the ring back to front: each member is spawned already knowing the
// next one. The first member spawned, the tail, is pointed at the head last.
fn boss(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var b: Boss* = (Boss*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    var tail: int64 = 0;
    var next: int64 = 0;
    for i: int64 in 0..R {
      var s: Member;
      s.next = next;
      s.head = (i == R - 1);
      s.boss = ctx->self;
      s.laps = 0;
      next = alph_spawn_value<Member>(ctx, 0, &s, &member);
      if (next == 0) {
        fail(ctx, "spawn failed");
        return ALPH_CONTINUE;
      }
      if (i == 0) {
        tail = next;
      }
    }
    b->first = next;
    alph_send(ctx, tail, TAG_LINK, b->first);
    return ALPH_CONTINUE;
  }
  if (m->tag == TAG_LINKED) {
    g_start_ns = alph_now_ns();
    alph_send(ctx, b->first, TAG_TOKEN, 0);
    return ALPH_CONTINUE;
  }
  if (m->tag == TAG_DONE) {
    g_end_ns = alph_now_ns();
    if (m->arg != T) {
      println("FAIL the token made {m->arg} laps, wanted {T}");
      alph_halt(ctx, 1);
      return ALPH_CONTINUE;
    }
    alph_halt(ctx, 0);
  }
  return ALPH_CONTINUE;
}

fn main() -> int32 {
  var cfg: AlphConfig;
  alph_config(&cfg);
  cfg.max_actors = R + 16;
  if (!alph_node_start(&g_node, &cfg)) {
    println("FAIL node did not start");
    return 1;
  }
  var b: Boss;
  b.first = 0;
  alph_node_spawn_value<Boss>(&g_node, 0, &b, &boss);
  var code: int64 = alph_node_wait(&g_node);
  if (code != 0) {
    return 1;
  }
  var elapsed: int64 = g_end_ns - g_start_ns;
  var per_s: int64 = HOPS * 1000000000 / elapsed;
  var ns_per: int64 = elapsed / HOPS;
  println("RESULT ring hops_per_s={per_s} ns_per_hop={ns_per}");
  return 0;
}
