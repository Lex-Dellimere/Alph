// pairs: S independent sender/receiver pairs, each sender sending M messages
// to its receiver with a credit window of WINDOW (the receiver acks every
// WINDOW messages). All pairs run at once. Timing starts when the senders
// are told to go and stops when the last receiver has all its messages.
// Metric: msgs_per_s (S * M over the elapsed time). See bench/README.md.
//
// A sender keeps at most WINDOW messages unacknowledged, which is below the
// mailbox size (64), so a send is never refused.

import "std/io";
import "alph/sys/atomic";
import "alph/alph";

const S: int64 = 1000;     // pairs
const M: int64 = 1000;     // messages per pair
const WINDOW: int64 = 32;  // credit window; the receiver acks every WINDOW

const TAG_GO: int64 = ALPH_TAG_USER;        // main to a sender
const TAG_DATA: int64 = ALPH_TAG_USER + 1;  // sender to receiver
const TAG_ACK: int64 = ALPH_TAG_USER + 2;   // receiver to sender; arg = messages acked so far

struct Sender {
  receiver: int64;
  sent: int64;
  acked: int64;
}

struct Receiver {
  got: int64;
}

var g_node: AlphNode;
var g_start_ns: int64 = 0;
var g_end_ns: int64 = 0;
var g_finished: int64 = 0;   // receivers that have all their messages

fn fail(ctx: AlphCtx*, why: string) {
  println("FAIL {why}");
  alph_halt(ctx, 1);
}

fn sender(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var s: Sender* = (Sender*)ctx->state;
  if (m->tag == TAG_ACK) {
    s->acked = m->arg;
  } else if (m->tag != TAG_GO) {
    return ALPH_CONTINUE;
  }
  while (s->sent < M && s->sent - s->acked < WINDOW) {
    if (alph_send(ctx, s->receiver, TAG_DATA, s->sent) != ALPH_SENT) {
      fail(ctx, "send was refused");
      return ALPH_CONTINUE;
    }
    s->sent = s->sent + 1;
  }
  if (s->sent == M) {
    return alph_stop(ctx, ALPH_NORMAL);
  }
  return ALPH_CONTINUE;
}

fn receiver(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var r: Receiver* = (Receiver*)ctx->state;
  if (m->tag != TAG_DATA) {
    return ALPH_CONTINUE;
  }
  if (m->arg != r->got) {
    fail(ctx, "a message arrived out of order");
    return ALPH_CONTINUE;
  }
  r->got = r->got + 1;
  if (r->got % WINDOW == 0) {
    var a: int64 = alph_send(ctx, m->from, TAG_ACK, r->got);
    if (a != ALPH_SENT && a != ALPH_GONE) {
      fail(ctx, "ack was refused");
      return ALPH_CONTINUE;
    }
  }
  if (r->got == M) {
    if (alph_atomic_add(&g_finished, 1) + 1 == S) {
      g_end_ns = alph_now_ns();
      alph_halt(ctx, 0);
    }
    return alph_stop(ctx, ALPH_NORMAL);
  }
  return ALPH_CONTINUE;
}

fn main() -> int32 {
  var cfg: AlphConfig;
  alph_config(&cfg);
  cfg.max_actors = 2 * S + 16;
  cfg.mailbox_size = 64;
  if (!alph_node_start(&g_node, &cfg)) {
    println("FAIL node did not start");
    return 1;
  }
  var receivers: int64[1000];
  var senders: int64[1000];
  for i: int64 in 0..S {
    var r: Receiver;
    r.got = 0;
    receivers[i] = alph_node_spawn_value<Receiver>(&g_node, 0, &r, &receiver);
  }
  for i: int64 in 0..S {
    var s: Sender;
    s.receiver = receivers[i];
    s.sent = 0;
    s.acked = 0;
    senders[i] = alph_node_spawn_value<Sender>(&g_node, 0, &s, &sender);
  }
  g_start_ns = alph_now_ns();
  for i: int64 in 0..S {
    alph_node_send(&g_node, senders[i], TAG_GO, 0);
  }
  var code: int64 = alph_node_wait(&g_node);
  if (code != 0) {
    return 1;
  }
  var total: int64 = S * M;
  var elapsed: int64 = g_end_ns - g_start_ns;
  var per_s: int64 = total * 1000000000 / elapsed;
  println("RESULT pairs msgs_per_s={per_s}");
  return 0;
}
