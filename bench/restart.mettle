// restart: a one-for-one supervisor with one permanent child. The child
// crashes (divide by zero) when told to, the supervisor restarts it, and the
// new child reports from INIT. Repeated C times, one at a time. Each cycle is
// timed from just before the crash request is sent to the moment the new
// child's report is handled. Metrics: restart_p50_us, restart_p99_us.
// See bench/README.md.
//
// Restart intensity: a supervisor gives up after more than max_restarts
// (at most 63) restarts within period_ms, and the intensity cannot be set
// higher than that. A window of 0 ms holds no restart, so with period_ms = 0
// the limit never trips, however fast the cycles run. (A 1 ms window would
// trip as soon as a cycle took under about 16 microseconds.)

import "std/io";
import "alph/alph";

const C: int64 = 2000;   // restarts

const TAG_HELLO: int64 = ALPH_TAG_USER;      // child to boss, from INIT
const TAG_CRASH: int64 = ALPH_TAG_USER + 1;  // boss to child; arg is the divisor

struct Child {
  boss: int64;
  quotient: int64;
}

struct Boss {
  child: int64;     // pid of the current child
  started: int64;   // children reported so far, the first start included
  sent_ns: int64;   // when the crash request in flight was sent
}

var g_node: AlphNode;
var g_ns: int64[2000];   // C samples, written by the boss only

fn child(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var c: Child* = (Child*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    if (alph_send(ctx, c->boss, TAG_HELLO, 0) != ALPH_SENT) {
      println("FAIL the report was refused");
      alph_halt(ctx, 1);
    }
  } else if (m->tag == TAG_CRASH) {
    c->quotient = 100 / m->arg;   // arg is 0: a divide by zero ends this actor
  }
  return ALPH_CONTINUE;
}

fn crash_child(ctx: AlphCtx*, b: Boss*) {
  b->sent_ns = alph_now_ns();
  if (alph_send(ctx, b->child, TAG_CRASH, 0) != ALPH_SENT) {
    println("FAIL the crash request was refused");
    alph_halt(ctx, 1);
  }
}

fn boss(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var b: Boss* = (Boss*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);
    var c: Child;
    c.boss = ctx->self;
    c.quotient = 0;
    var spec: AlphSupSpec;
    alph_sup_init(&spec, ALPH_ONE_FOR_ONE);
    spec.max_restarts = 63;
    spec.period_ms = 0;
    alph_sup_add_value<Child>(&spec, &c, &child);
    if (alph_spawn_sup(ctx, &spec) == 0) {
      println("FAIL the supervisor did not start");
      alph_halt(ctx, 1);
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_EXIT) {
    println("FAIL the supervisor exited with reason {m->arg}");
    alph_halt(ctx, 1);
    return ALPH_CONTINUE;
  }
  if (m->tag != TAG_HELLO) {
    return ALPH_CONTINUE;
  }
  var now: int64 = alph_now_ns();
  if (b->started > 0) {
    if (m->from == b->child) {
      println("FAIL the restarted child has the old pid");
      alph_halt(ctx, 1);
      return ALPH_CONTINUE;
    }
    g_ns[b->started - 1] = now - b->sent_ns;
  }
  b->child = m->from;
  b->started = b->started + 1;
  if (b->started == C + 1) {
    alph_halt(ctx, 0);
    return ALPH_CONTINUE;
  }
  crash_child(ctx, b);
  return ALPH_CONTINUE;
}

// Heap sort of a[0..n), in place.
fn sift_down(a: int64*, start: int64, end: int64) {
  var root: int64 = start;
  while (true) {
    var child: int64 = 2 * root + 1;
    if (child >= end) {
      return;
    }
    if (child + 1 < end && a[child] < a[child + 1]) {
      child = child + 1;
    }
    if (a[root] >= a[child]) {
      return;
    }
    var t: int64 = a[root];
    a[root] = a[child];
    a[child] = t;
    root = child;
  }
}

fn heap_sort(a: int64*, n: int64) {
  var i: int64 = n / 2 - 1;
  while (i >= 0) {
    sift_down(a, i, n);
    i = i - 1;
  }
  var end: int64 = n - 1;
  while (end > 0) {
    var t: int64 = a[0];
    a[0] = a[end];
    a[end] = t;
    sift_down(a, 0, end);
    end = end - 1;
  }
}

fn main() -> int32 {
  var cfg: AlphConfig;
  alph_config(&cfg);
  cfg.max_actors = 64;
  if (!alph_node_start(&g_node, &cfg)) {
    println("FAIL node did not start");
    return 1;
  }
  var b: Boss;
  b.child = 0;
  b.started = 0;
  b.sent_ns = 0;
  alph_node_spawn_value<Boss>(&g_node, 0, &b, &boss);
  var code: int64 = alph_node_wait(&g_node);
  if (code != 0) {
    return 1;
  }
  heap_sort(&g_ns[0], C);
  var p50: int64 = g_ns[C / 2] / 1000;
  var p99: int64 = g_ns[C * 99 / 100] / 1000;
  println("RESULT restart restart_p50_us={p50} restart_p99_us={p99}");
  return 0;
}
