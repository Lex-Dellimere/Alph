// fanin: P producers (P = number of schedulers) each send M one-word
// messages to one consumer. Done when the consumer has P * M. Timing starts
// when the producers are told to go and stops when the consumer has the last
// message. Metric: msgs_per_s. See bench/README.md.
//
// The consumer's mailbox is bounded, so producers respect backpressure with
// a credit window. A producer keeps at most WINDOW messages unacknowledged,
// and the consumer acks every ACK_EVERY messages it takes from a producer.
// The mailbox holds P * WINDOW messages, so a send is not expected to be
// refused; if it is anyway (ALPH_FULL), the producer retries on its next
// turn and nothing is dropped. A producer stops after BURST sends and
// continues on its next turn, so a handler stays short.

import "std/io";
import "alph/alph";

const M: int64 = 200000;      // messages per producer
const WINDOW: int64 = 256;    // unacknowledged messages per producer
const ACK_EVERY: int64 = 128; // the consumer acks every this many from one producer
const BURST: int64 = 128;     // most sends in one turn
const MAX_PRODUCERS: int64 = 256;

const TAG_GO: int64 = ALPH_TAG_USER;        // main to a producer
const TAG_DATA: int64 = ALPH_TAG_USER + 1;  // producer to consumer; arg = producer index
const TAG_ACK: int64 = ALPH_TAG_USER + 2;   // consumer to producer; arg = messages acked so far
const TAG_MORE: int64 = ALPH_TAG_USER + 3;  // producer to itself: send more

struct Consumer {
  producers: int64;
  total: int64;
  per: int64[256];   // messages taken from each producer
}

struct Producer {
  consumer: int64;
  index: int64;
  sent: int64;
  acked: int64;
  more_pending: bool;
}

var g_node: AlphNode;
var g_start_ns: int64 = 0;
var g_end_ns: int64 = 0;

fn fail(ctx: AlphCtx*, why: string) {
  println("FAIL {why}");
  alph_halt(ctx, 1);
}

fn consumer(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var c: Consumer* = (Consumer*)ctx->state;
  if (m->tag != TAG_DATA) {
    return ALPH_CONTINUE;
  }
  var i: int64 = m->arg;
  c->per[i] = c->per[i] + 1;
  c->total = c->total + 1;
  if (c->per[i] % ACK_EVERY == 0) {
    var r: int64 = alph_send(ctx, m->from, TAG_ACK, c->per[i]);
    if (r != ALPH_SENT && r != ALPH_GONE) {
      fail(ctx, "ack was refused");
      return ALPH_CONTINUE;
    }
  }
  if (c->total == c->producers * M) {
    g_end_ns = alph_now_ns();
    for k: int64 in 0..c->producers {
      if (c->per[k] != M) {
        println("FAIL producer {k} delivered {c->per[k]}, wanted {M}");
        alph_halt(ctx, 1);
        return ALPH_CONTINUE;
      }
    }
    alph_halt(ctx, 0);
  }
  return ALPH_CONTINUE;
}

fn producer(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var s: Producer* = (Producer*)ctx->state;
  if (m->tag == TAG_ACK) {
    s->acked = m->arg;
  } else if (m->tag == TAG_MORE) {
    s->more_pending = false;
  } else if (m->tag != TAG_GO) {
    return ALPH_CONTINUE;
  }
  var burst: int64 = 0;
  while (s->sent < M && s->sent - s->acked < WINDOW && burst < BURST) {
    var r: int64 = alph_send(ctx, s->consumer, TAG_DATA, s->index);
    if (r == ALPH_SENT) {
      s->sent = s->sent + 1;
      burst = burst + 1;
    } else if (r == ALPH_FULL) {
      burst = BURST;   // retry next turn
    } else {
      fail(ctx, "send failed");
      return ALPH_CONTINUE;
    }
  }
  if (s->sent == M) {
    return alph_stop(ctx, ALPH_NORMAL);
  }
  // Out of credit: the next ack continues. Otherwise carry on next turn.
  if (s->sent - s->acked < WINDOW && !s->more_pending) {
    s->more_pending = true;
    alph_send(ctx, ctx->self, TAG_MORE, 0);
  }
  return ALPH_CONTINUE;
}

fn pow2_at_least(n: int64) -> int64 {
  var p: int64 = 1;
  while (p < n) {
    p = p * 2;
  }
  return p;
}

fn main() -> int32 {
  var cfg: AlphConfig;
  alph_config(&cfg);
  var p: int64 = cfg.schedulers;
  if (p > MAX_PRODUCERS) {
    println("FAIL {p} schedulers, at most {MAX_PRODUCERS} supported");
    return 1;
  }
  cfg.max_actors = 512;
  cfg.mailbox_size = pow2_at_least(p * WINDOW);
  if (!alph_node_start(&g_node, &cfg)) {
    println("FAIL node did not start");
    return 1;
  }
  var c: Consumer;
  memset((rawptr)&c, 0, (int64)sizeof(Consumer));
  c.producers = p;
  var cpid: int64 = alph_node_spawn_value<Consumer>(&g_node, 0, &c, &consumer);
  var pids: int64[256];
  for i: int64 in 0..p {
    var s: Producer;
    s.consumer = cpid;
    s.index = i;
    s.sent = 0;
    s.acked = 0;
    s.more_pending = false;
    pids[i] = alph_node_spawn_value<Producer>(&g_node, 0, &s, &producer);
  }
  g_start_ns = alph_now_ns();
  for i: int64 in 0..p {
    alph_node_send(&g_node, pids[i], TAG_GO, 0);
  }
  var code: int64 = alph_node_wait(&g_node);
  if (code != 0) {
    return 1;
  }
  var total: int64 = p * M;
  var elapsed: int64 = g_end_ns - g_start_ns;
  var per_s: int64 = total * 1000000000 / elapsed;
  println("RESULT fanin msgs_per_s={per_s}");
  return 0;
}
