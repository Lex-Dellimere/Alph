// Other programs (the host port's proc, with src/poll): a program is
// started, a message says when it has ended, and its result is its exit
// status, 128 plus the signal that ended it, or 127 when there was no such
// program. Twenty run at once.

import "std/io";
import "port/net";
import "port/proc";
import "alph/actor/actor";
import "alph/poll/poll";

const GO: Word = 1;
const ENDED: Word = 2;
const MANY: Word = 20;

var g_node: AlphNode;
var g_actors: AlphActor[4];
var g_mail: AlphMsg[128];
var g_poll: AlphPoll;
var g_ears: AlphEar[32];
var g_failures: int32 = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

// Starts the commands it is given and notes how each ended.
struct Runner {
  commands: cstring[24];
  count: Word;
  fds: int64[24];
  results: int64[24];
  back: Word;
  early: Word;
}

fn runner(a: AlphActor*, m: AlphMsg*) -> Word {
  var r: Runner* = (Runner*)a->state;
  if (m->tag == GO) {
    for i in 0..r->count {
      r->fds[i] = alph_proc_start(r->commands[i]);
      r->results[i] = -99;
      if (r->fds[i] < 0 || g_poll.want(r->fds[i], ALPH_READ, a->pid, ENDED) != ALPH_OK) {
        r->results[i] = -98;
        r->back = r->back + 1;
      }
    }
  } else {
    for i in 0..r->count {
      if (r->fds[i] == (int64)m->arg) {
        r->results[i] = alph_proc_result(r->fds[i]);
        if (r->results[i] == ALPH_RUNNING) {
          r->early = r->early + 1;
          g_poll.want(r->fds[i], ALPH_READ, a->pid, ENDED);
          return 0;
        }
        g_poll.forget(r->fds[i]);
        alph_close(r->fds[i]);
        r->back = r->back + 1;
      }
    }
  }
  if (r->back == r->count) {
    a->node->stop();
  }
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var r: Runner;
  alph_proc_env(argv + argc + 1);
  g_node.init(&g_actors[0], 4, &g_mail[0], 32);
  expect(g_poll.init(&g_node, &g_ears[0], 32) == ALPH_OK, "the poll starts");
  var pid: Word = g_node.spawn(&runner, (rawptr)&r);

  r.commands[0] = "true";
  r.commands[1] = "exit 3";
  r.commands[2] = "sleep 0.05; exit 7";
  r.commands[3] = "kill -9 $$";
  r.commands[4] = "/no/such/program/anywhere 2>/dev/null";
  r.commands[5] = "test \"$HOME\" != \"\"";
  r.count = 6;
  r.back = 0;
  r.early = 0;
  g_node.send(pid, GO, 0);
  g_node.run();
  expect(r.results[0] == 0, "a program that ends well gives 0 ({r.results[0]})");
  expect(r.results[1] == 3, "its exit status is its result ({r.results[1]})");
  expect(r.results[2] == 7, "also when it took a while ({r.results[2]})");
  expect(r.results[3] == 128 + 9, "one ended by a signal gives 128 plus the signal ({r.results[3]})");
  expect(r.results[4] == 127, "a program that is not there gives 127 ({r.results[4]})");
  expect(r.results[5] == 0, "programs are given the environment this one has ({r.results[5]})");
  expect(r.early == 0, "no message came before its program had ended ({r.early})");

  // Twenty at once, each with its own result.
  var numbered: cstring[20];
  numbered[0] = "exit 0";
  numbered[1] = "exit 1";
  numbered[2] = "exit 2";
  numbered[3] = "exit 3";
  numbered[4] = "exit 4";
  numbered[5] = "exit 5";
  numbered[6] = "exit 6";
  numbered[7] = "exit 7";
  numbered[8] = "exit 8";
  numbered[9] = "exit 9";
  numbered[10] = "exit 10";
  numbered[11] = "exit 11";
  numbered[12] = "exit 12";
  numbered[13] = "exit 13";
  numbered[14] = "exit 14";
  numbered[15] = "exit 15";
  numbered[16] = "exit 16";
  numbered[17] = "exit 17";
  numbered[18] = "exit 18";
  numbered[19] = "exit 19";
  for i in 0..MANY {
    r.commands[i] = numbered[i];
  }
  r.count = MANY;
  r.back = 0;
  g_node.send(pid, GO, 0);
  g_node.run();
  var right: Word = 0;
  for i in 0..MANY {
    if (r.results[i] == (int64)i) {
      right = right + 1;
    }
  }
  expect(right == MANY, "twenty programs at once each give their own result ({right})");

  g_poll.stop();
  if (g_failures != 0) {
    return 1;
  }
  println("proc ok: 26 programs run, each result its own");
  return 0;
}
