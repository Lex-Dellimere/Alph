// A board that stamps its work with its own clock, for
// tests/mcu/clock_host.mettle: its one kind of work gives back what the
// clock read when the job was done.

import "port/board";
import "port/alarm";
import "alph/actor/actor";
import "alph/board/board";

const STAMP: Word = 0;
const QUIT: Word = 3;

var g_board: AlphBoard;

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

fn stamp(n: Word) -> Word {
  return alph_now();
}

fn quitter(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == QUIT) {
    a->node->stop();
  }
  return 0;
}

fn main() -> int32 {
  alph_board_start();
  g_board.init(8, 0, 8);
  g_board.clock = &alph_now;
  g_board.node.spawn(&quitter, 0);
  g_board.share(STAMP, &stamp);
  mettle_irq_enable();
  g_board.run();
  return 0;
}
