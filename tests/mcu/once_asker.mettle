// A board asks another board for work that must be done at most once
// (alph/board/asks), with everything going wrong that can: every third
// answer is thrown away as if the line had lost it, the worker forgets
// what it did in the middle (once_worker.mettle), and this board forgets
// everything once too, as a restart would make it. Every job must end as
// done with the right answer, or as lost. The worker checks that none was
// done twice.

import "port/port";
import "port/board";
import "alph/actor/actor";
import "alph/time/time";
import "alph/board/board";
import "alph/board/asks";

const MOVE: Word = 0;
const TICK: Word = 1;
const JOBS: Word = 32;

var g_board: AlphBoard;
var g_asks: AlphBoardAsks;
var g_time: AlphTime;
var g_timers: AlphTimer[2];

struct Test {
  next: Word;       // the next job's number
  ref: Word[4];     // jobs out: the ref of each, 0 for none,
  number: Word[4];  // and its number
  done: Word;
  lost: Word;
  left: Word;       // jobs out when this board forgot everything
  wrong: Word;
  answers: Word;
  dropped: Word;
  down: Word;       // ticks left of this board's own restart
  restarted: Word;
  idle: Word;
}

var g_test: Test;

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

// Asks for as many of the jobs not yet asked for as can go out.
fn pump(a: AlphActor*, t: Test*) {
  while (t->next < JOBS) {
    var ref: Word = g_asks.ask(a, t->next);
    if (ref < 0) {
      return;
    }
    for i in 0..4 {
      if (t->ref[i] == 0) {
        t->ref[i] = ref;
        t->number[i] = t->next;
        break;
      }
    }
    t->next = t->next + 1;
  }
}

fn asker(a: AlphActor*, m: AlphMsg*) -> Word {
  var t: Test* = (Test*)a->state;
  if (m->tag == TICK) {
    if (t->next >= JOBS && t->done + t->lost + t->left == JOBS) {
      a->node->stop();
      return 0;
    }
    g_time.after(150, a->pid, TICK, 0);
    if (t->down > 0) {
      t->down = t->down - 1;
      return 0;
    }
    g_asks.tick(a);
    pump(a, t);
    return 0;
  }
  if (t->down > 0) {
    return 0;  // restarting: nothing is heard
  }
  if (m->tag == ALPH_WORKED) {
    t->answers = t->answers + 1;
    if (t->answers % 3 == 0) {
      t->dropped = t->dropped + 1;
      return 0;  // as if the line had lost it: the job is sent again
    }
  }
  var ended: Word = g_asks.took(a, m);
  for e in 0..ended {
    var number: Word = -1;
    for i in 0..4 {
      if (t->ref[i] != 0 && t->ref[i] == g_asks.told_ref[e]) {
        number = t->number[i];
        t->ref[i] = 0;
      }
    }
    if (g_asks.told_status[e] == ALPH_OK) {
      t->done = t->done + 1;
      if (number < 0 || g_asks.told_out[e] != number + 1000) {
        t->wrong = t->wrong + 1;
      }
    } else if (g_asks.told_status[e] == ALPH_LOST) {
      t->lost = t->lost + 1;
    } else {
      t->wrong = t->wrong + 1;  // this worker refuses nothing
    }
  }
  if (t->restarted == 0 && t->done >= 8) {
    // This board's own restart: it forgets all, and is away for a while.
    t->restarted = 1;
    t->down = 3;
    for i in 0..4 {
      if (t->ref[i] != 0) {
        t->left = t->left + 1;
        t->ref[i] = 0;
      }
    }
    g_asks.init(&g_board, MOVE);
    return 0;
  }
  pump(a, t);
  return 0;
}

fn main() -> int32 {
  alph_board_start();
  g_board.init(0, 1, 1);
  g_time.init(&g_board.node, &g_timers[0], 2);
  g_asks.init(&g_board, MOVE);
  var me: Word = g_board.node.spawn(&asker, (rawptr)&g_test);
  mettle_irq_enable();
  g_time.after(150, me, TICK, 0);
  g_board.run();
  g_time.stop();
  if (g_test.wrong != 0) {
    return 1;
  }
  if (g_test.lost == 0) {
    return 2;  // the worker forgot everything once: some job must have been lost
  }
  if (g_test.dropped == 0 || g_test.restarted == 0) {
    return 3;
  }
  if (g_test.done < 20) {
    return 4;
  }
  return 0;
}
