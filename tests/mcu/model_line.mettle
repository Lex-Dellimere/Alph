// What the computer says to a board on its serial line, and a check of what
// the board said back, for running examples/mcu/tether.mettle on the
// compiler's model of a Pico 2, which takes a script of serial input and
// prints what the chip's UART sent.
//
//   model_line script 50          the script: 50 questions, then a word to stop
//   model_line check 50 < out     the board's bytes: 50 answers, each the question's number plus one
//
// The frames are made and read here with this file's own code, not the
// tether's, so the two must agree on the bytes.

import "std/io";
import "port/sys";

const END: int64 = 192;
const ESC: int64 = 219;
const PING: int64 = 1;
const PONG: int64 = 2;
const QUIT: int64 = 3;

var g_in: uint8[65536];

// A number seven bits to a byte, the least first, every byte but the last
// with its top bit set. Returns how many bytes.
fn small(out: uint8*, value: int64) -> int64 {
  var v: int64 = value & 4294967295;
  var n: int64 = 0;
  while (v >= 128) {
    out[n] = (uint8)((v & 127) | 128);
    v = v >> 7;
    n = n + 1;
  }
  out[n] = (uint8)v;
  return n + 1;
}

fn sum_of(f: uint8*, count: int64) -> int64 {
  var s: int64 = 0;
  for i in 0..count {
    s = (s + (int64)f[i] * ((int64)i + 1)) & 65535;
  }
  return s;
}

// One line of the script: a message from the computer's actor (place 0,
// generation 1, slot 0) to the board's (place 1, generation 1, slot 0),
// with its escapes and its end.
fn say(tag: int64, arg: int64, ref: int64) {
  var f: uint8[48];
  var n: int64 = small(&f[0], 1);
  n = n + small(&f[n], 1);
  n = n + small(&f[n], 0);
  n = n + small(&f[n], 0);
  n = n + small(&f[n], 1);
  n = n + small(&f[n], 0);
  n = n + small(&f[n], tag * 2);
  n = n + small(&f[n], arg * 2);
  n = n + small(&f[n], ref * 2);
  var s: int64 = sum_of(&f[0], n);
  f[n] = (uint8)(s & 255);
  f[n + 1] = (uint8)(s >> 8);
  print("bytes");
  for i in 0..(n + 2) {
    var b: int64 = (int64)f[i];
    if (b == END) {
      print(" {ESC} 220");
    } else if (b == ESC) {
      print(" {ESC} 221");
    } else {
      print(" {b}");
    }
  }
  println(" {END}");
}

// Reads one number at *at.
fn big(f: uint8*, at: int64*, end: int64) -> int64 {
  var v: int64 = 0;
  var shift: int64 = 0;
  while (*at < end) {
    var b: int64 = (int64)f[*at];
    *at = *at + 1;
    v = v | ((b & 127) << shift);
    shift = shift + 7;
    if (b < 128) {
      return v;
    }
  }
  return -1;
}

fn number(text: cstring) -> int64 {
  var n: int64 = 0;
  var i: int32 = 0;
  while (text[i] >= 48 && text[i] <= 57) {
    n = n * 10 + (int64)(text[i] - 48);
    i = i + 1;
  }
  return n;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 3) {
    println("model_line script N, or model_line check N < the board's bytes");
    return 2;
  }
  var total: int64 = number(argv[2]);
  if (argv[1][0] == 115) {  // s: the script
    println("wait 20");
    for i in 0..total {
      say(PING, (int64)i * 7, (int64)i + 1);
      println("wait 2");
    }
    say(QUIT, 0, 0);
    return 0;
  }
  // The board's bytes: frames between ENDs.
  var have: int64 = 0;
  while (have < 65536) {
    var got: int64 = syscall(ALPH_NR_READ, 0, (int64)&g_in[have], 65536 - have);
    if (got <= 0) {
      break;
    }
    have = have + got;
  }
  var f: uint8[64];
  var n: int64 = 0;
  var escaped: bool = false;
  var answers: int64 = 0;
  var wrong: int64 = 0;
  for i in 0..have {
    var b: int64 = (int64)g_in[i];
    if (b != END) {
      if (escaped) {
        escaped = false;
        if (b == 220) {
          b = END;
        } else {
          b = ESC;
        }
      } else if (b == ESC) {
        escaped = true;
        continue;
      }
      if (n < 64) {
        f[n] = (uint8)b;
      }
      n = n + 1;
      continue;
    }
    if (n == 0) {
      continue;  // an END with nothing before it clears the line
    }
    var end: int64 = n - 2;
    var at: int64 = 0;
    var parts: int64[9];
    var sound: bool = n >= 11 && n <= 47 && (int64)f[end] + (int64)f[end + 1] * 256 == sum_of(&f[0], end);
    for k in 0..9 {
      parts[k] = big(&f[0], &at, end);
    }
    // To the computer's actor, from the board's: tag PONG, arg the
    // question's number plus one, with the question's ref.
    if (!sound || at != end || parts[0] != 0 || parts[1] != 1 || parts[2] != 0 || parts[3] != 1 || parts[4] != 1
        || parts[5] != 0 || parts[6] != PONG * 2 || parts[7] != (answers * 7 + 1) * 2 || parts[8] != (answers + 1) * 2) {
      wrong = wrong + 1;
    }
    answers = answers + 1;
    n = 0;
  }
  println("{answers} answers over the board's UART, {wrong} wrong");
  if (answers != total || wrong != 0) {
    return 1;
  }
  return 0;
}
