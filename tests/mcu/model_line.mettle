// What the computer says to a board on its serial line, and a check of what
// the board said back, for running a board's program on the compiler's
// model of a Pico 2, which takes a script of serial input and prints what
// the chip's UART sent.
//
// For examples/mcu/tether.mettle:
//   model_line script 50          the script: 50 questions, then a word to stop
//   model_line check 50 < out     the board's bytes: 50 answers, each the question's number plus one
//
// For examples/mcu/arm.mettle, a board that shares three kinds of work:
//   model_line arm                the script: who does each kind, six angles, four chunks of
//                                 primes, and moves that must not be made twice
//   model_line armcheck < out     the board's eighteen answers
//
// The frames are made and read here with this file's own code, not the
// tether's, so the two must agree on the bytes.

import "std/io";
import "port/sys";

const END: int64 = 192;
const ESC: int64 = 219;
const PING: int64 = 1;
const PONG: int64 = 2;
const QUIT: int64 = 3;

var g_in: uint8[65536];

// A number seven bits to a byte, the least first, every byte but the last
// with its top bit set. Returns how many bytes.
fn small(out: uint8*, value: int64) -> int64 {
  var v: int64 = value & 4294967295;
  var n: int64 = 0;
  while (v >= 128) {
    out[n] = (uint8)((v & 127) | 128);
    v = v >> 7;
    n = n + 1;
  }
  out[n] = (uint8)v;
  return n + 1;
}

fn sum_of(f: uint8*, count: int64) -> int64 {
  var s: int64 = 0;
  for i in 0..count {
    s = (s + (int64)f[i] * ((int64)i + 1)) & 65535;
  }
  return s;
}

// A number that may be below 0, made small when it is near 0, and back.
fn fold(value: int64) -> int64 {
  if (value < 0) {
    return (-value - 1) * 2 + 1;
  }
  return value * 2;
}

fn unfold(z: int64) -> int64 {
  if ((z & 1) != 0) {
    return -(z >> 1) - 1;
  }
  return z >> 1;
}

// One line of the script: a message with its escapes and its end, to and
// from a pid given as place, generation and slot.
fn tell(to_place: int64, to_slot: int64, from_slot: int64, tag: int64, arg: int64, ref: int64) {
  var f: uint8[48];
  var n: int64 = small(&f[0], to_place);
  n = n + small(&f[n], 1);
  n = n + small(&f[n], to_slot);
  n = n + small(&f[n], 0);
  n = n + small(&f[n], 1);
  n = n + small(&f[n], from_slot);
  n = n + small(&f[n], fold(tag));
  n = n + small(&f[n], fold(arg));
  n = n + small(&f[n], fold(ref));
  var s: int64 = sum_of(&f[0], n);
  f[n] = (uint8)(s & 255);
  f[n + 1] = (uint8)(s >> 8);
  print("bytes");
  for i in 0..(n + 2) {
    var b: int64 = (int64)f[i];
    if (b == END) {
      print(" {ESC} 220");
    } else if (b == ESC) {
      print(" {ESC} 221");
    } else {
      print(" {b}");
    }
  }
  println(" {END}");
}

// A message from the computer's actor (place 0, generation 1, slot 0) to
// the tether example's (place 1, generation 1, slot 0).
fn say(tag: int64, arg: int64, ref: int64) {
  tell(1, 0, 0, tag, arg, ref);
}

// The primes in chunk c of 500 numbers, as the arm example counts them.
fn primes_in(c: int64) -> int64 {
  var n: int64 = c * 500;
  var end: int64 = n + 500;
  var found: int64 = 0;
  while (n < end) {
    var prime: bool = n >= 2;
    var d: int64 = 2;
    while (prime && d * d <= n) {
      if (n % d == 0) {
        prime = false;
      }
      d = d + 1;
    }
    if (prime) {
      found = found + 1;
    }
    n = n + 1;
  }
  return found;
}

const BOARD: int64 = 8;            // the arm example's place
const SHARED: int64 = 1073741824;  // the name of the worker for a kind is this plus the kind
const RUN: int64 = 1073762304;     // a run of refs for work done at most once: 2^30 plus 5 * 4096
const WHERE: int64 = -10;
const HERE: int64 = -11;
const WORK: int64 = -13;
const WORKED: int64 = -14;
const REFUSED: int64 = -18;
const WORK_ONCE: int64 = -21;
const HELLO: int64 = -22;
const LOST: int64 = -8;

// What the board should say next, and whether it did.
var g_at: int64 = 0;
var g_bad: int64 = 0;

fn want(parts: int64*, to_slot: int64, from_slot: int64, tag: int64, arg: int64, ref: int64) {
  if (parts[0] != 0 || parts[1] != 1 || parts[2] != to_slot || parts[3] != BOARD || parts[4] != 1 || parts[5] != from_slot
      || unfold(parts[6]) != tag || unfold(parts[7]) != arg || unfold(parts[8]) != ref) {
    g_bad = g_bad + 1;
    println("answer {g_at}: from slot {parts[5]} to slot {parts[2]}, tag {unfold(parts[6])} arg {unfold(parts[7])} ref {unfold(parts[8])}; wanted from slot {from_slot} to slot {to_slot}, tag {tag} arg {arg} ref {ref}");
  }
}

// The arm example's actors are its door (slot 0), the one that stops it
// (1), and the workers for primes (2), angles (3) and moves (4), in the
// order it makes them. The door is asked first, so a board that numbers
// them otherwise is caught here.
fn arm_answer(parts: int64*) {
  var i: int64 = g_at;
  if (i < 3) {
    want(parts, 5, 2 + i, HERE, 1, i + 1);
  } else if (i < 9) {
    want(parts, 5, 3, WORKED, (i - 3) * 3 + 1, 10 + (i - 3));
  } else if (i < 13) {
    want(parts, 5, 2, WORKED, primes_in(i - 9), 20 + (i - 9));
  } else if (i == 13) {
    want(parts, 5, 4, HELLO, 0, RUN);
  } else if (i == 14) {
    want(parts, 5, 4, WORKED, 10, RUN + 1);
  } else if (i == 15) {
    want(parts, 5, 4, WORKED, 10, RUN + 1);  // sent again: answered from memory, the arm does not move
  } else if (i == 16) {
    want(parts, 5, 4, WORKED, 20, RUN + 2);
  } else if (i == 17) {
    want(parts, 6, 4, REFUSED, LOST, RUN + 1);  // from an asker that never said hello
  }
  g_at = g_at + 1;
}

// Reads one number at *at.
fn big(f: uint8*, at: int64*, end: int64) -> int64 {
  var v: int64 = 0;
  var shift: int64 = 0;
  while (*at < end) {
    var b: int64 = (int64)f[*at];
    *at = *at + 1;
    v = v | ((b & 127) << shift);
    shift = shift + 7;
    if (b < 128) {
      return v;
    }
  }
  return -1;
}

fn number(text: cstring) -> int64 {
  var n: int64 = 0;
  var i: int32 = 0;
  while (text[i] >= 48 && text[i] <= 57) {
    n = n * 10 + (int64)(text[i] - 48);
    i = i + 1;
  }
  return n;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 2) {
    println("model_line script N, check N, arm or armcheck");
    return 2;
  }
  var arm: bool = argv[1][0] == 97;  // a: the arm example
  if (arm && argv[1][3] == 0) {
    println("wait 20");
    for k in 0..3 {
      tell(BOARD, 0, 5, WHERE, SHARED + (int64)k, (int64)k + 1);
      println("wait 3");
    }
    for j in 0..6 {
      tell(BOARD, 3, 5, WORK, (int64)j, 10 + (int64)j);
      println("wait 3");
    }
    for c in 0..4 {
      tell(BOARD, 2, 5, WORK, (int64)c, 20 + (int64)c);
      println("wait 15");
    }
    tell(BOARD, 4, 5, HELLO, 0, RUN);
    println("wait 3");
    tell(BOARD, 4, 5, WORK_ONCE, 10, RUN + 1);
    println("wait 3");
    tell(BOARD, 4, 5, WORK_ONCE, 10, RUN + 1);
    println("wait 3");
    tell(BOARD, 4, 5, WORK_ONCE, 10, RUN + 2);
    println("wait 3");
    tell(BOARD, 4, 6, WORK_ONCE, 10, RUN + 1);
    return 0;
  }
  var total: int64 = 18;
  if (!arm) {
    if (argc < 3) {
      println("model_line script N, check N, arm or armcheck");
      return 2;
    }
    total = number(argv[2]);
  }
  if (argv[1][0] == 115) {  // s: the script
    println("wait 20");
    for i in 0..total {
      say(PING, (int64)i * 7, (int64)i + 1);
      println("wait 2");
    }
    say(QUIT, 0, 0);
    return 0;
  }
  // The board's bytes: frames between ENDs.
  var have: int64 = 0;
  while (have < 65536) {
    var got: int64 = syscall(ALPH_NR_READ, 0, (int64)&g_in[have], 65536 - have);
    if (got <= 0) {
      break;
    }
    have = have + got;
  }
  var f: uint8[64];
  var n: int64 = 0;
  var escaped: bool = false;
  var answers: int64 = 0;
  var wrong: int64 = 0;
  for i in 0..have {
    var b: int64 = (int64)g_in[i];
    if (b != END) {
      if (escaped) {
        escaped = false;
        if (b == 220) {
          b = END;
        } else {
          b = ESC;
        }
      } else if (b == ESC) {
        escaped = true;
        continue;
      }
      if (n < 64) {
        f[n] = (uint8)b;
      }
      n = n + 1;
      continue;
    }
    if (n == 0) {
      continue;  // an END with nothing before it clears the line
    }
    var end: int64 = n - 2;
    var at: int64 = 0;
    var parts: int64[9];
    var sound: bool = n >= 11 && n <= 47 && (int64)f[end] + (int64)f[end + 1] * 256 == sum_of(&f[0], end);
    for k in 0..9 {
      parts[k] = big(&f[0], &at, end);
    }
    if (arm) {
      if (!sound || at != end) {
        wrong = wrong + 1;
      } else {
        arm_answer(&parts[0]);
        wrong = g_bad;
      }
    } else if (!sound || at != end || parts[0] != 0 || parts[1] != 1 || parts[2] != 0 || parts[3] != 1 || parts[4] != 1
        || parts[5] != 0 || parts[6] != PONG * 2 || parts[7] != (answers * 7 + 1) * 2 || parts[8] != (answers + 1) * 2) {
      // To the computer's actor, from the board's: tag PONG, arg the
      // question's number plus one, with the question's ref.
      wrong = wrong + 1;
    }
    answers = answers + 1;
    n = 0;
  }
  println("{answers} answers over the board's UART, {wrong} wrong");
  if (answers != total || wrong != 0) {
    return 1;
  }
  return 0;
}
