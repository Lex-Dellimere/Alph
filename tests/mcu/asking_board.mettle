// A board that asks the computer on its line to count primes, six chunks,
// and checks each answer against its own count, for
// tests/mcu/arm_test.mettle (mode `asks`).

import "port/board";
import "alph/actor/actor";
import "alph/time/time";
import "alph/board/board";
import "../../examples/mcu/arm_work";

const TICK: Word = 1;
const ASKS: Word = 6;

var g_board: AlphBoard;
var g_time: AlphTime;
var g_timers: AlphTimer[2];
var g_next: Word = 0;
var g_first: Word = 0;
var g_answered: Word = 0;
var g_wrong: Word = 0;
var g_ticks: Word = 0;

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

fn asker(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == ALPH_WORKED) {
    if (g_first <= 0 || m->ref < g_first || g_next >= ASKS) {
      return 0;
    }
    if (m->arg != count_primes(g_next + 3)) {
      g_wrong = g_wrong + 1;
    }
    g_next = g_next + 1;
    g_answered = 1;
    g_first = 0;
    if (g_next < ASKS) {
      g_first = g_board.ask(a, PRIMES, g_next + 3);
    }
    return 0;
  }
  if (m->tag != TICK) {
    return 0;
  }
  g_ticks = g_ticks + 1;
  if (g_next >= ASKS || g_ticks > 200) {
    a->node->stop();
    return 0;
  }
  if (g_answered == 0) {
    var ref: Word = g_board.ask(a, PRIMES, g_next + 3);
    if (g_first <= 0) {
      g_first = ref;
    }
  }
  g_answered = 0;
  g_time.after(100, a->pid, TICK, 0);
  return 0;
}

fn main() -> int32 {
  alph_board_start();
  g_board.init(8, 0, 8);
  g_time.init(&g_board.node, &g_timers[0], 2);
  var me: Word = g_board.node.spawn(&asker, 0);
  mettle_irq_enable();
  g_time.after(100, me, TICK, 0);
  g_board.run();
  g_time.stop();
  if (g_next != ASKS || g_wrong != 0) {
    return 1;
  }
  return 0;
}
