// A machine that shares work with a board (tests/mcu/sure_arm_board.mettle,
// in QEMU) over a sure line that loses and damages frames both ways: about a
// frame in four that this side sends is not sent, and one in seven has a
// byte changed. The machine's relay ticks the line. As in
// examples/mcu/arm_host.mettle, the six angles go to the board and the
// primes below 100,000 are shared. Every piece must be answered, and none
// given up on as lost.
//
//   sure_arm <port>

import "std/io";
import "port/sys";
import "std/thread";
import "port/net";
import "port/line";
import "alph/actor/actor";
import "alph/machine/machine";
import "alph/batch/batch";
import "alph/tether/tether";
import "../../examples/mcu/arm_work";

const LATE: Word = 4;
const DONE: Word = 5;
const JOINTS: Word = 6;
const CHUNKS: Word = 200;
const BOARD: Word = 8;

var g_m: AlphMachine;
var g_batch: AlphBatch;
var g_sure: AlphSure;
var g_kept: AlphKept[8];
var g_primes: Word = 0;
var g_angles: Word = 0;
var g_wrong: Word = 0;
var g_late: Word = 0;
var g_on_board: Word = 0;
var g_waited: Word = 0;

fn primes_job(job: AlphJob*) -> Word {
  job->out = count_primes(job->in);
  return 0;
}

fn each(b: AlphBatch*, job: AlphJob*, piece: Word) {
}

fn answered(b: AlphBatch*, job: AlphJob*, piece: Word) {
  if (job->status != ALPH_OK) {
    g_wrong = g_wrong + 1;
  } else if (b->kind == ANGLE) {
    g_angles = g_angles + 1;
    if (job->out != (Word)(piece * 3) + 1 || job->way != ALPH_FAR) {
      g_wrong = g_wrong + 1;
    }
  } else {
    g_primes = g_primes + job->out;
  }
}

fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == LATE) {
    g_late = 1;
    a->cores()->stop();
  } else if (m->tag == DONE) {
    // The word to stop is kept until the board says it has it: wait for
    // that, three seconds at most.
    g_waited = g_waited + 1;
    if (g_sure.held == 0 || g_waited > 60) {
      a->cores()->stop();
    } else {
      g_m.time.after(50, a->pid, DONE, 0);
    }
  } else if (m->tag == ALPH_UP && m->arg == BOARD && g_batch.begun == 0) {
    g_batch.begin(a, ANGLE, JOINTS, &each, &answered, 0);
  } else if (g_batch.took(a, m) && g_batch.over()) {
    if (g_batch.kind == ANGLE) {
      g_batch.begin(a, PRIMES, CHUNKS, &each, &answered, 0);
    } else {
      g_on_board = g_batch.by_way[ALPH_FAR];
      a->send((Word)((BOARD << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS) | 1), QUIT, 0);
      g_m.time.after(50, a->pid, DONE, 0);
    }
  }
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var port: int64 = 0;
  var i: int32 = 0;
  while (argc > 1 && argv[1][i] >= 48 && argv[1][i] <= 57) {
    port = port * 10 + (int64)(argv[1][i] - 48);
    i = i + 1;
  }
  var listening: int64 = alph_tcp_listen(port);
  if (listening < 0) {
    println("port {port} is taken");
    return 1;
  }
  var line: int64 = ALPH_LATER;
  var waited: int32 = 0;
  while (line < 0 && waited < 2000) {
    line = alph_tcp_accept(listening);
    waited = waited + 1;
    Sleep(10);
  }
  if (line < 0) {
    println("no board called");
    return 1;
  }
  syscall(ALPH_NR_FCNTL, line, 4, 0);
  alph_line_open(line);

  g_m.init(2, 0, false);
  g_m.kind(PRIMES, &primes_job, 0);
  g_m.share(PRIMES);
  g_m.kind(ANGLE, 0, 0);
  g_m.share(ANGLE);
  g_m.board(BOARD, 1);
  g_sure.lose = 4;
  g_sure.damage = 7;
  if (g_m.tether.sure(&g_sure, &g_kept[0], 8) != ALPH_OK) {
    println("FAIL no actor left for the line");
    return 1;
  }
  g_batch.init(&g_m.places);
  var pid: Word = g_m.cores.spawn_on(0, &boss, 0);
  g_m.tell(pid);
  g_m.time.after(40000, pid, LATE, 0);
  g_m.run();
  g_m.shut();
  alph_close(line);
  alph_close(listening);
  println("{g_angles} angles read by the board, {g_primes} primes: {g_on_board} of {CHUNKS} chunks on the board, {g_m.places.late} taken for lost, {g_sure.resent} sent again, {g_m.tether.dropped} frames dropped");
  if (g_late != 0 || g_wrong != 0 || g_angles != JOINTS || g_primes != 9592 || g_on_board < 1 || g_m.places.late != 0) {
    println("FAIL");
    return 1;
  }
  return 0;
}
