// The Linux end of tests/mcu/sure_board.mettle, on a sure line that loses
// and damages frames both ways: about a frame in four that this side sends is
// not sent, and one in seven has a byte changed. The board does the same.
// An actor here asks the board for the next number, six questions ahead
// while the line keeps four, so some sends are refused with ALPH_FULL and
// asked again later. Every answer must come once and in order.
//
//   sure_host <port> lossy    the board calls in; 300 answers, then stop it
//   sure_host <port> first    call the board; leave after 150 answers with
//                             questions still out, as a crash would
//   sure_host <port> second   call it again: a new run; 150 answers, then
//                             stop it
//
// This side ticks the line every 50 ms from a timer. The board does not.

import "std/io";
import "port/sys";
import "std/thread";
import "port/net";
import "port/line";
import "alph/actor/actor";
import "alph/time/time";
import "alph/tether/tether";

const PING: Word = 1;
const PONG: Word = 2;
const QUIT: Word = 3;
const LATE: Word = 4;
const TICK: Word = 5;
const AHEAD: Word = 6;

var g_node: AlphNode;
var g_actors: AlphActor[4];
var g_mail: AlphMsg[32];
var g_tether: AlphTether;
var g_sure: AlphSure;
var g_kept: AlphKept[4];
var g_time: AlphTime;
var g_timers: AlphTimer[4];

struct Asker {
  board: Word;
  rounds: Word;   // answers wanted
  quit: bool;     // stop the board after them
  sent: Word;
  answered: Word;
  bad: Word;
  fulls: Word;    // sends refused because the line kept four already
  late: Word;
  done: Word;     // ticks since the last answer, once all are in
  told: bool;     // the board was told to stop
}

fn ask_more(a: AlphActor*, s: Asker*) {
  while (s->sent < s->rounds && s->sent - s->answered < AHEAD) {
    var out: Word = a->send(s->board, PING, s->sent);
    if (out == ALPH_FULL) {
      s->fulls = s->fulls + 1;
      return;
    }
    if (out != ALPH_OK) {
      s->bad = s->bad + 1;
      return;
    }
    s->sent = s->sent + 1;
  }
}

fn asker(a: AlphActor*, m: AlphMsg*) -> Word {
  var s: Asker* = (Asker*)a->state;
  if (m->tag == LATE) {
    s->late = 1;
    a->node->stop();
    return 0;
  }
  if (m->tag == PONG) {
    if (m->arg != s->answered + 1 || m->from != s->board) {
      s->bad = s->bad + 1;
    }
    s->answered = s->answered + 1;
  }
  if (m->tag == TICK) {
    g_tether.tick();
    g_time.after(50, a->pid, TICK, 0);
    if (s->answered >= s->rounds) {
      s->done = s->done + 1;
    }
  }
  if (s->answered >= s->rounds) {
    if (!s->quit) {
      a->node->stop();  // leaves with questions out, as a crash would
      return 0;
    }
    if (!s->told && a->send(s->board, QUIT, 0) == ALPH_OK) {
      s->told = true;
    }
    // Stop once the board has the word to stop, or after three seconds:
    // the board may stop before its word that it has it gets through.
    if (s->told && (g_sure.held == 0 || s->done > 60)) {
      a->node->stop();
    }
    return 0;
  }
  ask_more(a, s);
  return 0;
}

fn number(text: cstring) -> int64 {
  var n: int64 = 0;
  var i: int32 = 0;
  while (text[i] >= 48 && text[i] <= 57) {
    n = n * 10 + (int64)(text[i] - 48);
    i = i + 1;
  }
  return n;
}

// Calls the board's serial port, which QEMU serves on a TCP port, waiting
// for it 20 seconds at most. The line waits when read.
fn call(port: int64) -> int64 {
  var address: uint8[16];
  for i in 0..16 {
    address[i] = 0;
  }
  address[0] = 2;
  address[2] = (uint8)((port >> 8) & 255);
  address[3] = (uint8)(port & 255);
  address[4] = 127;
  address[7] = 1;
  for i in 0..400 {
    var fd: int64 = syscall(ALPH_NR_SOCKET, 2, 1, 0);
    if (syscall(ALPH_NR_CONNECT, fd, (int64)&address[0], 16) == 0) {
      return fd;
    }
    syscall(ALPH_NR_CLOSE, fd);
    Sleep(50);
  }
  return -1;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 3) {
    println("sure_host <port> lossy|first|second");
    return 2;
  }
  var port: int64 = number(argv[1]);
  var mode: uint8 = (uint8)argv[2][0];
  var s: Asker;
  s.board = (Word)(((Word)1 << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS));
  s.rounds = 150;
  s.quit = mode == 115;  // second
  var listening: int64 = -1;
  var line: int64 = ALPH_LATER;
  if (mode == 108) {     // lossy: the board calls in
    s.rounds = 300;
    s.quit = true;
    listening = alph_tcp_listen(port);
    if (listening < 0) {
      println("port {port} is taken");
      return 1;
    }
    var waited: int32 = 0;
    while (line < 0 && waited < 2000) {
      line = alph_tcp_accept(listening);
      waited = waited + 1;
      Sleep(10);
    }
    if (line >= 0) {
      syscall(ALPH_NR_FCNTL, line, 4, 0);  // the line's thread reads it and waits
    }
  } else {
    line = call(port);
  }
  if (line < 0) {
    println("no line to the board");
    return 1;
  }
  alph_line_open(line);

  // This machine is place 0. The board is place 1, and its actor is the
  // first it spawned.
  g_node.init(&g_actors[0], 4, &g_mail[0], 8);
  g_tether.init(&g_node, 0, 1, 1);
  g_time.init(&g_node, &g_timers[0], 4);
  var me: Word = g_node.spawn(&asker, (rawptr)&s);
  if (argc < 4) {  // a fourth word keeps the line whole, to look at the rest alone
    g_sure.lose = 4;
    g_sure.damage = 7;
  }
  if (g_tether.sure(&g_sure, &g_kept[0], 4) != ALPH_OK) {
    println("FAIL no actor left for the line");
    return 1;
  }
  g_time.after(50000, me, LATE, 0);
  g_time.after(50, me, TICK, 0);
  g_node.run();
  g_time.stop();
  alph_close(line);
  if (listening >= 0) {
    alph_close(listening);
  }
  println("{s.answered} answered in order, {s.bad} wrong, {s.fulls} sends refused while four were kept, {g_sure.resent} sent again, {g_tether.dropped} frames dropped");
  if (s.answered != s.rounds || s.bad != 0 || s.late != 0 || (mode == 108 && s.fulls == 0)) {
    println("FAIL");
    return 1;
  }
  return 0;
}
