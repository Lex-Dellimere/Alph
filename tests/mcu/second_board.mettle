// A second board for one computer, for tests/mcu/arm_test.mettle (mode
// `two`): place 9, on a serial line of its own. It reads angles too, and
// answers one more than the first board would, so the computer can tell
// which board did a job.

import "port/board";
import "alph/actor/actor";
import "alph/board/board";
import "../../examples/mcu/arm_work";

var g_board: AlphBoard;

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

fn angle(joint: Word) -> Word {
  return (Word)(joint * 3) + 2;
}

fn quitter(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == QUIT) {
    a->node->stop();
  }
  return 0;
}

fn main() -> int32 {
  alph_board_start();
  g_board.init(9, 0, 8);
  g_board.node.spawn(&quitter, 0);
  g_board.share(ANGLE, &angle);
  mettle_irq_enable();
  g_board.run();
  return 0;
}
