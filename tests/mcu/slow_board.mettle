// A board whose one kind of work takes 700 milliseconds a job, for
// tests/mcu/arm_test.mettle: four jobs out at once are then each answered
// later than the last, the fourth nearly three seconds after it was sent.

import "port/board";
import "port/alarm";
import "alph/actor/actor";
import "alph/board/board";
import "../../examples/mcu/arm_work";

var g_board: AlphBoard;

@interrupt fn mettle_trap() {
  mettle_board_exit(99);
}

fn slow_angle(joint: Word) -> Word {
  var began: Word = alph_now();
  while ((Word)(alph_now() - began) < alph_ms(700)) {
  }
  return (Word)(joint * 3) + 1;
}

fn quitter(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == QUIT) {
    a->node->stop();
  }
  return 0;
}

fn main() -> int32 {
  alph_board_start();
  g_board.init(8, 0, 8);
  g_board.node.spawn(&quitter, 0);
  g_board.share(ANGLE, &slow_angle);
  mettle_irq_enable();
  g_board.run();
  return 0;
}
