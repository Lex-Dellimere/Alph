// Batches and the machine (src/batch, src/machine) on one machine: every
// piece of a batch is answered once with the right result, a second batch
// can follow the first, messages that are not the batch's are left to the
// actor, and pieces of a kind no place can run come back as gone.

import "std/io";
import "alph/actor/actor";
import "alph/machine/machine";
import "alph/batch/batch";

const GO: Word = 1;
const NOTE: Word = 2;
const DOUBLE: Word = 0;   // out is twice in
const NOWHERE: Word = 1;  // a kind with no way to run it
const PIECES: Word = 1000;

var g_m: AlphMachine;
var g_batch: AlphBatch;
var g_failures: int32 = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

fn double_it(job: AlphJob*) -> Word {
  job->out = job->in * 2;
  return 0;
}

struct Tally {
  seen: uint8[1000];
  twice: Word;
  wrong: Word;
  gone: Word;
  notes: Word;
}

fn fill(b: AlphBatch*, job: AlphJob*, piece: Word) {
  job->in = piece + 5;
}

fn took(b: AlphBatch*, job: AlphJob*, piece: Word) {
  var t: Tally* = (Tally*)b->ctx;
  if (t->seen[piece] != 0) {
    t->twice = t->twice + 1;
  }
  t->seen[piece] = 1;
  if (job->status == ALPH_GONE) {
    t->gone = t->gone + 1;
  } else if (job->out != (piece + 5) * 2) {
    t->wrong = t->wrong + 1;
  }
}

struct Boss {
  kind: Word;
  total: Word;
  tally: Tally*;
}

fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  var s: Boss* = (Boss*)a->state;
  if (m->tag == GO) {
    g_batch.begin(a, s->kind, s->total, &fill, &took, (rawptr)s->tally);
    if (g_batch.over()) {
      a->cores()->stop();
    }
    return 0;
  }
  if (!g_batch.took(a, m)) {
    s->tally->notes = s->tally->notes + 1;
    return 0;
  }
  if (g_batch.over()) {
    a->cores()->stop();
  }
  return 0;
}

fn clear(t: Tally*) {
  for i in 0..1000 {
    t->seen[i] = 0;
  }
  t->twice = 0;
  t->wrong = 0;
  t->gone = 0;
  t->notes = 0;
}

fn main() -> int32 {
  var t: Tally;
  var s: Boss;
  s.tally = &t;
  g_m.init(3, 0, false);
  g_m.kind(DOUBLE, &double_it, 0);
  g_m.kind(NOWHERE, 0, 0);
  g_batch.init(&g_m.places);
  var pid: Word = g_m.cores.spawn_on(0, &boss, (rawptr)&s);

  // A thousand pieces, with other mail for the actor in between.
  clear(&t);
  s.kind = DOUBLE;
  s.total = PIECES;
  g_m.cores.send(pid, GO, 0);
  g_m.cores.send(pid, NOTE, 0);
  g_m.cores.send(pid, NOTE, 0);
  g_m.run();
  var answered: Word = 0;
  for i in 0..1000 {
    answered = answered + (Word)t.seen[i];
  }
  expect(answered == PIECES && t.twice == 0, "every piece is answered once ({answered} of {PIECES}, {t.twice} twice)");
  expect(t.wrong == 0, "with the right result ({t.wrong} wrong)");
  expect(g_batch.by_way[ALPH_CPU] == PIECES, "all on this machine's cores ({g_batch.by_way[ALPH_CPU]})");
  expect(t.notes == 2, "mail that is not the batch's is left to the actor ({t.notes} of 2)");
  expect(g_m.seats[1].ran > 0 && g_m.seats[2].ran > 0, "both cores that take work took some");

  // The batch again, for a second lot.
  clear(&t);
  s.total = 100;
  g_m.cores.send(pid, GO, 0);
  g_m.run();
  answered = 0;
  for i in 0..1000 {
    answered = answered + (Word)t.seen[i];
  }
  expect(answered == 100 && t.wrong == 0 && g_batch.over(), "a batch can be begun again ({answered} of 100)");

  // A kind no place can run: every piece comes back as gone, and the batch
  // is over.
  clear(&t);
  s.kind = NOWHERE;
  s.total = 5;
  g_m.cores.send(pid, GO, 0);
  g_m.run();
  expect(t.gone == 5 && g_batch.gone == 5 && g_batch.over(), "pieces no place can run come back as gone ({t.gone} of 5)");

  // A batch of no pieces is over at once, and a kind that is not 0 to 7
  // is refused.
  clear(&t);
  s.kind = DOUBLE;
  s.total = 0;
  g_m.cores.send(pid, GO, 0);
  g_m.run();
  expect(g_batch.over() && g_batch.back == 0, "a batch of no pieces is over at once");
  expect(g_m.share(8) == ALPH_GONE && g_m.share(-1) == ALPH_GONE, "a kind that is not 0 to 7 cannot be shared");

  g_m.shut();
  if (g_failures != 0) {
    return 1;
  }
  println("batch ok: {PIECES} pieces answered once each, then 100 more, then 5 that no place could run");
  return 0;
}
