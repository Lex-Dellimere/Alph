// Worker pool: a job runs on a thread of its own and may block while the
// shared scheduler keeps running; the answer carries the job's ref, result
// and bytes; two jobs run in parallel; a full queue answers ALPH_FULL; a
// trap or alph_exit_now in a job is answered and the worker replaced; a job
// that times out gets no result afterwards.

import "std/io";
import "std/mem";
import "alph/sys/atomic";
import "alph/sys/clock";
import "alph/alph";

const TAG_GO: int64 = ALPH_TAG_USER;
const TAG_END: int64 = ALPH_TAG_USER + 1;
const TAG_TICK: int64 = ALPH_TAG_USER + 2;
const REASON_JOB: int64 = ALPH_REASON_USER + 3;

var g_node: AlphNode;
var g_failures: int64 = 0;
var g_ticks: int64 = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    alph_atomic_add(&g_failures, 1);
  }
}

// Runs on the shared scheduler and counts while the workers block.
fn ticker(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  if (m->tag == ALPH_TAG_INIT || m->tag == TAG_TICK) {
    alph_atomic_add(&g_ticks, 1);
    alph_send_after(ctx, 1, ctx->self, TAG_TICK, 0);
  }
  return ALPH_CONTINUE;
}

// Blocks this thread for about ms milliseconds.
fn nap_ms(ms: int64) {
  var word: int64 = 0;
  var end: int64 = alph_now_ms() + ms;
  while (true) {
    var left: int64 = end - alph_now_ms();
    if (left < 1) {
      return;
    }
    alph_futex_wait(&word, word, left * 1000000);
  }
}

// Puts its input back reversed and returns 7.
fn reverse(input: rawptr, size: int64, out: AlphOut*) -> int64 {
  var src: uint8* = (uint8*)input;
  var tmp: uint8[32];
  for i: int64 in 0..size {
    tmp[i] = src[size - 1 - i];
  }
  alph_out_bytes(out, (rawptr)&tmp[0], size);
  return 7;
}

// Input: an int64, the milliseconds to block. Returns it.
fn sleeper(input: rawptr, size: int64, out: AlphOut*) -> int64 {
  var ms: int64 = *(int64*)input;
  nap_ms(ms);
  return ms;
}

fn crasher(input: rawptr, size: int64, out: AlphOut*) -> int64 {
  var zero: int64 = size - size;
  return 100 / zero;
}

fn exiter(input: rawptr, size: int64, out: AlphOut*) -> int64 {
  alph_exit_now(REASON_JOB);
  return 99;  // never reached
}

struct Boss {
  step: int64;
  pool: int64;
  start: int64;
  ticks: int64;
  got: int64;
  failed: int64;
  timed_out: int64;
  refs: int64[8];
  seen: int64[8];
}

// The slot in b->refs that holds ref, or -1.
fn slot_of(b: Boss*, ref: int64, count: int64) -> int64 {
  for i: int64 in 0..count {
    if (b->refs[i] == ref) {
      return i;
    }
  }
  return -1;
}

fn boss(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var b: Boss* = (Boss*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);  // the pool is linked; its exit must not end the boss
    b->pool = alph_spawn_pool(ctx, 2, 4);
    expect(b->pool != 0, "pool spawned");
    alph_spawn(ctx, 0, &ticker);
    var text: uint8[16];
    for i: int64 in 0..10 {
      text[i] = (uint8)(65 + i);
    }
    b->refs[0] = alph_offload(ctx, b->pool, (rawptr)&text[0], 10, 1000, &reverse);
    expect(b->refs[0] > 0, "job sent");
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_EXIT) {
    expect(false, "the pool exited");
    alph_halt(ctx, 0);
    return ALPH_CONTINUE;
  }

  // 1: the answer carries ref, result and bytes
  if (b->step == 0 && m->tag == ALPH_TAG_DONE) {
    expect(m->ref == b->refs[0], "the answer has the offload's ref");
    expect(m->arg == 7, "the answer has the work function's result");
    var size: int64 = 0;
    var data: uint8* = (uint8*)alph_msg_bytes(m, &size);
    expect(size == 10, "the answer has the bytes the work wrote");
    if (size == 10) {
      var same: bool = true;
      for i: int64 in 0..10 {
        if (data[i] != (uint8)(74 - i)) {
          same = false;
        }
      }
      expect(same, "the bytes are the input reversed");
    }
    b->step = 1;
    alph_send_after(ctx, 30, ctx->self, TAG_GO, 0);  // let the worker report idle
    return ALPH_CONTINUE;
  }

  // 2: two blocking jobs run in parallel while the scheduler keeps going
  if (b->step == 1 && m->tag == TAG_GO) {
    var ms: int64 = 100;
    b->ticks = alph_atomic_load(&g_ticks);
    b->start = alph_now_ms();
    b->refs[0] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 0, &sleeper);
    b->refs[1] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 0, &sleeper);
    b->got = 0;
    b->step = 2;
    return ALPH_CONTINUE;
  }
  if (b->step == 2 && m->tag == ALPH_TAG_DONE) {
    expect(m->arg == 100, "a sleeping job returns its argument");
    expect(slot_of(b, m->ref, 2) >= 0, "the answer is for one of the two jobs");
    b->got = b->got + 1;
    if (b->got == 2) {
      var elapsed: int64 = alph_now_ms() - b->start;
      expect(elapsed < 190, "two 100 ms jobs ran in parallel");
      var ticks: int64 = alph_atomic_load(&g_ticks) - b->ticks;
      expect(ticks > 10, "the scheduler ran while the workers blocked");
      b->step = 3;
      alph_send_after(ctx, 30, ctx->self, TAG_GO, 0);
    }
    return ALPH_CONTINUE;
  }

  // 3: both workers busy, four jobs queued, the seventh is refused
  if (b->step == 3 && m->tag == TAG_GO) {
    var slow: int64 = 200;
    var quick: int64 = 10;
    for i: int64 in 0..7 {
      b->seen[i] = 0;
      if (i < 2) {
        b->refs[i] = alph_offload(ctx, b->pool, (rawptr)&slow, 8, 0, &sleeper);
      } else {
        b->refs[i] = alph_offload(ctx, b->pool, (rawptr)&quick, 8, 0, &sleeper);
      }
      expect(b->refs[i] > 0, "job sent");
    }
    b->got = 0;
    b->failed = 0;
    b->step = 4;
    return ALPH_CONTINUE;
  }
  if (b->step == 4 && (m->tag == ALPH_TAG_DONE || m->tag == ALPH_TAG_FAILED)) {
    var i: int64 = slot_of(b, m->ref, 7);
    expect(i >= 0, "the answer is for one of the seven jobs");
    if (i >= 0) {
      b->seen[i] = b->seen[i] + 1;
    }
    if (m->tag == ALPH_TAG_FAILED) {
      expect(i == 6 && m->arg == ALPH_FULL, "the job past the queue limit is refused with ALPH_FULL");
      b->failed = b->failed + 1;
    } else {
      expect(i >= 0 && i < 6, "a job within the limit gets DONE");
      b->got = b->got + 1;
    }
    if (b->got + b->failed == 7) {
      expect(b->got == 6 && b->failed == 1, "six jobs done, one refused");
      var once: bool = true;
      for k: int64 in 0..7 {
        if (b->seen[k] != 1) {
          once = false;
        }
      }
      expect(once, "every job is answered exactly once");
      b->step = 5;
      alph_send_after(ctx, 30, ctx->self, TAG_GO, 0);
    }
    return ALPH_CONTINUE;
  }

  // 4: a trap in the work is answered; the pool still works
  if (b->step == 5 && m->tag == TAG_GO) {
    var ms: int64 = 0;
    b->refs[0] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 0, &crasher);
    b->step = 6;
    return ALPH_CONTINUE;
  }
  if (b->step == 6 && m->tag == ALPH_TAG_FAILED) {
    expect(m->ref == b->refs[0], "the failure has the offload's ref");
    expect(m->arg == ALPH_CRASHED, "a trap in the work fails with ALPH_CRASHED");
    var ms: int64 = 10;
    b->refs[1] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 0, &sleeper);
    b->step = 7;
    return ALPH_CONTINUE;
  }
  if (b->step == 7 && m->tag == ALPH_TAG_DONE) {
    expect(m->ref == b->refs[1] && m->arg == 10, "the pool works after a crash");
    b->step = 8;
    alph_send_after(ctx, 30, ctx->self, TAG_GO, 0);
    return ALPH_CONTINUE;
  }

  // 5: alph_exit_now in the work is answered with its reason
  if (b->step == 8 && m->tag == TAG_GO) {
    var ms: int64 = 0;
    b->refs[0] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 0, &exiter);
    b->step = 9;
    return ALPH_CONTINUE;
  }
  if (b->step == 9 && m->tag == ALPH_TAG_FAILED) {
    expect(m->ref == b->refs[0], "the failure has the offload's ref");
    expect(m->arg == REASON_JOB, "alph_exit_now in the work fails with its reason");
    var ms: int64 = 10;
    b->refs[1] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 0, &sleeper);
    b->step = 10;
    return ALPH_CONTINUE;
  }
  if (b->step == 10 && m->tag == ALPH_TAG_DONE) {
    expect(m->ref == b->refs[1] && m->arg == 10, "the pool works after an exit");
    b->step = 11;
    alph_send_after(ctx, 30, ctx->self, TAG_GO, 0);
    return ALPH_CONTINUE;
  }

  // 6: a timeout is answered once, and the late result is dropped
  if (b->step == 11 && m->tag == TAG_GO) {
    var ms: int64 = 300;
    b->refs[0] = alph_offload(ctx, b->pool, (rawptr)&ms, 8, 50, &sleeper);
    alph_send_after(ctx, 400, ctx->self, TAG_END, 0);
    b->timed_out = 0;
    b->step = 12;
    return ALPH_CONTINUE;
  }
  if (b->step == 12) {
    if (m->tag == ALPH_TAG_TIMEOUT) {
      expect(m->ref == b->refs[0], "the timeout has the offload's ref");
      expect(b->timed_out == 0, "one timeout only");
      b->timed_out = 1;
    } else if (m->tag == ALPH_TAG_DONE || m->tag == ALPH_TAG_FAILED) {
      expect(false, "no result for a job that timed out");
    } else if (m->tag == TAG_END) {
      expect(b->timed_out == 1, "the 50 ms timeout arrived");
      alph_halt(ctx, 0);
    }
  }
  return ALPH_CONTINUE;
}

fn main() -> int32 {
  var cfg: AlphConfig;
  alph_config(&cfg);
  cfg.schedulers = 2;
  cfg.max_actors = 64;
  expect(alph_node_start(&g_node, &cfg), "node started");
  var b: Boss;
  memset((rawptr)&b, 0, (int64)sizeof(Boss));
  alph_node_spawn_value<Boss>(&g_node, 0, &b, &boss);
  alph_node_wait(&g_node);
  if (g_failures != 0) {
    return 1;
  }
  println("pool ok");
  return 0;
}
