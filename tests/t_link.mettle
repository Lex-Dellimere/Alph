// Links (src/link): two machines in one process, each with its own cores,
// talking over UDP on this computer. Requests and replies cross, a machine
// not yet heard or not known is gone, one that goes quiet is noticed in
// under a second, one that comes back is reachable again as a new one,
// messages lost on the way are sent again, and mail that is malformed,
// misaddressed, repeated, out of turn or from an earlier run is dropped.

import "std/io";
import "std/thread";
import "alph/actor/actor";
import "alph/cores/cores";
import "port/wire";
import "alph/link/link";
import "port/sys";

const PING: Word = 1;
const PONG: Word = 2;
const ROUNDS: Word = 2000;

// Machine A is places 0 and 1, machine B is places 2 and 3.
var g_a: AlphCores;
var g_a_core: AlphCore[2];
var g_a_actors: AlphActor[4];
var g_a_mail: AlphMsg[32];
var g_a_link: AlphLink;
var g_a_peers: AlphPeer[2];

var g_b: AlphCores;
var g_b_core: AlphCore[2];
var g_b_actors: AlphActor[4];
var g_b_mail: AlphMsg[32];
var g_b_link: AlphLink;
var g_b_peers: AlphPeer[2];
var g_b_thread: int64 = 0;

var g_ponger: Word = 0;
var g_failures: int32 = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

fn now_ms() -> Word {
  var ts: int64[2];
  syscall(ALPH_NR_CLOCK_GETTIME, 1, (int64)&ts[0]);
  return (Word)(ts[0] * 1000 + ts[1] / 1000000);
}

fn now_us() -> Word {
  var ts: int64[2];
  syscall(ALPH_NR_CLOCK_GETTIME, 1, (int64)&ts[0]);
  return (Word)(ts[0] * 1000000 + ts[1] / 1000);
}

fn ponger(a: AlphActor*, m: AlphMsg*) -> Word {
  a->reply(m, PONG, m->arg + 1);
  return 0;
}

// On machine A: pings the ponger once B is up, and notes when B is lost.
struct Driver {
  want: Word;    // rounds to run once B is up, 0 to wait for it to go down
  rounds: Word;
  ref: Word;
  bad: Word;
  ups: Word;
  downs: Word;
  down_at: Word;
  half_at: Word;  // us on the clock when half the rounds were done
}

fn driver(a: AlphActor*, m: AlphMsg*) -> Word {
  var d: Driver* = (Driver*)a->state;
  if (m->tag == ALPH_DOWN) {
    d->downs = d->downs + 1;
    d->down_at = now_ms();
    if (d->want == 0) {
      a->cores()->stop();
    }
    return 0;
  }
  if (m->tag == ALPH_UP) {
    d->ups = d->ups + 1;
    if (m->arg != 2) {
      d->bad = d->bad + 1;
    }
    d->ref = a->ask(g_ponger, PING, 0);
    return 0;
  }
  if (m->ref != d->ref || m->from != g_ponger || m->arg != d->rounds + 1) {
    d->bad = d->bad + 1;
  }
  d->rounds = m->arg;
  if (d->rounds == d->want / 2) {
    d->half_at = now_us();
  }
  if (d->rounds >= d->want) {
    a->cores()->stop();
    return 0;
  }
  d->ref = a->ask(g_ponger, PING, d->rounds);
  return 0;
}

// The wire format, written out here so the test can send what a faulty or
// hostile machine might.
struct Forged {
  magic: uint32;
  kind: uint32;
  from_place: uint32;
  from_life: uint32;
  to_life: uint32;
  ack: uint32;
  seq: uint32;
  to_place: uint32;
  to_gen: uint32;
  to_index: uint32;
  src_place: uint32;
  src_gen: uint32;
  src_index: uint32;
  unused: uint32;
  tag: int64;
  arg: int64;
  ref: int64;
}

const NOTE: Word = 3;
const END: Word = 4;

// On machine A: counts NOTEs and stops the cores at END.
fn sink(a: AlphActor*, m: AlphMsg*) -> Word {
  var notes: Word* = (Word*)a->state;
  if (m->tag == END) {
    a->cores()->stop();
    return 0;
  }
  *notes = *notes + 1;
  return 0;
}

var g_slow: Word = 0;
var g_slow_got: Word = 0;
var g_slow_bad: Word = 0;
var g_slow_stuck: int32 = 0;

// On machine B: takes two milliseconds over each NOTE, and checks they come
// in the order they were numbered.
fn slow(a: AlphActor*, m: AlphMsg*) -> Word {
  // Stuck: it stays in its handler, so its mailbox fills and stays full.
  while (g_slow_stuck != 0) {
    Sleep(5);
  }
  if (m->tag == NOTE && m->arg < 100) {
    if (m->arg != g_slow_got) {
      g_slow_bad = g_slow_bad + 1;
    }
    g_slow_got = g_slow_got + 1;
    Sleep(2);
  }
  return 0;
}

fn b_main(arg: cstring) -> uint32 {
  g_b.run();
  return 0;
}

fn start_b(port_a: int64, port_b: int64) {
  g_b.init(&g_b_core[0], 2, &g_b_actors[0], 2, &g_b_mail[0], 8);
  g_b_link.init(&g_b, 2, &g_b_peers[0], 2);
  g_b_link.peer(0, 2, alph_ip4(127, 0, 0, 1), port_a);
  g_ponger = g_b.spawn_on(1, &ponger, 0);
  g_slow = g_b.spawn_on(0, &slow, 0);  // a core of its own: when it is stuck the ponger still runs
  expect(g_b_link.start(port_b) == ALPH_OK, "machine B listens");
  g_b_thread = CreateThread(0, 0, &b_main, 0, 0, 0);
}

fn stop_b() {
  g_b_link.stop();
  g_b.stop();
  thread_join_infinite(g_b_thread);
  thread_close(g_b_thread);
  g_b_link.close();
}

fn main() -> int32 {
  var port_a: int64 = 12000 + (syscall(ALPH_NR_GETPID) % 5000) * 4;  // below the ports the system hands out itself
  var port_b: int64 = port_a + 1;
  var d: Driver;
  d.rounds = 0;
  d.bad = 0;
  d.ups = 0;
  d.downs = 0;

  g_a.init(&g_a_core[0], 2, &g_a_actors[0], 2, &g_a_mail[0], 8);
  g_a_link.init(&g_a, 0, &g_a_peers[0], 2);
  g_a_link.peer(2, 2, alph_ip4(127, 0, 0, 1), port_b);
  g_a_link.watch(g_a.spawn_on(0, &driver, (rawptr)&d));
  expect(g_a_link.start(port_a) == ALPH_OK, "machine A listens");

  // B's ponger will be the first actor on B's second core.
  var there: Word = (Word)(((Word)3 << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS));
  expect(g_a.send(there, PING, 0) == ALPH_GONE, "a machine not yet heard is gone");
  expect(g_a.send((Word)(((Word)9 << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS)), PING, 0) == ALPH_GONE,
         "a place no machine has is gone");
  expect(!g_a_link.reaches(2), "B is not reachable before it starts");

  // B starts: A is told, and requests and replies cross.
  start_b(port_a, port_b);
  expect(g_ponger == there, "the ponger is where A expects it");
  d.want = ROUNDS;
  g_a.run();
  var each_us: Word = (Word)((now_us() - d.half_at) / (ROUNDS / 2));  // the second half: B is known by then
  expect(d.ups == 1, "A is told once that B is up ({d.ups})");
  expect(d.rounds == ROUNDS, "every round crossed and came back ({d.rounds})");
  expect(d.bad == 0, "each reply came from the ponger with its request's ref ({d.bad} did not)");
  expect(g_a_link.reaches(3), "B is reachable");
  var first_life: uint32 = g_a_peers[0].life;

  // B goes quiet: A notices in under a second.
  d.want = 0;
  var quiet: Word = now_ms();
  stop_b();
  g_a.run();
  var took: Word = d.down_at - quiet;
  expect(d.downs == 1, "A is told once that B is down ({d.downs})");
  expect(took >= 300 && took < 1000, "within a second, and not at once ({took} ms)");
  expect(g_a.send(g_ponger, PING, 0) == ALPH_GONE, "a machine that is down is gone");
  expect(!g_a_link.reaches(2), "B is not reachable");

  // B comes back as a new machine, and is reachable again.
  d.rounds = 0;
  d.want = 100;
  start_b(port_a, port_b);
  g_a.run();
  expect(d.ups == 2, "A is told that B is up again ({d.ups})");
  expect(d.rounds == 100 && d.bad == 0, "requests cross again ({d.rounds} rounds, {d.bad} bad)");
  expect(g_a_peers[0].life != first_life, "the B that came back is a new one");

  // One message in four from A and one in three from B is lost on the way.
  // Every round still crosses, in order, because what is lost is sent again.
  g_a_link.lose = 4;
  g_b_link.lose = 3;
  d.rounds = 0;
  d.want = 60;
  d.ref = g_a_actors[0].ask(g_ponger, PING, 0);
  g_a.run();
  expect(d.rounds == 60 && d.bad == 0, "with messages lost on the way every round still crosses ({d.rounds} rounds, {d.bad} bad)");
  expect(g_a_link.resent > 0 && g_b_link.resent > 0, "because they were sent again ({g_a_link.resent} and {g_b_link.resent} times)");
  var resent: Word = g_a_link.resent + g_b_link.resent;
  g_a_link.lose = 0;
  g_b_link.lose = 0;

  // B is out of A's hearing for a while, though it never stopped. A calls
  // it down, then up again, and messages cross as before: the same run of
  // B, so the numbering carries on where it was.
  var b_run: uint32 = g_a_peers[0].life;
  var ups: Word = d.ups;
  var downs: Word = d.downs;
  d.want = 0;
  g_a_link.deaf = 1;
  g_a.run();
  expect(d.downs == downs + 1, "a machine out of hearing is called down");
  g_a_link.deaf = 0;
  d.rounds = 0;
  d.want = 100;
  g_a.run();
  expect(d.ups == ups + 1 && g_a_peers[0].life == b_run, "it is up again, the same run of it");
  expect(d.rounds == 100 && d.bad == 0, "and requests cross as before ({d.rounds} rounds, {d.bad} bad)");

  // Forty messages at once for an actor whose mailbox holds eight and who
  // is slow to read them. None is dropped: what finds the mailbox full is
  // left with A, sent again, and arrives in its turn.
  g_slow_got = 0;
  g_slow_bad = 0;
  var sent: Word = 0;
  var tries: Word = 0;
  while (sent < 40 && tries < 20000) {
    if (g_a.send(g_slow, NOTE, sent) == ALPH_OK) {
      sent = sent + 1;
    } else {
      Sleep(1);
    }
    tries = tries + 1;
  }
  var waited: Word = 0;
  while (g_slow_got < 40 && waited < 8000) {
    Sleep(1);
    waited = waited + 1;
  }
  expect(sent == 40 && g_slow_got == 40, "forty messages for a mailbox of eight all arrive ({g_slow_got} of {sent} sent)");
  expect(g_slow_bad == 0, "in the order they were sent ({g_slow_bad} out of order)");
  expect(g_b_link.full > 0, "because the ones that found it full were sent again ({g_b_link.full} times)");
  var held: Word = g_b_link.full;

  // An actor that does not read at all: after half a second its message is
  // dropped, and mail for the other actors of its machine crosses again.
  g_slow_stuck = 1;
  sent = 0;
  tries = 0;
  while (sent < 12 && tries < 20000) {
    if (g_a.send(g_slow, NOTE, 100 + sent) == ALPH_OK) {
      sent = sent + 1;
    } else {
      Sleep(1);
    }
    tries = tries + 1;
  }
  d.rounds = 0;
  d.want = 20;
  d.ref = g_a_actors[0].ask(g_ponger, PING, 0);
  g_a.run();
  expect(d.rounds == 20 && d.bad == 0, "mail still crosses behind an actor that does not read ({d.rounds} of 20 rounds)");
  expect(g_b_link.shed > 0, "because what it would not take was dropped after half a second ({g_b_link.shed})");
  g_slow_stuck = 0;

  // What a faulty machine might send, from a third socket claiming to be B.
  var notes: Word = 0;
  var sink_pid: Word = g_a.spawn_on(1, &sink, (rawptr)&notes);
  var third: AlphWire;
  var here: uint32 = alph_ip4(127, 0, 0, 1);
  var f: Forged;
  expect(third.open(port_a + 2, 10), "a third socket");
  // The link counts a message as taken a moment after it hands it to its
  // actor, and B may still have one on its way: wait, so that the number
  // given to the notes below is the next one.
  Sleep(30);
  var b_life: uint32 = g_a_peers[0].life;
  f.magic = 1095520328;
  f.kind = 2;
  f.from_place = 2;
  f.from_life = b_life;
  f.to_life = g_a_link.life;
  f.ack = 0;
  f.seq = g_a_peers[0].got + 1;
  f.to_place = 1;
  f.to_gen = (uint32)((sink_pid >> ALPH_INDEX_BITS) & 16777215);
  f.to_index = (uint32)(sink_pid & 16777215);
  f.src_place = 0;
  f.src_gen = 0;
  f.src_index = 0;
  f.unused = 0;
  f.tag = (int64)NOTE;
  f.arg = 0;
  f.ref = 0;
  third.send(here, port_a, (uint8*)&f, 80);   // sound: arrives
  third.send(here, port_a, (uint8*)&f, 80);   // the same one again
  f.seq = f.seq + 1;
  f.to_life = g_a_link.life + 1;
  third.send(here, port_a, (uint8*)&f, 80);   // meant for another run of A
  f.to_life = g_a_link.life;
  f.to_place = 0;
  f.to_gen = f.to_gen + 16777216;             // spills into the place: names core 1 from core 0
  third.send(here, port_a, (uint8*)&f, 80);   // taken in its turn, so nothing waits behind it, then dropped
  f.seq = f.seq + 1;
  f.to_place = 1;
  f.to_gen = f.to_gen - 16777216;
  third.send(here, port_a, (uint8*)&f, 40);   // cut short
  f.from_life = b_life - 5000;                // from a run of B before this one
  third.send(here, port_a, (uint8*)&f, 80);
  f.from_life = b_life;
  f.seq = f.seq + 3;
  third.send(here, port_a, (uint8*)&f, 80);   // too early: the ones before it never came
  f.seq = f.seq - 3;
  f.tag = (int64)END;
  third.send(here, port_a, (uint8*)&f, 80);
  g_a.run();
  third.close();
  expect(notes == 1, "of seven notes only the sound one arrives, once ({notes})");
  expect(g_a_peers[0].life == b_life, "mail from an earlier run of B does not bring that run back");
  expect(d.ups == ups + 1 && d.downs == downs + 1, "and the watcher is told nothing new ({d.ups} ups, {d.downs} downs)");

  stop_b();
  g_a_link.stop();
  g_a_link.close();
  if (g_failures != 0) {
    return 1;
  }
  println("link ok: {ROUNDS} requests between two machines at {each_us} us each, {resent} lost messages sent again, {held} that found a mailbox full sent again, a lost machine noticed in {took} ms");
  return 0;
}
