// A slow machine and a quick one that do the same kind of work
// (src/machine): the machine that asks keeps a time for each, so jobs
// asked for one at a time go to the quick one once both have been tried.

import "std/io";
import "std/thread";
import "alph/actor/actor";
import "alph/machine/machine";

const GO: Word = 1;
const WORK: Word = 0;  // out is in plus one: after 8 ms on the slow machine, 1 ms on the quick one
const JOBS: Word = 80;

var g_m: AlphMachine[3];  // the one that asks, the slow one, the quick one
var g_job: AlphJob;
var g_asked: Word = 0;
var g_back: Word = 0;
var g_wrong: Word = 0;
var g_failures: int32 = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

fn now_ns() -> Word {
  var ts: int64[2];
  syscall(228, 1, (int64)&ts[0]);
  return (Word)(ts[0] * 1000000000 + ts[1]);
}

fn work(job: AlphJob*, ns: Word) -> Word {
  var until: Word = now_ns() + ns;
  while (now_ns() < until) {
  }
  job->out = job->in + 1;
  return 0;
}

fn slow(job: AlphJob*) -> Word {
  return work(job, 8000000);
}

fn quick(job: AlphJob*) -> Word {
  return work(job, 1000000);
}

// Asks for one job at a time.
fn boss(a: AlphActor*, m: AlphMsg*) -> Word {
  if (m->tag == ALPH_DONE) {
    g_back = g_back + 1;
    if (g_job.status != ALPH_OK || g_job.out != g_job.in + 1 || g_job.way != ALPH_FAR) {
      g_wrong = g_wrong + 1;
    }
  } else if (m->tag != GO) {
    return 0;
  }
  if (g_back == JOBS) {
    a->cores()->stop();
    return 0;
  }
  g_job.kind = WORK;
  g_job.size = 1;
  g_job.home = ALPH_NOWHERE;
  g_job.stay = 0;
  g_job.count = 0;
  g_job.in = g_back;
  if (g_m[0].places.ask(a, &g_job) < 0) {
    g_wrong = g_wrong + 1;
    a->cores()->stop();
  }
  return 0;
}

fn helper_main(arg: cstring) -> uint32 {
  var m: AlphMachine* = (AlphMachine*)arg;
  m->run();
  return 0;
}

fn main() -> int32 {
  var port: int64 = 21000 + (syscall(39) % 2000) * 3;
  var here: uint32 = alph_ip4(127, 0, 0, 1);
  // Machine i has places 2 * i and 2 * i + 1 and listens on port + i. The
  // slow one is the first peer, so with one time for both it would be
  // picked every time.
  for i in 0..3 {
    g_m[i].init(2, (Word)(i * 2), false);
    for other in 0..3 {
      if (other != i) {
        g_m[i].peer((Word)(other * 2), 2, here, port + (int64)other);
      }
    }
  }
  g_m[0].kind(WORK, 0, 0);  // the one that asks has no way of its own
  g_m[1].kind(WORK, &slow, 0);
  g_m[2].kind(WORK, &quick, 0);
  for i in 0..3 {
    expect(g_m[i].share(WORK) == ALPH_OK, "the machine shares the kind");
    expect(g_m[i].start(port + (int64)i) == ALPH_OK, "the machine listens");
  }
  var pid: Word = g_m[0].cores.spawn_on(0, &boss, 0);
  var helper1: int64 = CreateThread(0, 0, &helper_main, (cstring)&g_m[1], 0, 0);
  var helper2: int64 = CreateThread(0, 0, &helper_main, (cstring)&g_m[2], 0, 0);

  // The asking machine's one core takes the work, so its first place is a
  // core's and the next two are the other machines'.
  var waited: int32 = 0;
  while ((g_m[0].seats[1].workers[WORK] == 0 || g_m[0].seats[2].workers[WORK] == 0) && waited < 3000) {
    g_m[0].core[0].node.turn();
    Sleep(1);
    waited = waited + 1;
  }
  expect(g_m[0].seats[1].workers[WORK] != 0 && g_m[0].seats[2].workers[WORK] != 0, "the asking machine finds a worker on each of the others");
  expect(g_m[0].seats[1].own != 0 && g_m[0].seats[2].own != 0, "each other machine has times of its own");

  g_m[0].cores.send(pid, GO, 0);
  g_m[0].run();
  var by_slow: Word = g_m[1].served;
  var by_quick: Word = g_m[2].served;
  expect(g_back == JOBS && g_wrong == 0, "every job is answered rightly ({g_back} of {JOBS}, {g_wrong} wrong)");
  expect(by_slow >= 1, "the slow machine was tried ({by_slow} jobs)");
  expect(by_quick >= 60, "most jobs go to the quick machine ({by_quick} of {JOBS}, {by_slow} to the slow one)");

  g_m[1].stop();
  g_m[2].stop();
  thread_join_infinite(helper1);
  thread_close(helper1);
  thread_join_infinite(helper2);
  thread_close(helper2);
  for i in 0..3 {
    g_m[i].shut();
  }
  if (g_failures != 0) {
    return 1;
  }
  println("own ok: of {JOBS} jobs asked for one at a time, {by_quick} went to the quick machine and {by_slow} to the slow one");
  return 0;
}
