// Lives (src/life): a watcher is told when an actor ends and why, on its own
// core or another; watching one already gone says so; an unwatched end tells
// nobody; a kept actor that fails goes on with the same pid and its mail,
// until its restarts run out; a watcher with a full mailbox is told late,
// not never; a handler that crashes ends its actor and nothing else, and a
// kept one goes on; and a lost machine ends every actor watched on it.

import "std/io";
import "alph/actor/actor";
import "alph/cores/cores";
import "alph/life/life";

const NOTE: Word = 1;
const DIE: Word = 2;     // arg: the reason to end with
const SETTLE: Word = 3;
const CRASH: Word = 4;   // arg: 0 a null pointer, 1 a division by zero, 2 an index past the end

var g_cores: AlphCores;
var g_core: AlphCore[2];
var g_actors: AlphActor[16];
var g_mail: AlphMsg[64];
var g_life: AlphLife;
var g_watches: AlphWatch[4];
var g_keeps: AlphKeep[2];
var g_failures: int32 = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

// Ends when told to, with the reason it is given. Counts its notes.
struct Mortal {
  notes: Word;
  resets: Word;
}

var g_table: Word[4];

fn mortal(a: AlphActor*, m: AlphMsg*) -> Word {
  var s: Mortal* = (Mortal*)a->state;
  if (m->tag == DIE) {
    return m->arg;
  }
  if (m->tag == CRASH) {
    if (m->arg == 0) {
      var nothing: Word* = (Word*)a->node->life;
      nothing = (Word*)((int64)nothing - (int64)nothing);
      *nothing = 1;
    } else if (m->arg == 1) {
      s->notes = (Word)(10 / (m->arg - 1));
    } else {
      g_table[m->arg + 1000000] = 1;
    }
    return 0;
  }
  s->notes = s->notes + 1;
  return 0;
}

fn mortal_reset(state: rawptr) {
  var s: Mortal* = (Mortal*)state;
  s->notes = 0;
  s->resets = s->resets + 1;
}

// Records every ALPH_ENDED and stops the cores at the one it waits for.
struct Probe {
  want: Word;
  ended: Word;
  from: Word;
  reason: Word;
  ref: Word;
  notes: Word;
}

fn probe(a: AlphActor*, m: AlphMsg*) -> Word {
  var p: Probe* = (Probe*)a->state;
  if (m->tag == SETTLE) {
    g_life.settle();
    return 0;
  }
  if (m->tag != ALPH_ENDED) {
    p->notes = p->notes + 1;
    return 0;
  }
  p->ended = p->ended + 1;
  p->from = m->from;
  p->reason = m->arg;
  p->ref = m->ref;
  if (p->ended == p->want) {
    a->cores()->stop();
  }
  return 0;
}

fn main() -> int32 {
  g_cores.init(&g_core[0], 2, &g_actors[0], 8, &g_mail[0], 4);
  g_life.init(&g_cores, &g_watches[0], 4, &g_keeps[0], 2);
  var p: Probe;
  p.want = 1;
  p.ended = 0;
  p.notes = 0;
  var watcher: Word = g_cores.spawn_on(0, &probe, (rawptr)&p);
  var s: Mortal[4];
  for i in 0..4 {
    s[i].notes = 0;
    s[i].resets = 0;
  }

  // Told when it ends, and why, across cores.
  var far: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[0]);
  var ref: Word = g_life.watch(watcher, far);
  expect(ref > 0, "watch gives a ref");
  g_cores.send(far, DIE, 7);
  g_cores.run();
  expect(p.ended == 1 && p.from == far && p.reason == 7 && p.ref == ref, "the watcher is told who ended, why, and for which watch");
  expect(g_life.watch(watcher, far) == ALPH_GONE, "watching an actor that is gone says so");
  expect(g_life.unwatch(ref) == ALPH_GONE, "a watch is over once it has told");

  // An actor that is finished ends with ALPH_END. An unwatched end tells nobody.
  var near: Word = g_cores.spawn_on(0, &mortal, (rawptr)&s[1]);
  var quiet: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[2]);
  var dropped: Word = g_life.watch(watcher, quiet);
  ref = g_life.watch(watcher, near);
  expect(g_life.unwatch(dropped) == ALPH_OK, "a watch can be dropped");
  expect(g_life.unwatch(dropped) == ALPH_GONE, "once");
  expect(g_life.unwatch(0) == ALPH_GONE, "ref 0 is no watch");
  g_cores.send(quiet, DIE, 5);
  g_cores.send(near, DIE, ALPH_END);
  p.want = 2;
  g_cores.run();
  expect(p.ended == 2 && p.from == near && p.reason == ALPH_END, "only the watched end is told ({p.ended - 1} more)");
  g_core[1].node.turn();  // the cores may have stopped before the quiet one read its mail
  expect(!g_cores.alive(quiet) && !g_cores.alive(near), "both are gone");

  // A kept actor that fails goes on: same pid, state set up again, and the
  // mail behind the failure still arrives.
  var kept: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[3]);
  expect(g_life.keep(kept, &mortal_reset, 2) == ALPH_OK, "an actor can be kept");
  expect(g_life.keep(far, &mortal_reset, 2) == ALPH_GONE, "one that is gone cannot");
  expect(g_life.keep(kept, &mortal_reset, 2) == ALPH_OK, "keeping it again only sets its restarts anew");
  expect(g_keeps[1].pid == 0, "and takes no second keep");
  ref = g_life.watch(watcher, kept);
  g_cores.send(kept, NOTE, 0);
  g_cores.send(kept, DIE, 9);
  g_cores.send(kept, NOTE, 0);
  g_cores.send(kept, NOTE, 0);
  p.want = 3;
  // Nothing ends here, so core 1 is run from this thread until the mail is in.
  while (s[3].resets < 1 || s[3].notes < 2) {
    g_core[1].node.turn();
  }
  expect(g_cores.alive(kept), "after a failure a kept actor is alive, with the same pid");
  expect(s[3].resets == 1 && s[3].notes == 2, "its state was set up again and its later mail arrived ({s[3].notes} notes)");
  expect(p.ended == 2, "nobody was told it ended");

  // Its second failure is forgiven too, its third is not.
  g_cores.send(kept, DIE, 9);
  g_cores.send(kept, DIE, 9);
  g_cores.run();
  expect(p.ended == 3 && p.from == kept && p.reason == 9 && p.ref == ref, "when its restarts run out it ends, and the watcher is told");
  expect(s[3].resets == 2, "it was set up again twice in all ({s[3].resets})");
  expect(!g_cores.alive(kept), "then it is gone");

  // A watcher whose mailbox is full is told late, not never.
  var late: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[0]);
  ref = g_life.watch(watcher, late);
  p.notes = 0;
  for i in 0..3 {
    g_cores.send(watcher, NOTE, 0);
  }
  g_cores.send(watcher, SETTLE, 0);
  g_cores.send(late, DIE, 3);
  while (g_cores.alive(late)) {
    g_core[1].node.turn();
  }
  p.want = 4;
  g_cores.run();
  expect(p.ended == 4 && p.from == late && p.reason == 3, "a watcher with a full mailbox is still told");

  // Every watch in use.
  var a1: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[0]);
  for i in 0..4 {
    expect(g_life.watch(watcher, a1) > 0, "four watches fit");
  }
  expect(g_life.watch(watcher, a1) == ALPH_FULL, "a fifth is refused");
  g_cores.send(a1, DIE, 4);
  p.want = 8;
  g_cores.run();
  expect(p.ended == 8, "each watch of one actor is told ({p.ended - 4} of 4)");

  // A handler that crashes ends its actor, not the node: a null pointer, a
  // division by zero, an index past the end.
  for how in 0..3 {
    var doomed: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[0]);
    ref = g_life.watch(watcher, doomed);
    g_cores.send(doomed, CRASH, (Word)how);
    p.want = p.ended + 1;
    g_cores.run();
    expect(p.from == doomed && p.reason == ALPH_CRASHED && p.ref == ref, "a crash ends the actor and its watcher is told (crash {how})");
    expect(!g_cores.alive(doomed), "the actor that crashed is gone (crash {how})");
  }

  // A kept actor that crashes is set up again and goes on, and so does
  // everything else on its core.
  s[1].notes = 0;
  s[1].resets = 0;
  s[2].notes = 0;
  var sturdy: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[1]);
  var bystander: Word = g_cores.spawn_on(1, &mortal, (rawptr)&s[2]);
  expect(g_life.keep(sturdy, &mortal_reset, 3) == ALPH_OK, "the sturdy one is kept");
  for how in 0..3 {
    g_cores.send(sturdy, NOTE, 0);
    g_cores.send(sturdy, CRASH, (Word)how);
    g_cores.send(bystander, NOTE, 0);
    while (s[1].resets < (Word)how + 1 || s[2].notes < (Word)how + 1) {
      g_core[1].node.turn();
    }
  }
  g_cores.send(sturdy, NOTE, 0);
  g_core[1].node.turn();
  expect(g_cores.alive(sturdy) && s[1].resets == 3 && s[1].notes == 1, "after three crashes a kept actor is alive and takes mail ({s[1].resets} resets)");
  expect(s[2].notes == 3, "the actor beside it never noticed ({s[2].notes} notes)");
  var crashes: Word = p.ended;

  // A lost machine ends every actor watched on its places.
  var remote: Word = (Word)(((Word)9 << ALPH_PLACE_SHIFT) | ((Word)1 << ALPH_INDEX_BITS) | 3);
  ref = g_life.watch(watcher, remote);
  expect(ref > 0, "an actor on another machine can be watched");
  g_life.lost(8, 4);
  p.want = crashes + 1;
  g_cores.run();
  expect(p.ended == crashes + 1 && p.from == remote && p.reason == ALPH_LOST, "a lost machine ends the actors watched on it");

  if (g_failures != 0) {
    return 1;
  }
  println("life ok: {p.ended} ends told, 6 crashes survived, a kept actor set up again {s[3].resets} times on one pid");
  return 0;
}
