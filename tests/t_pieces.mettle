// Pieces (src/machine piece and pieces): a kind of work that is a function
// from a number to a number, handed out several pieces to a job when a
// piece is little work. Every piece is answered once and rightly, on one
// machine and with a helper; pieces that take long go one to a job; and
// the edges of the count hold. Then pieces with bytes of their own
// (piece_of and pieces_of): rows of 24 bytes several to a job, here and on
// the other machine, and rows of 2,000 bytes, which cross one to a job in
// long buffers. And pieces with a way for the GPU (piece_gpu), which is
// given much bigger jobs: the way here is a function on a core that does
// what a kernel would, so the test needs no GPU.

import "std/io";
import "std/thread";
import "alph/actor/actor";
import "alph/machine/machine";
import "alph/batch/batch";
import "port/sys";

const SQUARE: Word = 0;  // little work: many to a job
const SLOW: Word = 1;    // a millisecond each: one to a job
const NONE: Word = 2;    // no way to do it
const ONCE: Word = 3;    // done at most once: one to a job
const THERE: Word = 4;   // only the other machine has a way to do it
const ROWS: Word = 5;    // pieces with bytes
const ROWS_THERE: Word = 6;  // the same, with a way only on the other machine
const BIG_THERE: Word = 7;   // rows of more bytes than a parcel holds, a way only on the other machine
const MANY: Word = 50000;
const ROW: Word = 24;
const ROW_COUNT: Word = 20000;
const BIG: Word = 2000;
const BIG_COUNT: Word = 40;

var g_m: AlphMachine[2];
var g_seen: uint8[50000];
var g_twice: Word = 0;
var g_wrong: Word = 0;
var g_answers: Word = 0;
var g_failures: int32 = 0;
var g_rows: uint8[480000];
var g_big: uint8[80000];
var g_longs: uint8[131072];
var g_g: AlphMachine;          // a machine with a core for the GPU
var g_gpu_outs: Word[4096];
var g_gpu_jobs: Word = 0;
var g_gpu_most: Word = 0;      // the most pieces one job for the GPU had
var g_gpu_asked: Word = 0;

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

fn square(n: Word) -> Word {
  return (Word)(n * n + 7);
}

fn slow(n: Word) -> Word {
  var rest: int64[2];
  rest[0] = 0;
  rest[1] = 1000000;
  syscall(ALPH_NR_NANOSLEEP, (int64)&rest[0], 0);
  return (Word)(0 - n - 3);
}

fn took_square(piece: Word, out: Word, ctx: rawptr) {
  g_answers = g_answers + 1;
  if (piece < 0 || piece >= MANY || out != (Word)(piece * piece + 7)) {
    g_wrong = g_wrong + 1;
    return;
  }
  if (g_seen[piece] != 0) {
    g_twice = g_twice + 1;
  }
  g_seen[piece] = 1;
}

// What a row gives: every byte counts, and so do its place in the row, the
// row's number and how many bytes it was given.
fn row_sum(piece: Word, bytes: uint8*, count: Word) -> Word {
  var sum: Word = (Word)(piece * 31 + count);
  for i in 0..count {
    sum = sum + (Word)bytes[i] * (Word)(i + 1);
  }
  return sum;
}

fn row_byte(piece: Word, i: Word) -> uint8 {
  return (uint8)((Word)(piece * 7 + i * 13 + 5) & 255);
}

// ctx is how many bytes a row has.
fn took_row(piece: Word, out: Word, ctx: rawptr) {
  var each: Word = (Word)(int64)ctx;
  var want: Word = (Word)(piece * 31 + each);
  for i in 0..each {
    want = want + (Word)row_byte(piece, (Word)i) * (Word)(i + 1);
  }
  g_answers = g_answers + 1;
  if (piece < 0 || piece >= MANY || out != want) {
    g_wrong = g_wrong + 1;
    return;
  }
  if (g_seen[piece] != 0) {
    g_twice = g_twice + 1;
  }
  g_seen[piece] = 1;
}

// What a kernel would do: every piece of the run, into outs.
fn rows_gpu(first: Word, bytes: uint8*, each: Word, count: Word, outs: Word*) -> Word {
  g_gpu_jobs = g_gpu_jobs + 1;
  if (count > g_gpu_most) {
    g_gpu_most = count;
  }
  for i in 0..count {
    if (each > 0) {
      outs[i] = row_sum(first + (Word)i, bytes + (Word)((Word)i * each), each);
    } else {
      outs[i] = square(first + (Word)i);
    }
  }
  return 0;
}

// A machine with no GPU after all.
fn no_gpu(first: Word, bytes: uint8*, each: Word, count: Word, outs: Word*) -> Word {
  g_gpu_asked = g_gpu_asked + 1;
  return 1;
}

fn took_slow(piece: Word, out: Word, ctx: rawptr) {
  g_answers = g_answers + 1;
  if (out != (Word)(0 - piece - 3)) {
    g_wrong = g_wrong + 1;
  }
}

fn clear() {
  for i in 0..50000 {
    g_seen[i] = 0;
  }
  g_twice = 0;
  g_wrong = 0;
  g_answers = 0;
}

fn seen() -> Word {
  var n: Word = 0;
  for i in 0..50000 {
    n = n + (Word)g_seen[i];
  }
  return n;
}

fn helper_main(arg: cstring) -> uint32 {
  g_m[1].run();
  return 0;
}

fn main() -> int32 {
  var port: int64 = 24000 + (syscall(ALPH_NR_GETPID) % 2000) * 2;
  var here: uint32 = alph_ip4(127, 0, 0, 1);
  g_m[0].init(4, 0, false);
  g_m[0].peer(16, 5, here, port + 1);
  g_m[1].init(5, 16, false);
  g_m[1].peer(0, 4, here, port);
  for i in 0..ROW_COUNT {
    for at in 0..ROW {
      g_rows[(Word)i * ROW + (Word)at] = row_byte((Word)i, (Word)at);
    }
  }
  for i in 0..BIG_COUNT {
    for at in 0..BIG {
      g_big[(Word)i * BIG + (Word)at] = row_byte((Word)i, (Word)at);
    }
  }
  for i in 0..2 {
    g_m[i].longs(&g_longs[(Word)i * 65536], 4096, 16);
    g_m[i].piece_of(ROWS, &row_sum);
    if (i == 0) {
      g_m[i].kind(ROWS_THERE, 0, 0);
      g_m[i].kind(BIG_THERE, 0, 0);
    } else {
      g_m[i].piece_of(ROWS_THERE, &row_sum);
      g_m[i].piece_of(BIG_THERE, &row_sum);
    }
    expect(g_m[i].share(ROWS) == ALPH_OK && g_m[i].share(ROWS_THERE) == ALPH_OK && g_m[i].share(BIG_THERE) == ALPH_OK, "the machine shares the kinds with bytes");
    g_m[i].piece(SQUARE, &square);
    g_m[i].piece(SLOW, &slow);
    g_m[i].piece(ONCE, &square);
    g_m[i].once(ONCE);
    g_m[i].kind(NONE, 0, 0);
    if (i == 0) {
      g_m[i].kind(THERE, 0, 0);
    } else {
      g_m[i].piece(THERE, &square);
    }
    expect(g_m[i].share(THERE) == ALPH_OK, "the machine shares the kind only one of them does");
    expect(g_m[i].share(SQUARE) == ALPH_OK && g_m[i].share(SLOW) == ALPH_OK && g_m[i].share(ONCE) == ALPH_OK, "the machine shares the kinds");
  }

  // On one machine, before the other is there.
  clear();
  var undone: Word = g_m[0].pieces(SQUARE, MANY, &took_square, 0);
  expect(undone == 0 && seen() == MANY && g_twice == 0 && g_wrong == 0, "every piece is answered once and rightly on one machine ({seen()} of {MANY}, {g_twice} twice, {g_wrong} wrong)");
  expect(g_m[0].run > 1, "pieces of little work go several to a job ({g_m[0].run})");
  expect(g_m[0].worked.total < (Word)(MANY / 2), "so there are far fewer jobs than pieces ({g_m[0].worked.total})");

  // The edges of the count: none, fewer than are tried alone, and one more.
  clear();
  expect(g_m[0].pieces(SQUARE, 0, &took_square, 0) == 0 && g_answers == 0, "no pieces is no work");
  clear();
  expect(g_m[0].pieces(SQUARE, 10, &took_square, 0) == 0 && seen() == 10 && g_wrong == 0, "ten pieces are ten answers ({seen()})");
  clear();
  expect(g_m[0].pieces(SQUARE, 33, &took_square, 0) == 0 && seen() == 33 && g_wrong == 0 && g_twice == 0, "thirty-three pieces are thirty-three answers ({seen()})");
  clear();
  expect(g_m[0].pieces(SQUARE, 229, &took_square, 0) == 0 && seen() == 229 && g_wrong == 0 && g_twice == 0, "a last job that is not full is answered too ({seen()})");

  // A kind no place can do: every piece is told as not done.
  clear();
  expect(g_m[0].pieces(NONE, 40, &took_square, 0) == 40 && g_answers == 0, "pieces no place can do are counted as not done");

  // Pieces with bytes, on one machine.
  clear();
  undone = g_m[0].pieces_of(ROWS, ROW_COUNT, &g_rows[0], ROW, &took_row, (rawptr)(int64)ROW);
  var rows_run: Word = g_m[0].run;
  expect(undone == 0 && seen() == ROW_COUNT && g_twice == 0 && g_wrong == 0, "every row is answered once and rightly on one machine ({seen()} of {ROW_COUNT}, {g_twice} twice, {g_wrong} wrong)");
  expect(rows_run > 1 && (Word)(rows_run * ROW) <= ALPH_PARCEL_BYTES, "rows go several to a job, no more than fit a message ({rows_run})");
  clear();
  expect(g_m[0].pieces_of(ROWS, 0, &g_rows[0], ROW, &took_row, (rawptr)(int64)ROW) == 0 && g_answers == 0, "no rows is no work");
  clear();
  expect(g_m[0].pieces_of(ROWS, 33, &g_rows[0], ROW, &took_row, (rawptr)(int64)ROW) == 0 && seen() == 33 && g_wrong == 0 && g_twice == 0, "thirty-three rows are thirty-three answers ({seen()})");
  clear();
  expect(g_m[0].pieces_of(ROWS, 50, 0, ROW, &took_row, (rawptr)(int64)ROW) == 50 && g_answers == 0, "rows with no bytes are not done");

  // A machine with a GPU: its jobs are much bigger than a core's, their
  // answers come back through the program's memory, and every piece is
  // still answered once and rightly. Twice, since the GPU's core must be
  // the same thread the second time.
  g_g.init(4, 40, true);
  g_g.piece_of(ROWS, &row_sum);
  g_g.piece_gpu(ROWS, &rows_gpu, &g_gpu_outs[0], 4096);
  g_g.piece(SQUARE, &square);
  g_g.piece_gpu(SQUARE, &rows_gpu, &g_gpu_outs[0], 4096);
  g_g.piece(NONE, &square);  // the table of pieces is the process's: a kind the other machines have no way for
  g_g.piece_gpu(NONE, &no_gpu, &g_gpu_outs[0], 4096);
  for again in 0..2 {
    clear();
    g_gpu_jobs = 0;
    g_gpu_most = 0;
    undone = g_g.pieces_of(ROWS, ROW_COUNT, &g_rows[0], ROW, &took_row, (rawptr)(int64)ROW);
    expect(undone == 0 && seen() == ROW_COUNT && g_twice == 0 && g_wrong == 0, "with a GPU every row is answered once and rightly ({seen()} of {ROW_COUNT}, {g_twice} twice, {g_wrong} wrong)");
    expect(g_g.rows_by[ALPH_GPU] > 0 && g_g.rows_by[ALPH_GPU] + g_g.rows_by[ALPH_CPU] == ROW_COUNT - 32, "the GPU and the cores did them between them ({g_g.rows_by[ALPH_GPU]} and {g_g.rows_by[ALPH_CPU]})");
    expect(g_gpu_most > g_g.run && g_gpu_most <= 2048, "a job for the GPU holds more rows than a core's, and no more than half its room ({g_gpu_most} against {g_g.run})");
  }
  var gpu_rows: Word = g_g.rows_by[ALPH_GPU];
  var gpu_most: Word = g_gpu_most;
  clear();
  g_gpu_jobs = 0;
  undone = g_g.pieces(SQUARE, MANY, &took_square, 0);
  expect(undone == 0 && seen() == MANY && g_twice == 0 && g_wrong == 0 && g_g.rows_by[ALPH_GPU] > 0, "pieces that are numbers go to the GPU the same way ({seen()} of {MANY}, {g_g.rows_by[ALPH_GPU]} there)");
  clear();
  undone = g_g.pieces(NONE, 5000, &took_square, 0);
  expect(undone == 0 && seen() == 5000 && g_twice == 0 && g_wrong == 0, "when there is no GPU after all the cores do every piece ({seen()} of 5000, {g_wrong} wrong)");
  expect(g_gpu_asked > 0 && g_gpu_asked <= 2 && g_g.rows_by[ALPH_GPU] == 0, "and the GPU is asked no more ({g_gpu_asked} times)");
  g_g.shut();

  // With the other machine.
  for i in 0..2 {
    expect(g_m[i].start(port + (int64)i) == ALPH_OK, "the machine listens");
  }
  var helper: int64 = CreateThread(0, 0, &helper_main, 0, 0, 0);
  var waited: int32 = 0;
  while ((g_m[0].seats[3].workers[SQUARE] == 0 || g_m[0].seats[3].workers[SLOW] == 0 || g_m[0].seats[3].workers[ONCE] == 0 || g_m[0].seats[3].workers[THERE] == 0) && waited < 3000) {
    g_m[0].core[0].node.turn();
    Sleep(1);
    waited = waited + 1;
  }
  expect(g_m[0].seats[3].workers[SQUARE] != 0, "the first machine finds the other's worker");

  // Pieces of a millisecond: one to a job, and the helper takes its part.
  clear();
  undone = g_m[0].pieces(SLOW, 400, &took_slow, 0);
  var far_slow: Word = g_m[0].worked.by_way[ALPH_FAR];
  expect(undone == 0 && g_answers == 400 && g_wrong == 0, "pieces that take long are all answered rightly ({g_answers} of 400, {g_wrong} wrong)");
  expect(g_m[0].run == 1, "one to a job ({g_m[0].run})");
  expect(far_slow > 50, "and the other machine does a good part of them ({far_slow})");

  // Pieces of little work again, with jobs of several going to the other
  // machine and their answers coming back as bytes.
  clear();
  g_m[0].link.lose = 11;
  g_m[1].link.lose = 13;
  undone = g_m[0].pieces(SQUARE, MANY, &took_square, 0);
  g_m[0].link.lose = 0;
  g_m[1].link.lose = 0;
  expect(undone == 0 && seen() == MANY && g_twice == 0 && g_wrong == 0, "with a helper, and messages lost on the way, every piece is answered once and rightly ({seen()} of {MANY}, {g_twice} twice, {g_wrong} wrong)");

  // A kind only the other machine does: every job crosses, several pieces
  // to a job when the way there and back allows, with messages lost.
  clear();
  g_m[0].link.lose = 11;
  g_m[1].link.lose = 13;
  undone = g_m[0].pieces(THERE, 6000, &took_square, 0);
  g_m[0].link.lose = 0;
  g_m[1].link.lose = 0;
  var there_run: Word = g_m[0].run;
  expect(undone == 0 && seen() == 6000 && g_twice == 0 && g_wrong == 0, "pieces only the other machine can do are all answered once and rightly ({seen()} of 6000, {g_twice} twice, {g_wrong} wrong)");
  expect(g_m[0].worked.by_way[ALPH_CPU] == 0 && g_m[0].worked.by_way[ALPH_FAR] == g_m[0].worked.total, "all of them there ({g_m[0].worked.by_way[ALPH_FAR]} jobs of {there_run})");

  // Rows with a helper, and rows only the helper can do: a job's bytes
  // and the number of its first row cross together, several rows to a job
  // when the way there and back allows.
  clear();
  g_m[0].link.lose = 11;
  g_m[1].link.lose = 13;
  undone = g_m[0].pieces_of(ROWS, ROW_COUNT, &g_rows[0], ROW, &took_row, (rawptr)(int64)ROW);
  expect(undone == 0 && seen() == ROW_COUNT && g_twice == 0 && g_wrong == 0, "with a helper, and messages lost, every row is answered once and rightly ({seen()} of {ROW_COUNT}, {g_twice} twice, {g_wrong} wrong)");
  clear();
  undone = g_m[0].pieces_of(ROWS_THERE, 6000, &g_rows[0], ROW, &took_row, (rawptr)(int64)ROW);
  g_m[0].link.lose = 0;
  g_m[1].link.lose = 0;
  var rows_there: Word = g_m[0].run;
  expect(undone == 0 && seen() == 6000 && g_twice == 0 && g_wrong == 0, "rows only the other machine can do are all answered once and rightly ({seen()} of 6000, {g_twice} twice, {g_wrong} wrong)");
  expect(g_m[0].worked.by_way[ALPH_FAR] == g_m[0].worked.total, "all of them there ({g_m[0].worked.by_way[ALPH_FAR]} jobs of {rows_there})");

  // Rows of 2,000 bytes: one to a job, each in a long buffer.
  clear();
  undone = g_m[0].pieces_of(BIG_THERE, BIG_COUNT, &g_big[0], BIG, &took_row, (rawptr)(int64)BIG);
  expect(undone == 0 && seen() == BIG_COUNT && g_twice == 0 && g_wrong == 0 && g_m[0].run == 1, "rows of 2,000 bytes cross one to a job and are answered rightly ({seen()} of {BIG_COUNT}, {g_wrong} wrong)");

  // A kind done at most once gives no bytes back: one piece to a job.
  clear();
  undone = g_m[0].pieces(ONCE, 200, &took_square, 0);
  expect(undone == 0 && seen() == 200 && g_wrong == 0 && g_twice == 0 && g_m[0].run == 1, "a kind done at most once goes one piece to a job ({seen()} of 200, {g_m[0].run} to a job)");

  g_m[1].stop();
  thread_join_infinite(helper);
  thread_close(helper);
  for i in 0..2 {
    g_m[i].shut();
  }
  if (g_failures != 0) {
    return 1;
  }
  println("pieces ok: {MANY} pieces of little work answered once each, several to a job; 400 of a millisecond one to a job, {far_slow} of them on the other machine; 6000 only the other machine can do, {there_run} to a job; {ROW_COUNT} rows of {ROW} bytes {rows_run} to a job, and {rows_there} to a job on the other machine; with a GPU, {gpu_rows} of {ROW_COUNT} rows in jobs of up to {gpu_most}");
  return 0;
}
