// Timers (src/time): the order they arrive in, none early, cancel, a full
// timer array, a full mailbox when one is due, and an actor that sets its
// own next timer.

import "std/io";
import "alph/actor/actor";
import "alph/time/time";

const DUE: Word = 1;
const NOTE: Word = 2;
const MANY: Word = 1000;

var g_node: AlphNode;
var g_actors: AlphActor[4];
var g_mail: AlphMsg[256];
var g_time: AlphTime;
var g_timers: AlphTimer[1024];
var g_failures: int32 = 0;

fn now_us() -> Word {
  var ts: int64[2];
  syscall(228, 1, (int64)&ts[0]);
  return (Word)(ts[0] * 1000000 + ts[1] / 1000);
}

fn expect(ok: bool, what: string) {
  if (!ok) {
    println("FAIL {what}");
    g_failures = g_failures + 1;
  }
}

// Each DUE's arg is the delay it was set with, in milliseconds.
struct Log {
  start: Word;
  want: Word;
  got: Word;
  last: Word;
  early: Word;
  out_of_order: Word;
  notes: Word;
  notes_before: Word;
  refs: Word[8];
}

fn logger(a: AlphActor*, m: AlphMsg*) -> Word {
  var l: Log* = (Log*)a->state;
  if (m->tag == NOTE) {
    l->notes = l->notes + 1;
    return 0;
  }
  if ((Word)(now_us() - l->start) < (Word)(m->arg * 1000)) {
    l->early = l->early + 1;
  }
  if (m->arg < l->last) {
    l->out_of_order = l->out_of_order + 1;
  }
  l->last = m->arg;
  if (l->got < 8) {
    l->refs[l->got] = m->ref;
  }
  l->notes_before = l->notes;
  l->got = l->got + 1;
  if (l->got == l->want) {
    a->node->stop();
  }
  return 0;
}

fn fresh(l: Log*, want: Word) {
  l->start = now_us();
  l->want = want;
  l->got = 0;
  l->last = 0;
  l->early = 0;
  l->out_of_order = 0;
  l->notes = 0;
  l->notes_before = 0;
}

// Sets its own next timer five times: the usual way to do something
// every so often.
struct Beat {
  count: Word;
}

fn beater(a: AlphActor*, m: AlphMsg*) -> Word {
  var b: Beat* = (Beat*)a->state;
  b->count = b->count + 1;
  if (b->count == 5) {
    a->node->stop();
    return 1;
  }
  g_time.after(2, a->pid, DUE, 0);
  return 0;
}

fn main() -> int32 {
  g_node.init(&g_actors[0], 4, &g_mail[0], 64);
  g_time.init(&g_node, &g_timers[0], 1024);
  var l: Log;
  var log: Word = g_node.spawn(&logger, (rawptr)&l);

  // Set out of order, they arrive soonest first and none early.
  fresh(&l, 5);
  var r50: Word = g_time.after(50, log, DUE, 50);
  var r10: Word = g_time.after(10, log, DUE, 10);
  g_time.after(30, log, DUE, 30);
  g_time.after(20, log, DUE, 20);
  g_time.after(40, log, DUE, 40);
  expect(r50 > 0 && r10 > 0 && r50 != r10, "after returns a ref of its own");
  g_node.run();
  expect(l.got == 5 && l.out_of_order == 0, "five timers arrive soonest first ({l.out_of_order} out of order)");
  expect(l.early == 0, "none arrives early ({l.early} did)");
  expect(l.refs[0] == r10 && l.refs[4] == r50, "each message carries its timer's ref");
  expect(g_time.cancel(r10) == ALPH_GONE, "a timer that was sent cannot be cancelled");

  // A cancelled timer never arrives.
  fresh(&l, 2);
  g_time.after(5, log, DUE, 5);
  var gone: Word = g_time.after(10, log, DUE, 10);
  g_time.after(15, log, DUE, 15);
  expect(g_time.cancel(gone) == ALPH_OK, "a waiting timer can be cancelled");
  expect(g_time.cancel(gone) == ALPH_GONE, "but only once");
  expect(g_time.cancel(0) == ALPH_GONE, "ref 0 is no timer");
  g_node.run();
  expect(l.got == 2 && l.last == 15, "the other two arrive");

  // Every timer in use.
  fresh(&l, 0);
  var first: Word = g_time.after(100000, log, DUE, 0);
  for i in 1..1024 {
    g_time.after(100000, log, DUE, 0);
  }
  expect(g_time.after(1, log, DUE, 0) == ALPH_FULL, "a full timer array refuses");
  expect(g_time.cancel(first) == ALPH_OK, "the soonest of many can be cancelled");
  expect(g_time.after(100000, log, DUE, 0) > 0, "and its place used again");
  g_time.stop();
  g_time.init(&g_node, &g_timers[0], 1024);

  // A timer due while its actor's mailbox is full arrives once there is room.
  fresh(&l, 1);
  for i in 0..64 {
    g_node.send(log, NOTE, 0);
  }
  g_time.after(0, log, DUE, 0);
  while ((Word)(now_us() - l.start) < 5000) {
  }
  g_node.run();
  expect(l.got == 1 && l.notes_before == 64, "a timer waits for room in a full mailbox ({l.notes_before} notes came first)");

  // A short timer is never early, wherever in a tick it was set.
  var early_ones: Word = 0;
  for i in 0..50 {
    fresh(&l, 1);
    g_time.after(1, log, DUE, 1);
    g_node.run();
    early_ones = early_ones + l.early;
    var spin: Word = now_us();
    while ((Word)(now_us() - spin) < (Word)(i * 37 % 1000)) {
    }
  }
  expect(early_ones == 0, "a 1 ms timer waits a whole millisecond ({early_ones} of 50 did not)");

  // A thousand at once.
  fresh(&l, MANY);
  var seed: uint64 = 12345;
  for i in 0..MANY {
    seed = seed * 6364136223846793005 + 1442695040888963407;
    var ms: Word = (Word)((seed >> 33) % 40);
    expect(g_time.after(ms, log, DUE, ms) > 0, "a thousand timers fit");
  }
  g_node.run();
  expect(l.got == MANY, "all {MANY} arrive ({l.got})");
  expect(l.early == 0, "none early ({l.early} were)");

  // An actor that sets its own next timer.
  var b: Beat;
  b.count = 0;
  var beat: Word = g_node.spawn(&beater, (rawptr)&b);
  var began: Word = now_us();
  g_time.after(2, beat, DUE, 0);
  g_node.run();
  var took: Word = (Word)((now_us() - began) / 1000);
  expect(b.count == 5, "five beats ({b.count})");
  expect(took >= 10, "2 ms apart: at least 10 ms in all ({took})");

  g_time.stop();
  if (g_failures != 0) {
    return 1;
  }
  println("time ok: {MANY} timers at once, 5 beats in {took} ms");
  return 0;
}
