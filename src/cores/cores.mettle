// Many nodes in one process, one thread each. A core is a place: an actor
// sends to a pid on another core the same way it sends next door, and the
// message is put straight into that core's node.
//
// Like the node, this owns no memory: the caller hands it the cores, the
// actor slots and the mailboxes, which it shares out evenly.

import "std/thread";
import "alph/actor/actor";

export struct AlphCore {
  node: AlphNode;
  thread: int64;
}

export struct AlphCores {
  cores: AlphCore*;
  count: Word;
}

fn alph_cores_far(n: AlphNode*, to: Word, m: AlphMsg*) -> Word {
  var c: AlphCores* = (AlphCores*)n->world;
  var place: Word = (Word)(to >> ALPH_PLACE_SHIFT);
  if (place < 0 || place >= c->count) {
    return ALPH_GONE;
  }
  return c->cores[place].node.put(to, m);
}

// actors holds count * slots actors, mail holds count * slots * room messages.
export fn AlphCores_init__ptr(c: AlphCores*, cores: AlphCore*, count: Word, actors: AlphActor*, slots: Word,
                              mail: AlphMsg*, room: Word) {
  c->cores = cores;
  c->count = count;
  for i in 0..count {
    var n: AlphNode* = &cores[i].node;
    n->init(&actors[i * slots], slots, &mail[i * slots * room], room);
    n->join((Word)i, &alph_cores_far, (rawptr)c);
    cores[i].thread = 0;
  }
}

// Spawns on a chosen core. Returns the pid, or 0 when that core is full.
export fn AlphCores_spawn_on__ptr(c: AlphCores*, place: Word, handle: fn(AlphActor*, AlphMsg*) -> Word with alloc, syscall, asm,
                                  state: rawptr) -> Word {
  return c->cores[place].node.spawn(handle, state);
}

// Spawns on the core with the fewest actors. Returns the pid, or 0 when
// every core is full.
export fn AlphCores_spawn__ptr(c: AlphCores*, handle: fn(AlphActor*, AlphMsg*) -> Word with alloc, syscall, asm,
                               state: rawptr) -> Word {
  var best: Word = 0;
  for i in 1..c->count {
    if (c->cores[i].node.live < c->cores[best].node.live) {
      best = (Word)i;
    }
  }
  var pid: Word = c->cores[best].node.spawn(handle, state);
  var i: Word = 0;
  while (pid == 0 && i < c->count) {
    pid = c->cores[i].node.spawn(handle, state);
    i = i + 1;
  }
  return pid;
}

// From outside an actor.
export fn AlphCores_send__ptr(c: AlphCores*, to: Word, tag: Word, arg: Word) -> Word {
  return c->cores[0].node.send(to, tag, arg);
}

// The cores an actor runs among.
export fn AlphActor_cores__ptr(a: AlphActor*) -> AlphCores* {
  return (AlphCores*)a->node->world;
}

fn alph_core_main(arg: cstring) -> uint32 {
  var n: AlphNode* = (AlphNode*)arg;
  n->run();
  return 0;
}

// Runs every core until stop: the first on this thread, the rest on their own.
export fn AlphCores_run__ptr(c: AlphCores*) {
  for i in 1..c->count {
    c->cores[i].thread = CreateThread(0, 0, &alph_core_main, (cstring)&c->cores[i].node, 0, 0);
  }
  c->cores[0].node.run();
  for i in 1..c->count {
    thread_join_infinite(c->cores[i].thread);
    thread_close(c->cores[i].thread);
  }
}

export fn AlphCores_stop__ptr(c: AlphCores*) {
  for i in 0..c->count {
    c->cores[i].node.stop();
  }
}
