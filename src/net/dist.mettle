// alph/net/dist: actors on other nodes, as on BEAM.
//
// Nodes connect over TCP. An actor on another node is reached through a
// proxy: a local actor that stands for it. Send to the proxy and the
// message arrives at the remote actor, from a proxy that stands for you
// there, so it can answer. Requests and replies work across nodes, with
// their refs.
//
// A proxy lives exactly as long as the actor it stands for. When that actor
// exits, the proxy exits with the same reason, so a local link or monitor on
// the proxy sees the remote exit. When the connection is lost, every proxy
// over it exits with ALPH_NOCONNECTION, as on BEAM. Linking to a proxy links
// both ways: the remote actor is linked to a proxy for the local one, so an
// exit on either side reaches the other. An exit signal sent to a proxy, kill
// included, is passed to the remote actor.
//
// Messages are never dropped while the connection holds. When a receiver's
// mailbox is full, the connection stops reading until it has room, which
// slows the sender through TCP. When a node sends faster than its
// connection can carry and the connection's queue fills, the connection is
// closed rather than losing a message, and everything over it sees
// ALPH_NOCONNECTION.
//
// Each node runs one dist manager, started with alph_dist_start:
//
//   alph_dist_start(ctx, alph_ip4(0, 0, 0, 0), 4370, "cookie");
//   ... ALPH_TAG_DIST_READY, arg = the port: the manager listens
//   var ref: int64 = alph_dist_connect(ctx, alph_ip4(10, 0, 0, 2), 4370, 5000);
//   ... ALPH_TAG_DIST_UP, arg = the connection, or 0 when it failed
//   var ref2: int64 = alph_dist_whereis(ctx, conn, "store", 5000);
//   ... ALPH_TAG_DIST_FOUND, arg = a proxy for the remote "store", or 0
//
// Monitor the connection pid to hear when the other node goes away.
//
// The cookie only keeps nodes of different clusters apart. It is sent in
// the clear: today's transport is unencrypted TCP, so use it on trusted
// networks only. An encrypted transport (Noise) is planned.

import "std/mem";
import "alph/core/mailbox";
import "alph/core/node";

// The answer to alph_dist_connect: arg is the connection's pid, or 0.
export const ALPH_TAG_DIST_UP: int64 = 30;
// The answer to alph_dist_whereis: arg is a proxy pid, or 0 when the name is
// not registered on that node.
export const ALPH_TAG_DIST_FOUND: int64 = 31;
// The answer to alph_dist_port: arg is the port the manager listens on.
export const ALPH_TAG_DIST_PORT: int64 = 41;
// From a new manager to its parent, once it listens: arg is the port.
// Connect only after it arrives.
export const ALPH_TAG_DIST_READY: int64 = 42;

const ALPH_TAG_DIST_CONNECT: int64 = 32;  // to the manager: payload AlphDistTarget
const ALPH_TAG_DIST_OUT: int64 = 33;      // to a connection: payload one frame
const ALPH_TAG_DIST_GONE: int64 = 34;     // to a proxy: its actor exited, arg = reason
const ALPH_TAG_DIST_LINK: int64 = 35;     // to a proxy: link to arg
const ALPH_TAG_DIST_UNLINK: int64 = 36;   // to a proxy: unlink from arg
const ALPH_TAG_DIST_EXIT: int64 = 37;     // to a proxy: exit signal to arg, ref = reason
const ALPH_TAG_DIST_WHEREIS: int64 = 38;  // to a connection: payload the name
const ALPH_TAG_DIST_RETRY: int64 = 39;    // a connection to itself: deliver again
const ALPH_TAG_DIST_PORTQ: int64 = 40;    // to the manager: which port?

const ALPH_DIST_VERSION: int64 = 1;
const ALPH_DIST_COOKIE_MAX: int64 = 64;
const ALPH_DIST_FRAME_MAX: int64 = 16777216;  // 16 MiB
const ALPH_DIST_OUTQ: int64 = 67108864;       // 64 MiB queued for the socket
const ALPH_DIST_READ: int64 = 65536;

// Frame kinds. A frame is little-endian int64 words: the frame's length in
// bytes, its kind, its fields, then the payload bytes.
const ALPH_F_HELLO: int64 = 1;    // version, cookie length; payload cookie
const ALPH_F_SEND: int64 = 2;     // to, from, tag, arg, ref, flags; payload
const ALPH_F_WATCH: int64 = 3;    // pid: tell me when it exits
const ALPH_F_GONE: int64 = 4;     // pid, reason
const ALPH_F_LINK: int64 = 5;     // from, to
const ALPH_F_UNLINK: int64 = 6;   // from, to
const ALPH_F_EXIT: int64 = 7;     // from, to, reason
const ALPH_F_WHEREIS: int64 = 8;  // id; payload the name
const ALPH_F_FOUND: int64 = 9;    // id, pid

const ALPH_DIST_SERVER: int64 = 0;
const ALPH_DIST_CLIENT: int64 = 1;

struct AlphDistTarget {
  ip4: int64;
  port: int64;
}

struct AlphDistManager {
  ip4: int64;
  port: int64;
  listener: int64;
  cookie: uint8[64];
  cookie_len: int64;
}

// A pair in a connection's tables: a remote pid and its local proxy, a
// watched local pid and the monitor on it, or a pending whereis and who
// asked.
struct AlphDistPair {
  a: int64;
  b: int64;
  c: int64;
}

struct AlphDistConn {
  role: int64;
  h: int64;
  up: int64;
  cookie: uint8[64];
  cookie_len: int64;
  asker: int64;      // who called alph_dist_connect, and the request's ref
  asker_ref: int64;
  out: AlphOutq;
  in_data: int64;    // received bytes not yet parsed, in this actor's heap
  in_len: int64;
  in_cap: int64;
  held: int64;       // a frame waiting for room in its receiver's mailbox
  held_len: int64;
  proxies: AlphDistPair*;  // remote pid, proxy pid
  proxy_len: int64;
  proxy_cap: int64;
  watched: AlphDistPair*;  // local pid, monitor ref
  watch_len: int64;
  watch_cap: int64;
  asks: AlphDistPair*;     // whereis id, asker pid, asker ref
  ask_len: int64;
  ask_cap: int64;
  linked: AlphDistPair*;   // local pid, links to it sent through proxies
  linked_len: int64;
  linked_cap: int64;
  next_ask: int64;
}

struct AlphDistProxy {
  conn: int64;
  remote: int64;
  links: AlphDistPair*;  // local pids linked to this proxy (a)
  link_len: int64;
  link_cap: int64;
}

// ---- frames ----------------------------------------------------------------

fn alph_dist_word(frame: int64, i: int64) -> int64 {
  return *(int64*)(frame + i * 8);
}

// Builds a frame of kind with up to six fields and a payload in scratch
// memory, and returns its address; *size gets its length. 0 when scratch
// memory runs out.
fn alph_dist_frame(ctx: AlphCtx*, kind: int64, nf: int64, f0: int64, f1: int64, f2: int64,
                   f3: int64, f4: int64, f5: int64, data: rawptr, size: int64,
                   out_size: int64*) -> int64 {
  var total: int64 = (2 + nf) * 8 + size;
  var frame: int64 = (int64)alph_scratch(ctx, total);
  if (frame == 0) {
    return 0;
  }
  var w: int64* = (int64*)frame;
  w[0] = total;
  w[1] = kind;
  var fields: int64[6];
  fields[0] = f0;
  fields[1] = f1;
  fields[2] = f2;
  fields[3] = f3;
  fields[4] = f4;
  fields[5] = f5;
  for i: int64 in 0..nf {
    w[2 + i] = fields[i];
  }
  if (size > 0) {
    memcpy((rawptr)(frame + (2 + nf) * 8), data, size);
  }
  *out_size = total;
  return frame;
}

// ---- tables ----------------------------------------------------------------

// Appends (a, b, c) to a table in the actor's heap. Returns false when the
// heap is full.
fn alph_dist_put(ctx: AlphCtx*, table: AlphDistPair**, len: int64*, cap: int64*,
                 a: int64, b: int64, c: int64) -> bool {
  if (*len == *cap) {
    var grown: int64 = *cap * 2;
    if (grown < 16) {
      grown = 16;
    }
    var block: rawptr = alph_realloc(ctx, (rawptr)*table, grown * (int64)sizeof(AlphDistPair));
    if (block == 0) {
      return false;
    }
    *table = (AlphDistPair*)block;
    *cap = grown;
  }
  var e: AlphDistPair* = &(*table)[*len];
  e->a = a;
  e->b = b;
  e->c = c;
  *len = *len + 1;
  return true;
}

// The index of the entry whose field a (which = 0) or b (which = 1) is x, or -1.
fn alph_dist_find(table: AlphDistPair*, len: int64, which: int64, x: int64) -> int64 {
  for i: int64 in 0..len {
    var v: int64 = table[i].a;
    if (which == 1) {
      v = table[i].b;
    }
    if (v == x) {
      return i;
    }
  }
  return -1;
}

fn alph_dist_drop(table: AlphDistPair*, len: int64*, i: int64) {
  *len = *len - 1;
  if (i != *len) {
    table[i] = table[*len];
  }
}

// ---- the proxy --------------------------------------------------------------

// Hands a frame to the connection. A connection too slow to take it is
// closed, so nothing is lost silently.
fn alph_proxy_out(ctx: AlphCtx*, conn: int64, frame: int64, size: int64) {
  if (frame == 0 ||
      alph_send_bytes(ctx, conn, ALPH_TAG_DIST_OUT, (rawptr)frame, size) == ALPH_FULL) {
    alph_exit_signal(ctx, conn, ALPH_NOCONNECTION);
  }
}

fn alph_proxy_linked(px: AlphDistProxy*, pid: int64) -> int64 {
  return alph_dist_find(px->links, px->link_len, 0, pid);
}

fn alph_proxy_handle(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var px: AlphDistProxy* = (AlphDistProxy*)ctx->state;
  var size: int64 = 0;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DIST_GONE && m->from == px->conn) {
    return alph_stop(ctx, m->arg);
  }
  if (m->tag == ALPH_TAG_EXIT) {
    if (m->from == px->conn) {
      return alph_stop(ctx, ALPH_NOCONNECTION);
    }
    var at: int64 = alph_proxy_linked(px, m->from);
    if (at >= 0) {
      // A linked local actor exited. The other node's proxy for it is
      // linked to our actor; tell it the real reason. This frame follows
      // the link frame, both from this proxy, so it never arrives first,
      // even when the actor died before the other node could watch it.
      alph_dist_drop(px->links, &px->link_len, at);
      var g: int64 = alph_dist_frame(ctx, ALPH_F_GONE, 2, m->from, m->arg, 0, 0, 0, 0,
                                     (rawptr)0, 0, &size);
      alph_proxy_out(ctx, px->conn, g, size);
      return ALPH_CONTINUE;
    }
    var f: int64 = alph_dist_frame(ctx, ALPH_F_EXIT, 3, m->from, px->remote, m->arg, 0, 0, 0,
                                   (rawptr)0, 0, &size);
    alph_proxy_out(ctx, px->conn, f, size);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_LINKED || m->tag == ALPH_TAG_UNLINKED) {
    var kind: int64 = ALPH_F_LINK;
    var at: int64 = alph_proxy_linked(px, m->from);
    if (m->tag == ALPH_TAG_LINKED) {
      if (at < 0) {
        alph_dist_put(ctx, &px->links, &px->link_len, &px->link_cap, m->from, 0, 0);
      }
    } else {
      kind = ALPH_F_UNLINK;
      if (at >= 0) {
        alph_dist_drop(px->links, &px->link_len, at);
      }
    }
    var f: int64 = alph_dist_frame(ctx, kind, 2, m->from, px->remote, 0, 0, 0, 0,
                                   (rawptr)0, 0, &size);
    alph_proxy_out(ctx, px->conn, f, size);
    return ALPH_CONTINUE;
  }
  if (m->from == px->conn && m->tag == ALPH_TAG_DIST_LINK) {
    if (alph_proxy_linked(px, m->arg) < 0) {
      alph_dist_put(ctx, &px->links, &px->link_len, &px->link_cap, m->arg, 0, 0);
    }
    alph_link(ctx, m->arg);
    return ALPH_CONTINUE;
  }
  if (m->from == px->conn && m->tag == ALPH_TAG_DIST_UNLINK) {
    var at: int64 = alph_proxy_linked(px, m->arg);
    if (at >= 0) {
      alph_dist_drop(px->links, &px->link_len, at);
    }
    alph_unlink(ctx, m->arg);
    return ALPH_CONTINUE;
  }
  if (m->from == px->conn && m->tag == ALPH_TAG_DIST_EXIT) {
    alph_exit_signal(ctx, m->arg, m->ref);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DOWN || m->tag == ALPH_TAG_TIMEOUT) {
    return ALPH_CONTINUE;
  }
  // Anything else is for the remote actor, requests and replies included.
  var data: rawptr = alph_msg_bytes(m, &size);
  var payload: int64 = size;
  var f: int64 = alph_dist_frame(ctx, ALPH_F_SEND, 6, px->remote, m->from, m->tag, m->arg, m->ref,
                                 m->flags, data, payload, &size);
  alph_proxy_out(ctx, px->conn, f, size);
  return ALPH_CONTINUE;
}

// ---- the connection --------------------------------------------------------

fn alph_conn_send(ctx: AlphCtx*, c: AlphDistConn*, frame: int64, size: int64) -> bool {
  if (frame == 0 || alph_outq_push(ctx, &c->out, (rawptr)frame, size) != ALPH_SENT) {
    return false;
  }
  return alph_outq_flush(ctx, &c->out, c->h) >= 0;
}

// Arms the socket for what the connection waits on now: input unless a
// frame is held back, output while bytes are queued.
fn alph_conn_arm(ctx: AlphCtx*, c: AlphDistConn*) {
  var events: int64 = 0;
  if (c->held == 0) {
    events = ALPH_IO_IN;
  }
  if (alph_outq_pending(&c->out) > 0) {
    events = events | ALPH_IO_OUT;
  }
  if (events != 0) {
    alph_io_arm(ctx, c->h, events);
  }
}

// The local proxy for remote pid, made on first use. 0 when it cannot be
// made.
fn alph_conn_proxy(ctx: AlphCtx*, c: AlphDistConn*, remote: int64) -> int64 {
  var at: int64 = alph_dist_find(c->proxies, c->proxy_len, 0, remote);
  if (at >= 0) {
    return c->proxies[at].b;
  }
  var px: AlphDistProxy;
  memset((rawptr)&px, 0, (int64)sizeof(AlphDistProxy));
  px.conn = ctx->self;
  px.remote = remote;
  var pid: int64 = alph_spawn_value<AlphDistProxy>(ctx, ALPH_PROXY | ALPH_LINK, &px, &alph_proxy_handle);
  if (pid == 0) {
    return 0;
  }
  if (!alph_dist_put(ctx, &c->proxies, &c->proxy_len, &c->proxy_cap, remote, pid, 0)) {
    alph_exit_signal(ctx, pid, ALPH_KILL);
    return 0;
  }
  // Ask the other node to report the actor's exit.
  var size: int64 = 0;
  var f: int64 = alph_dist_frame(ctx, ALPH_F_WATCH, 1, remote, 0, 0, 0, 0, 0, (rawptr)0, 0, &size);
  alph_conn_send(ctx, c, f, size);
  return pid;
}

// Keeps count of local actors linked through a proxy, from the frames the
// proxies send. A linked actor's exit always reaches its proxy, which
// reports the real reason, so the connection must not report it gone with
// ALPH_NOPROC when the other node watches it only after it died.
fn alph_conn_note_links(ctx: AlphCtx*, c: AlphDistConn*, frame: int64, size: int64) {
  if (size < 24) {
    return;
  }
  var kind: int64 = alph_dist_word(frame, 1);
  var pid: int64 = alph_dist_word(frame, 2);
  var at: int64 = alph_dist_find(c->linked, c->linked_len, 0, pid);
  if (kind == ALPH_F_LINK) {
    if (at < 0) {
      alph_dist_put(ctx, &c->linked, &c->linked_len, &c->linked_cap, pid, 1, 0);
    } else {
      c->linked[at].b = c->linked[at].b + 1;
    }
  } else if (kind == ALPH_F_UNLINK && at >= 0) {
    c->linked[at].b = c->linked[at].b - 1;
    if (c->linked[at].b <= 0) {
      alph_dist_drop(c->linked, &c->linked_len, at);
    }
  } else if (kind == ALPH_F_GONE && at >= 0) {
    alph_dist_drop(c->linked, &c->linked_len, at);
  }
}

fn alph_conn_hello(ctx: AlphCtx*, c: AlphDistConn*) -> bool {
  var size: int64 = 0;
  var f: int64 = alph_dist_frame(ctx, ALPH_F_HELLO, 2, ALPH_DIST_VERSION, c->cookie_len, 0, 0, 0, 0,
                                 (rawptr)&c->cookie[0], c->cookie_len, &size);
  return alph_conn_send(ctx, c, f, size);
}

fn alph_conn_answer(ctx: AlphCtx*, to: int64, ref: int64, tag: int64, arg: int64) {
  var request: AlphMsg;
  memset((rawptr)&request, 0, (int64)sizeof(AlphMsg));
  request.from = to;
  request.ref = ref;
  alph_reply(ctx, &request, tag, arg);
}

// Handles one frame. Returns false when the frame is bad or the peer is not
// one of ours, which ends the connection; *hold is set when the frame must
// wait for room in a mailbox.
fn alph_conn_frame(ctx: AlphCtx*, c: AlphDistConn*, frame: int64, total: int64,
                   hold: bool*) -> bool {
  var kind: int64 = alph_dist_word(frame, 1);
  var size: int64 = 0;
  if (c->up == 0) {
    if (kind != ALPH_F_HELLO || total < 32 || alph_dist_word(frame, 2) != ALPH_DIST_VERSION) {
      return false;
    }
    var len: int64 = alph_dist_word(frame, 3);
    if (len != c->cookie_len || total != 32 + len ||
        memcmp((rawptr)(frame + 32), (rawptr)&c->cookie[0], len) != 0) {
      return false;
    }
    if (c->role == ALPH_DIST_SERVER && !alph_conn_hello(ctx, c)) {
      return false;
    }
    c->up = 1;
    if (c->asker != 0) {
      alph_conn_answer(ctx, c->asker, c->asker_ref, ALPH_TAG_DIST_UP, ctx->self);
      c->asker = 0;
    }
    return true;
  }
  if (kind == ALPH_F_SEND && total >= 64) {
    var from: int64 = alph_conn_proxy(ctx, c, alph_dist_word(frame, 3));
    if (from == 0) {
      return false;
    }
    var sent: int64 = alph_node_forward(ctx->node, alph_dist_word(frame, 2), from,
                                        alph_dist_word(frame, 4), alph_dist_word(frame, 5),
                                        alph_dist_word(frame, 6), alph_dist_word(frame, 7),
                                        (rawptr)(frame + 64), total - 64);
    if (sent == ALPH_FULL) {
      *hold = true;
    }
    return true;  // ALPH_GONE: the WATCH on it reports the exit to the sender
  }
  if (kind == ALPH_F_WATCH && total == 24) {
    var pid: int64 = alph_dist_word(frame, 2);
    if (alph_dist_find(c->watched, c->watch_len, 0, pid) < 0) {
      var ref: int64 = alph_monitor(ctx, pid);
      alph_dist_put(ctx, &c->watched, &c->watch_len, &c->watch_cap, pid, ref, 0);
    }
    return true;
  }
  if (kind == ALPH_F_GONE && total == 32) {
    var at: int64 = alph_dist_find(c->proxies, c->proxy_len, 0, alph_dist_word(frame, 2));
    if (at >= 0) {
      alph_send(ctx, c->proxies[at].b, ALPH_TAG_DIST_GONE, alph_dist_word(frame, 3));
      alph_dist_drop(c->proxies, &c->proxy_len, at);
    }
    return true;
  }
  if ((kind == ALPH_F_LINK || kind == ALPH_F_UNLINK) && total == 32) {
    var px: int64 = alph_conn_proxy(ctx, c, alph_dist_word(frame, 2));
    var tag: int64 = ALPH_TAG_DIST_LINK;
    if (kind == ALPH_F_UNLINK) {
      tag = ALPH_TAG_DIST_UNLINK;
    }
    if (px != 0 && alph_send(ctx, px, tag, alph_dist_word(frame, 3)) == ALPH_FULL) {
      *hold = true;
    }
    return px != 0;
  }
  if (kind == ALPH_F_EXIT && total == 40) {
    var px: int64 = alph_conn_proxy(ctx, c, alph_dist_word(frame, 2));
    if (px == 0) {
      return false;
    }
    if (alph_node_forward(ctx->node, px, ctx->self, ALPH_TAG_DIST_EXIT, alph_dist_word(frame, 3),
                          alph_dist_word(frame, 4), 0, (rawptr)0, 0) == ALPH_FULL) {
      *hold = true;
    }
    return true;
  }
  if (kind == ALPH_F_WHEREIS && total >= 24) {
    var name: string;
    name.chars = (uint8*)(frame + 24);
    name.length = (uint64)(total - 24);
    var pid: int64 = alph_whereis(ctx, name);
    var f: int64 = alph_dist_frame(ctx, ALPH_F_FOUND, 2, alph_dist_word(frame, 2), pid, 0, 0, 0, 0,
                                   (rawptr)0, 0, &size);
    return alph_conn_send(ctx, c, f, size);
  }
  if (kind == ALPH_F_FOUND && total == 32) {
    var at: int64 = alph_dist_find(c->asks, c->ask_len, 0, alph_dist_word(frame, 2));
    if (at >= 0) {
      var pid: int64 = alph_dist_word(frame, 3);
      var px: int64 = 0;
      if (pid != 0) {
        px = alph_conn_proxy(ctx, c, pid);
      }
      alph_conn_answer(ctx, c->asks[at].b, c->asks[at].c, ALPH_TAG_DIST_FOUND, px);
      alph_dist_drop(c->asks, &c->ask_len, at);
    }
    return true;
  }
  return false;
}

// Handles every whole frame received, keeping a partial one for later.
// Returns false when the connection must end.
fn alph_conn_parse(ctx: AlphCtx*, c: AlphDistConn*) -> bool {
  var at: int64 = 0;
  while (c->held == 0 && c->in_len - at >= 16) {
    var frame: int64 = c->in_data + at;
    var total: int64 = alph_dist_word(frame, 0);
    if (total < 16 || total > ALPH_DIST_FRAME_MAX) {
      return false;
    }
    if (c->in_len - at < total) {
      break;
    }
    var hold: bool = false;
    if (!alph_conn_frame(ctx, c, frame, total, &hold)) {
      return false;
    }
    if (hold) {
      // The receiver is full: keep the frame and stop reading until it
      // has room. TCP then slows the sender down.
      c->held = (int64)alph_alloc(ctx, total);
      if (c->held == 0) {
        return false;
      }
      memcpy((rawptr)c->held, (rawptr)frame, total);
      c->held_len = total;
      alph_send_after(ctx, 1, ctx->self, ALPH_TAG_DIST_RETRY, 0);
    }
    at = at + total;
  }
  if (at > 0) {
    memmove((rawptr)c->in_data, (rawptr)(c->in_data + at), c->in_len - at);
    c->in_len = c->in_len - at;
  }
  return true;
}

fn alph_conn_read(ctx: AlphCtx*, c: AlphDistConn*) -> bool {
  while (true) {
    if (c->in_cap - c->in_len < ALPH_DIST_READ) {
      var cap: int64 = c->in_cap * 2;
      if (cap < c->in_len + ALPH_DIST_READ) {
        cap = c->in_len + ALPH_DIST_READ;
      }
      var block: rawptr = alph_realloc(ctx, (rawptr)c->in_data, cap);
      if (block == 0) {
        return false;
      }
      c->in_data = (int64)block;
      c->in_cap = cap;
    }
    var n: int64 = alph_io_read(ctx, c->h, (rawptr)(c->in_data + c->in_len), c->in_cap - c->in_len);
    if (n == ALPH_IO_AGAIN) {
      return true;
    }
    if (n <= 0) {
      return false;  // closed by the other side, or an error
    }
    c->in_len = c->in_len + n;
    if (!alph_conn_parse(ctx, c)) {
      return false;
    }
    if (c->held != 0) {
      return true;
    }
  }
  return true;
}

// Ends the connection. A connect still waiting for the handshake is told
// it failed; whereis askers see the connection's exit through their request.
fn alph_conn_end(ctx: AlphCtx*, c: AlphDistConn*) -> int64 {
  if (c->asker != 0) {
    alph_conn_answer(ctx, c->asker, c->asker_ref, ALPH_TAG_DIST_UP, 0);
    c->asker = 0;
  }
  return alph_stop(ctx, ALPH_NOCONNECTION);
}

fn alph_conn_handle(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var c: AlphDistConn* = (AlphDistConn*)ctx->state;
  var size: int64 = 0;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);
    alph_outq_init(&c->out, ALPH_DIST_OUTQ);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_IO_GIVEN) {
    c->h = m->ref;
    alph_tcp_nodelay(ctx, c->h, true);
    if (c->role == ALPH_DIST_CLIENT) {
      alph_io_arm(ctx, c->h, ALPH_IO_OUT);  // the connect finishing
    } else {
      alph_io_arm(ctx, c->h, ALPH_IO_IN);
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_IO && m->ref == c->h) {
    if (c->role == ALPH_DIST_CLIENT && c->up == 0 && alph_outq_pending(&c->out) == 0 &&
        c->in_len == 0 && (m->arg & ALPH_IO_OUT) != 0) {
      if (alph_io_error(ctx, c->h) != 0 || !alph_conn_hello(ctx, c)) {
        return alph_conn_end(ctx, c);
      }
      alph_conn_arm(ctx, c);
      return ALPH_CONTINUE;
    }
    if ((m->arg & ALPH_IO_OUT) != 0 && alph_outq_flush(ctx, &c->out, c->h) < 0) {
      return alph_conn_end(ctx, c);
    }
    if ((m->arg & (ALPH_IO_IN | ALPH_IO_HUP | ALPH_IO_ERR)) != 0 && c->held == 0 &&
        !alph_conn_read(ctx, c)) {
      return alph_conn_end(ctx, c);
    }
    alph_conn_arm(ctx, c);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DIST_RETRY) {
    if (c->held == 0) {
      return ALPH_CONTINUE;
    }
    var hold: bool = false;
    if (!alph_conn_frame(ctx, c, c->held, c->held_len, &hold)) {
      return alph_conn_end(ctx, c);
    }
    if (hold) {
      alph_send_after(ctx, 1, ctx->self, ALPH_TAG_DIST_RETRY, 0);
      return ALPH_CONTINUE;
    }
    alph_free(ctx, (rawptr)c->held);
    c->held = 0;
    // Frames that arrived behind the held one, then the socket again.
    if (!alph_conn_parse(ctx, c) || (c->held == 0 && !alph_conn_read(ctx, c))) {
      return alph_conn_end(ctx, c);
    }
    alph_conn_arm(ctx, c);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DIST_OUT) {
    var data: rawptr = alph_msg_bytes(m, &size);
    alph_conn_note_links(ctx, c, (int64)data, size);
    if (alph_outq_push(ctx, &c->out, data, size) != ALPH_SENT ||
        alph_outq_flush(ctx, &c->out, c->h) < 0) {
      return alph_conn_end(ctx, c);
    }
    alph_conn_arm(ctx, c);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DIST_WHEREIS) {
    var name: rawptr = alph_msg_bytes(m, &size);
    var id: int64 = c->next_ask + 1;
    c->next_ask = id;
    var len: int64 = size;
    alph_dist_put(ctx, &c->asks, &c->ask_len, &c->ask_cap, id, m->from, m->ref);
    var f: int64 = alph_dist_frame(ctx, ALPH_F_WHEREIS, 1, id, 0, 0, 0, 0, 0, name, len, &size);
    if (!alph_conn_send(ctx, c, f, size)) {
      return alph_conn_end(ctx, c);
    }
    alph_conn_arm(ctx, c);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DOWN) {
    // A local actor the other node holds a proxy for has exited.
    var at: int64 = alph_dist_find(c->watched, c->watch_len, 1, m->ref);
    if (at >= 0) {
      var pid: int64 = c->watched[at].a;
      alph_dist_drop(c->watched, &c->watch_len, at);
      if (m->arg == ALPH_NOPROC && alph_dist_find(c->linked, c->linked_len, 0, pid) >= 0) {
        return ALPH_CONTINUE;  // its linked proxy reports the real reason
      }
      var f: int64 = alph_dist_frame(ctx, ALPH_F_GONE, 2, pid, m->arg, 0, 0, 0, 0, (rawptr)0, 0, &size);
      if (!alph_conn_send(ctx, c, f, size)) {
        return alph_conn_end(ctx, c);
      }
      alph_conn_arm(ctx, c);
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_EXIT) {
    if (m->from == alph_parent(ctx) || m->from == 0) {
      return alph_stop(ctx, m->arg);
    }
    // A proxy exited: forget it, and its actor's exit report with it.
    var at: int64 = alph_dist_find(c->proxies, c->proxy_len, 1, m->from);
    if (at >= 0) {
      alph_dist_drop(c->proxies, &c->proxy_len, at);
    }
  }
  return ALPH_CONTINUE;
}

// ---- the manager ------------------------------------------------------------

fn alph_dist_conn_state(c: AlphDistConn*, mgr: AlphDistManager*, role: int64) {
  memset((rawptr)c, 0, (int64)sizeof(AlphDistConn));
  c->role = role;
  memcpy((rawptr)&c->cookie[0], (rawptr)&mgr->cookie[0], mgr->cookie_len);
  c->cookie_len = mgr->cookie_len;
}

fn alph_dist_manage(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var mgr: AlphDistManager* = (AlphDistManager*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);
    mgr->listener = alph_tcp_listen(ctx, mgr->ip4, mgr->port, 128, 0);
    if (mgr->listener < 0 || !alph_register(ctx, "alph.dist")) {
      return alph_stop(ctx, ALPH_SHUTDOWN);
    }
    mgr->port = alph_tcp_port(ctx, mgr->listener);
    alph_io_arm(ctx, mgr->listener, ALPH_IO_IN);
    alph_send(ctx, alph_parent(ctx), ALPH_TAG_DIST_READY, mgr->port);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_IO && m->ref == mgr->listener) {
    var h: int64 = alph_tcp_accept(ctx, mgr->listener);
    while (h > 0) {
      var c: AlphDistConn;
      alph_dist_conn_state(&c, mgr, ALPH_DIST_SERVER);
      var conn: int64 = alph_spawn_value<AlphDistConn>(ctx, ALPH_LINK, &c, &alph_conn_handle);
      if (conn == 0 || alph_io_give(ctx, h, conn) != 0) {
        alph_io_close(ctx, h);
      }
      h = alph_tcp_accept(ctx, mgr->listener);
    }
    alph_io_arm(ctx, mgr->listener, ALPH_IO_IN);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DIST_CONNECT) {
    var t: AlphDistTarget;
    if (!alph_msg_value<AlphDistTarget>(m, &t)) {
      alph_reply(ctx, m, ALPH_TAG_DIST_UP, 0);
      return ALPH_CONTINUE;
    }
    var h: int64 = alph_tcp_connect(ctx, t.ip4, t.port);
    if (h < 0) {
      alph_reply(ctx, m, ALPH_TAG_DIST_UP, 0);
      return ALPH_CONTINUE;
    }
    var c: AlphDistConn;
    alph_dist_conn_state(&c, mgr, ALPH_DIST_CLIENT);
    c.asker = m->from;
    c.asker_ref = m->ref;
    var conn: int64 = alph_spawn_value<AlphDistConn>(ctx, ALPH_LINK, &c, &alph_conn_handle);
    if (conn == 0 || alph_io_give(ctx, h, conn) != 0) {
      alph_io_close(ctx, h);
      alph_reply(ctx, m, ALPH_TAG_DIST_UP, 0);
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DIST_PORTQ) {
    alph_reply(ctx, m, ALPH_TAG_DIST_PORT, mgr->port);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_EXIT && (m->from == alph_parent(ctx) || m->from == 0)) {
    return alph_stop(ctx, m->arg);
  }
  return ALPH_CONTINUE;  // a connection ending is its monitors' business
}

// Starts this node's dist manager, linked to the caller, listening on
// ip4:port (port 0 picks a free port). It registers itself as "alph.dist"
// and then sends the caller ALPH_TAG_DIST_READY with the port it listens
// on; connect and look up names only after that. Only nodes started with
// the same cookie (at most 64 bytes) can connect.
//
// Returns the manager's pid, or 0 when the cookie is too long or the node
// is full. If listening fails, the manager exits at once with
// ALPH_SHUTDOWN, which the caller sees through the link. Thread: a handler.
export fn alph_dist_start(ctx: AlphCtx*, ip4: int64, port: int64, cookie: string) -> int64 {
  if ((int64)cookie.length > ALPH_DIST_COOKIE_MAX) {
    return 0;
  }
  var mgr: AlphDistManager;
  memset((rawptr)&mgr, 0, (int64)sizeof(AlphDistManager));
  mgr.ip4 = ip4;
  mgr.port = port;
  mgr.cookie_len = (int64)cookie.length;
  memcpy((rawptr)&mgr.cookie[0], (rawptr)cookie.chars, mgr.cookie_len);
  return alph_spawn_value<AlphDistManager>(ctx, ALPH_LINK, &mgr, &alph_dist_manage);
}

// Connects to the node listening on ip4:port. The answer is
// ALPH_TAG_DIST_UP with arg = the connection's pid, or 0 when the node
// could not be reached or has another cookie; or, as for any request,
// ALPH_TAG_DOWN or ALPH_TAG_TIMEOUT. Each carries the returned ref.
//
// Returns the ref, or ALPH_GONE when no dist manager runs, or ALPH_FULL.
// Thread: a handler.
export fn alph_dist_connect(ctx: AlphCtx*, ip4: int64, port: int64, timeout_ms: int64) -> int64 {
  var mgr: int64 = alph_whereis(ctx, "alph.dist");
  if (mgr == 0) {
    return ALPH_GONE;
  }
  var t: AlphDistTarget;
  t.ip4 = ip4;
  t.port = port;
  return alph_request_value<AlphDistTarget>(ctx, mgr, ALPH_TAG_DIST_CONNECT, &t, timeout_ms);
}

// Looks up name in the registry of the node at the other end of conn. The
// answer is ALPH_TAG_DIST_FOUND with arg = a local proxy for that actor,
// or 0 when the name is not registered there; or ALPH_TAG_DOWN or
// ALPH_TAG_TIMEOUT. Returns the request's ref, or as alph_request.
// Thread: a handler.
export fn alph_dist_whereis(ctx: AlphCtx*, conn: int64, name: string, timeout_ms: int64) -> int64 {
  return alph_request_bytes(ctx, conn, ALPH_TAG_DIST_WHEREIS, (rawptr)name.chars,
                            (int64)name.length, timeout_ms);
}

// Asks this node's dist manager which port it listens on, for a manager
// started with port 0. The answer is ALPH_TAG_DIST_PORT with arg = the
// port. Returns the request's ref, or ALPH_GONE when no manager runs.
// Thread: a handler.
export fn alph_dist_port(ctx: AlphCtx*, timeout_ms: int64) -> int64 {
  var mgr: int64 = alph_whereis(ctx, "alph.dist");
  if (mgr == 0) {
    return ALPH_GONE;
  }
  return alph_request(ctx, mgr, ALPH_TAG_DIST_PORTQ, 0, timeout_ms);
}
