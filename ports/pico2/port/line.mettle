// A line of bytes to one other machine: UART0 (GP0 out, GP1 in, 115200
// baud), both ways. The board's putc is not used for the line: it puts a
// carriage return before every byte 10, which would spoil a message.
// The console's interrupt hands each byte that arrives to take. This file
// has the board's external interrupt handler, so a program with other
// external sources adds them here.

var g_take: fn(rawptr, int32) -> void;
var g_ctx: rawptr;

export fn alph_line_start(take: fn(rawptr, int32) -> void, ctx: rawptr) {
  g_take = take;
  g_ctx = ctx;
  mettle_board_console_irq_enable();
}

export fn alph_line_put(byte: uint8) {
  rp2350_uart_putc(0, byte);
}

// Bytes go out as they are put: nothing to do.
export fn alph_line_flush() {
}

// One hart, and nothing sends from an interrupt: no lock is needed, and
// interrupts stay on while a message goes out, so bytes arriving meanwhile
// are still taken.
export fn alph_line_lock() {
}

export fn alph_line_unlock() {
}

@interrupt fn mettle_trap_external() {
  var source: int32 = mettle_board_irq_claim();
  if (source == mettle_board_console_irq()) {
    var c: int32 = mettle_board_getc();
    while (c >= 0) {
      g_take(g_ctx, c);
      c = mettle_board_getc();
    }
  }
  mettle_board_irq_complete(source);
}
