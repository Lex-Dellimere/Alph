// A Raspberry Pi Pico 2, on its RISC-V cores. Build with
// -I ports/pico2 -I ports/mcu --board pico2: this folder has what differs
// on this board, and the rest is the one-hart port's.

// What the board needs before alph runs on it: its clocks, timer and UART0
// come out of reset in pico2_init, and the traps go to one handler for
// each cause. The console sends every byte as it is (no carriage return
// before a line feed), because the console is also the line to another
// machine. UART0 is GP0 out and GP1 in, at 115200 baud. Call it first in
// main.
export fn alph_board_start() {
  pico2_init();
  mettle_board_trap_install();
  pico2_console_raw(true);
}
